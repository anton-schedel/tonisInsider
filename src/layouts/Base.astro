---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { articles, lastUpdate, lineups } from "../lib/data.ts";
import { fullDate } from "../lib/format.ts";
import PostHog from "../components/posthog.astro";

interface Props {
  title: string;
  tab?: "news" | "aufstellungen" | "mein-team" | "einstellungen";
  back?: { href: string; label: string };
  /** Hide the big page title (article pages show their own headline). */
  hideHeading?: boolean;
  /** Our logo with text on the right of the page title. */
  logo?: boolean;
}
const { title, tab, back, hideHeading = false, logo = false } = Astro.props;
const updated = lastUpdate();
// Lets open pages notice updates (see the freshness script below and /data/version.json).
const newest = articles()[0]?.id;
// The matchday's kickoff times: live scores are only fetched while one of its matches runs.
const kickoffs = [...new Set(lineups().flatMap((l) => (l.kickoff ? [l.kickoff] : [])))].sort();
const tabs = [
  { id: "news", href: "/", label: "News", icon: "M4 5h16M4 12h16M4 19h10" },
  { id: "aufstellungen", href: "/aufstellungen/", label: "Aufstellungen", icon: "M12 3v18M3 12h18M7 7h10v10H7z" },
  { id: "mein-team", href: "/mein-team/", label: "Mein Team", icon: "M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM4 21c0-4 3.6-6.5 8-6.5s8 2.5 8 6.5" },
  { id: "einstellungen", href: "/einstellungen/", label: "Einstellungen", icon: "M12 15.2a3.2 3.2 0 1 0 0-6.4 3.2 3.2 0 0 0 0 6.4zM19.4 15a1.7 1.7 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.7 1.7 0 0 0-1.82-.33 1.7 1.7 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.7 1.7 0 0 0-1.08-1.51 1.7 1.7 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.7 1.7 0 0 0 4.6 15a1.7 1.7 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.7 1.7 0 0 0 4.6 9a1.7 1.7 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.7 1.7 0 0 0 9 4.68a1.7 1.7 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.7 1.7 0 0 0 1 1.51 1.7 1.7 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.7 1.7 0 0 0 19.4 9a1.7 1.7 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.7 1.7 0 0 0-1.51 1z" },
] as const;
---
<!doctype html>
<html lang="de" data-newest={newest} data-updated={updated} data-kickoffs={kickoffs.join(",") || undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <!-- Also for Worker-rendered pages (where _headers doesn't apply): never leak our URL as Referer. -->
    <meta name="referrer" content="same-origin" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <title>TonInsider</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon-32.png" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <PostHog />
    <script is:inline>
      // The Kickbase account id is a stable identifier, unlike a display name or email. Checked on every page
      // (the login form lands on Mein Team without a full reload, and head scripts only run on the first one).
      if (!window.__posthogIdentify) {
        window.__posthogIdentify = () => {
          const encoded = document.cookie.split("; ").find((c) => c.startsWith("kbuid="))?.slice("kbuid=".length);
          if (!encoded) return;
          let id = encoded;
          try { id = decodeURIComponent(encoded); } catch {}
          if (id && window.__posthogIdentifiedId !== id) {
            window.posthog?.identify(id);
            window.__posthogIdentifiedId = id;
          }
        };
        document.addEventListener("astro:page-load", window.__posthogIdentify);
      }
    </script>
    <script is:inline>
      // Runs on first load and again after every client-side navigation (which swaps <html> attributes).
      if (!window.__themeInit) {
        window.__themeInit = true;
        // iOS Safari shows :active (the tap feedback of .press / .press-row) only once the page listens to touches.
        document.addEventListener("touchstart", () => {}, { passive: true });
        const stored = () => {
          try {
            const t = localStorage.getItem("theme");
            return t === "light" || t === "dark" ? t : "auto";
          } catch {
            return "auto";
          }
        };
        // A forced theme also colours the browser/status bar; "auto" keeps the system-based meta tags.
        const apply = (doc) => {
          const t = stored();
          if (t === "auto") delete doc.documentElement.dataset.theme;
          else doc.documentElement.dataset.theme = t;
          doc.querySelectorAll('meta[name="theme-color"]').forEach((m) => {
            const own = m.getAttribute("media")?.includes("dark") ? "#000000" : "#ffffff";
            m.setAttribute("content", t === "auto" ? own : t === "dark" ? "#000000" : "#ffffff");
          });
        };
        // Until one is chosen the site follows the system, and that one is shown as selected.
        const shown = () => {
          const t = stored();
          return t !== "auto" ? t : matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        };
        const markTheme = (doc = document) => {
          const t = shown();
          doc.querySelectorAll("[data-theme-set]").forEach((btn) => {
            const on = btn.getAttribute("data-theme-set") === t;
            btn.classList.toggle("bg-fg", on);
            btn.classList.toggle("text-bg", on);
            btn.setAttribute("aria-pressed", String(on));
          });
        };
        apply(document);
        // Settings: account rows and the theme choice come from cookies and this browser, so they're filled in
        // before the page is shown: on the incoming page during a navigation (astro:before-swap), and by an
        // inline call at the end of the settings page on a fresh load.
        window.__fillSettings = (doc) => {
          if (!doc.querySelector("[data-theme-set]")) return;
          const signedIn = (name) => new RegExp("(?:^|; )" + name + "=1").test(document.cookie);
          doc.querySelector("[data-kb-form]")?.classList.toggle("hidden", signedIn("kbin"));
          doc.querySelector("[data-kb-in]")?.classList.toggle("hidden", !signedIn("kbin"));
          doc.querySelector("[data-li-form]")?.classList.toggle("hidden", signedIn("liin"));
          doc.querySelector("[data-li-in]")?.classList.toggle("hidden", !signedIn("liin"));
          const named = (cookie) => {
            let s = document.cookie.split("; ").find((p) => p.startsWith(cookie + "="))?.slice(cookie.length + 1) ?? "";
            // Names from older logins were encoded twice.
            for (let i = 0; i < 2 && /%[0-9a-f]{2}/i.test(s); i++) { try { s = decodeURIComponent(s); } catch { break; } }
            return s.trim();
          };
          const liSlot = doc.querySelector("[data-li-name]");
          if (liSlot) liSlot.textContent = named("lin");
          const kbName = named("kbn");
          const kbSlot = doc.querySelector("[data-kb-name]");
          if (kbSlot) kbSlot.textContent = kbName;
          doc.querySelector("[data-kb-as]")?.classList.toggle("hidden", !kbName);
          markTheme(doc);
        };
        // Live scores on match cards (FixtureCard.astro), from the copy the poller (lib/liveClient.ts) keeps in
        // sessionStorage. Applied to the incoming page before it's shown, so a running match never flips from
        // its kickoff time to the score in front of you.
        // Score and end come from /api/live/ (li: LigaInsider, else ESPN); OpenLigaDB (matches) only adds the goal
        // scorers when its score agrees: its own scores were wrong too often to show. A game counts as over at
        // the latest 2 h 10 min after kickoff, whatever the sources say.
        window.__applyLive = (doc) => {
          let live;
          try { live = JSON.parse(sessionStorage.getItem("live") ?? "null"); } catch {}
          if (!live || !Array.isArray(live.matches) || !Array.isArray(live.li)) return;
          const key = (n) => String(n).trim().toLowerCase();
          doc.querySelectorAll("[data-live]").forEach((box) => {
            let d;
            try { d = JSON.parse(box.dataset.live); } catch { return; }
            const kickoff = Date.parse(d.kickoff);
            if (kickoff > Date.now()) return;
            const li = live.li.find((g) => g.home === d.hs && g.away === d.as);
            const ol = live.matches.find((x) => key(x.home) === key(d.home) && key(x.away) === key(d.away));
            const score = li?.score;
            if (!score) return;
            const sameScore = ol && ol.score[0] === score[0] && ol.score[1] === score[1];
            const m = {
              score,
              finished: !!li?.finished || Date.now() > kickoff + 130 * 60000,
              goals: sameScore ? ol.goals : [],
            };
            box.querySelector("[data-live-main]").textContent = m.score[0] + ":" + m.score[1];
            const sub = box.querySelector("[data-live-sub]");
            sub.textContent = m.finished ? "Ende" : "Live";
            sub.style.color = m.finished ? "" : "var(--red-fg)";
            sub.style.fontWeight = m.finished ? "" : "600";
            box.querySelector("[data-live-tip]")?.remove();
            const goals = box.closest("[data-fixture]")?.querySelector("[data-live-goals]");
            if (!goals) return;
            // Scorers in two columns, home left and away right, in the order they fell.
            let prev = [0, 0];
            const cols = [doc.createElement("ol"), doc.createElement("ol")];
            cols[1].className = "text-right";
            for (const g of m.goals) {
              const side = g.home > prev[0] ? 0 : 1;
              prev = [g.home, g.away];
              const li = doc.createElement("li");
              li.textContent = (g.minute != null ? g.minute + "' " : "") + g.name + (g.penalty ? " (11m)" : "") + (g.own ? " (ET)" : "");
              cols[side].append(li);
            }
            goals.replaceChildren(...cols);
            goals.hidden = m.goals.length === 0;
          });
        };
        // The tab bar persists across navigations, so its highlight is updated here instead of re-rendered.
        const highlight = (tab) => {
          document.querySelectorAll("nav [data-tab]").forEach((a) => {
            a.classList.toggle("text-accent", a.dataset.tab === tab);
            a.classList.toggle("text-muted", a.dataset.tab !== tab);
            a.classList.toggle("is-active", a.dataset.tab === tab);
          });
        };
        // The pill slides from the moment of the tap. It runs as a Web Animation, not a CSS transition: the
        // router briefly takes the persisted bar out of the page during the swap, which would cut a transition
        // short, while a script animation keeps going.
        // One glide without overshoot: quick to leave, long calm settle (ease-out quint), so it never wobbles
        // at its new spot.
        const GLIDE = "cubic-bezier(0.22, 1, 0.36, 1)";
        let slide;
        const movePill = (tab) => {
          const nav = document.querySelector("nav.tabbar");
          const pill = nav?.querySelector(".tab-pill");
          if (!nav || !pill) return;
          const i = [...nav.querySelectorAll("[data-tab]")].findIndex((a) => a.dataset.tab === tab);
          nav.classList.toggle("no-tab", i < 0);
          const next = String(Math.max(0, i));
          if (nav.style.getPropertyValue("--tab") === next) return;
          const x = () => new DOMMatrix(getComputedStyle(pill).transform).m41;
          const from = x(); // where it is right now, also halfway through a slide
          slide?.forEach((a) => a.cancel());
          nav.style.setProperty("--tab", next);
          const to = x();
          if (from === to || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
          const tabs = Math.abs(to - from) / pill.offsetWidth;
          // A slight stretch while it travels, gone before the glide settles. One transform animation (no
          // separate `scale`), so phones run it on the GPU and it keeps gliding while the page is swapped.
          const stretch = Math.min(0.1, 0.04 * tabs);
          // Keyframe offsets are in eased progress, so the middle one lies on the same glide curve; the
          // stretch peaks early and is gone well before it settles.
          const at = (t) => from + (to - from) * t;
          slide = [
            pill.animate(
              [
                { transform: `translateX(${from}px) scale(1, 1)` },
                { transform: `translateX(${at(0.35)}px) scale(${1 + stretch}, ${1 - stretch / 2})`, offset: 0.35 },
                { transform: `translateX(${to}px) scale(1, 1)` },
              ],
              { duration: 460, easing: GLIDE },
            ),
          ];
          return slide[0];
        };
        const tabFor = (path) =>
          /^\/(aufstellungen|vereine)\//.test(path) ? "aufstellungen"
          : /^\/mein-team\//.test(path) ? "mein-team"
          : /^\/(einstellungen|login)\//.test(path) ? "einstellungen"
          : "news";
        const bar = () => document.querySelector("[data-nav-progress]");
        let slow;
        // Feedback at the moment of the tap: highlight the target tab now, and show a thin progress line
        // if the page takes longer than a blink to arrive (e.g. Mein Team on mobile data).
        const page = () => document.querySelector(".page-in");
        document.addEventListener("astro:before-preparation", (e) => {
          highlight(tabFor(e.to.pathname));
          const sliding = movePill(tabFor(e.to.pathname));
          // The new page goes in only once the pill has nearly arrived (97 % of the way after 210 ms): building
          // a page is heavy on phones, and doing it during the slide made the slide stutter. The page loads
          // meanwhile, so this waits only when it arrived faster than that.
          if (sliding) {
            const load = e.loader;
            const settled = new Promise((done) => setTimeout(done, Math.max(0, 210 - Number(sliding.currentTime ?? 0))));
            e.loader = async () => { await Promise.all([load(), settled]); };
          }
          // The old page dims while the next one loads (most are prefetched, so this is often cut short).
          if (e.to.pathname !== location.pathname) {
            const leaving = page();
            leaving?.classList.add("page-leaving");
            // Should the navigation die without a new page, the old one comes back.
            setTimeout(() => leaving?.isConnected && leaving.classList.remove("page-leaving"), 8000);
          }
          clearTimeout(slow);
          slow = setTimeout(() => bar()?.classList.add("is-loading"), 150);
        });
        document.addEventListener("astro:after-preparation", () => {
          clearTimeout(slow);
          bar()?.classList.remove("is-loading");
        });
        document.addEventListener("astro:after-swap", () => {
          movePill(document.querySelector("[data-active-tab]")?.dataset.activeTab);
        });
        document.addEventListener("astro:page-load", () => {
          page()?.classList.remove("page-leaving");
          clearTimeout(slow);
          bar()?.classList.remove("is-loading");
          const tab = document.querySelector("[data-active-tab]")?.dataset.activeTab;
          highlight(tab);
          movePill(tab);
        });
        // Tapping the tab of the page you're on scrolls back to the top (like iOS) instead of reloading it.
        document.addEventListener("click", (e) => {
          const tab = e.target.closest?.("nav [data-tab]");
          if (!tab || new URL(tab.href).pathname !== location.pathname) return;
          e.preventDefault();
          window.scrollTo({ top: 0, behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
        }, true);
        document.addEventListener("astro:before-swap", (e) => {
          // The new page fades in from where the old one's dimming got to (at most 0.7, so even an instant
          // switch, e.g. back from the cache, is a soft fade rather than a cut).
          const old = page();
          const from = String(Math.min(0.7, old ? Number(getComputedStyle(old).opacity) : 0));
          e.newDocument.querySelector(".page-in")?.style.setProperty("--from", from);
          apply(e.newDocument);
          window.__fillSettings(e.newDocument);
          window.__applyLive?.(e.newDocument);
          e.newDocument.documentElement.dataset.navigated = "";
        });
        document.addEventListener("click", (e) => {
          // Lineup: the ⇄ mark flips between a player and their alternative (a tap elsewhere opens the player card).
          const hint = e.target.closest?.("[data-swap-hint]");
          const swap = hint?.closest("[data-swap]");
          if (swap) {
            const on = !swap.hasAttribute("data-flipped");
            swap.toggleAttribute("data-flipped", on);
            swap.querySelectorAll(".swap-face").forEach((f) => {
              const shown = f.classList.contains("swap-alt") === on;
              f.toggleAttribute("inert", !shown);
              if (shown) f.removeAttribute("aria-hidden");
              else f.setAttribute("aria-hidden", "true");
            });
            return;
          }
          const choice = e.target.closest?.("[data-theme-set]");
          if (!choice) return;
          const theme = choice.getAttribute("data-theme-set");
          if (theme !== "light" && theme !== "dark") return;
          try { localStorage.setItem("theme", theme); } catch {}
          // The whole page changes colour in one frame: buttons with colour transitions would otherwise
          // fade from the old theme while everything around them has already switched.
          const root = document.documentElement;
          root.classList.add("theme-switching");
          apply(document);
          markTheme();
          requestAnimationFrame(() => requestAnimationFrame(() => root.classList.remove("theme-switching")));
        });
        // Login/logout forms load a new page: show at once that the tap registered, and block double sends.
        document.addEventListener("submit", (e) => {
          const form = e.target;
          if (!(form instanceof HTMLFormElement) || form.method !== "post" || !form.hasAttribute("data-astro-reload")) return;
          const btn = form.querySelector('button[type="submit"]');
          if (btn?.classList.contains("is-busy")) { e.preventDefault(); return; }
          btn?.classList.add("is-busy");
          btn?.setAttribute("aria-busy", "true");
          const action = new URL(form.action).pathname;
          if (action === "/api/login/") {
            const setAnalyticsContext = (name, value) => {
              if (!value) return;
              const input = document.createElement("input");
              input.type = "hidden";
              input.name = name;
              input.value = value;
              form.append(input);
            };
            setAnalyticsContext("posthog_distinct_id", window.posthog?.get_distinct_id?.());
            setAnalyticsContext("posthog_session_id", window.posthog?.get_session_id?.());
          } else if (action === "/api/logout/") {
            window.posthog?.capture("kickbase_logged_out");
            window.posthog?.reset();
            delete window.__posthogIdentifiedId;
          } else if (action === "/api/li-logout/") {
            window.posthog?.capture("ligainsider_logged_out");
          }
        });
        // Back to a page from the browser cache: the buttons work again.
        addEventListener("pageshow", (e) => {
          if (e.persisted) document.querySelectorAll(".is-busy").forEach((b) => { b.classList.remove("is-busy"); b.removeAttribute("aria-busy"); });
        });
      }
    </script>
    <script is:inline>
      // Page switches swap the content directly instead of using the browser's view transitions: those
      // screenshot the whole page (slow on phones) and the glass tab bar, which loses its blur and corners.
      document.startViewTransition = undefined;
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body class="min-h-dvh bg-bg font-sans text-fg">
    <!-- New pages fade in (.page-in in global.css); the tab bar stays. -->
    <div class="page-in mx-auto max-w-[720px] px-4 pb-28 sm:px-6" data-active-tab={tab}>
      <header class="flex min-h-[44px] items-center gap-3 pt-6 pb-3">
        {back && (
          // Round back button (like iOS); goes back in history when there is one, so scroll position survives.
          <a
            href={back.href}
            aria-label={`Zurück zu ${back.label}`}
            class="press flex size-10 shrink-0 items-center justify-center rounded-full bg-surface text-fg"
            onclick="if (history.state && history.state.index > 0) { history.back(); return false; }"
          >
            <svg viewBox="0 0 24 24" class="size-[22px]" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
          </a>
        )}
        {/* Pages can put their own row beside the back button (an article's author and club). */}
        <slot name="top" />
        {!hideHeading && <h1 class="min-w-0 flex-1 text-[28px] leading-[1.1] font-bold tracking-[-0.03em] text-balance">{title}</h1>}
        {logo && (
          <span class="ml-auto shrink-0 self-center">
            <img src="/brand/wordmark-light.png" alt="TonInsider" width="105" height="26" class="brand-light h-[26px] w-auto" />
            <img src="/brand/wordmark-dark.png" alt="TonInsider" width="105" height="26" class="brand-dark h-[26px] w-auto" />
          </span>
        )}
      </header>
      <slot />
      {/* Fresh load: live scores from this session's copy before the first paint (navigations: astro:before-swap). */}
      <script is:inline>window.__applyLive?.(document);</script>
      <footer class="mt-10 border-t border-hairline pt-4 text-xs text-muted">
        {updated && <p>Stand: {fullDate(updated)} Uhr</p>}
        <p class="mt-1">Inhalte von <a class="underline" href="https://www.ligainsider.de/" target="_blank" rel="noopener noreferrer">ligainsider.de</a></p>
      </footer>
    </div>
    <nav style={`--tab:${Math.max(0, tabs.findIndex((t) => t.id === tab))}`} class:list={["tabbar fixed inset-x-3 bottom-[max(10px,env(safe-area-inset-bottom))] z-50 mx-auto max-w-[480px] rounded-[30px]", !tab && "no-tab"]} transition:persist="tabbar">
      <div class="nav-progress" data-nav-progress aria-hidden="true"></div>
      <button type="button" class="news-notice press" data-news-notice hidden>
        <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7" /></svg>
        Neue Meldungen
      </button>
      <div class="relative grid grid-cols-4 gap-1 p-1.5">
        <span class="tab-pill" aria-hidden="true"></span>
        {tabs.map((t) => (
          <a href={t.href} data-tab={t.id} data-astro-prefetch={t.id === "mein-team" ? "false" : undefined} class:list={["tab-item press flex flex-col items-center gap-0.5 rounded-[24px] px-0.5 py-1.5 text-[10px] font-medium leading-tight transition-colors duration-150", tab === t.id ? "text-accent is-active" : "text-muted"]}>
            <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={t.icon} /></svg>
            <span data-label class="text-center">{t.label}</span>
          </a>
        ))}
      </div>
    </nav>
    <script>
      import { navigate } from "astro:transitions/client";
      import { startLive } from "../lib/liveClient.ts";

      startLive();
      import { updateAction } from "../lib/freshness.ts";
      import type { Version } from "../../scraper/snapshot.ts";

      // Notice updates while the site is open: every minute while visible, and when coming back to it.
      const notice = () => document.querySelector<HTMLButtonElement>("[data-news-notice]");
      const pageVersion = (): Version => {
        const d = document.documentElement.dataset;
        return { newest: d.newest ? Number(d.newest) : undefined, updated: d.updated };
      };
      let hiddenAt = 0;
      let busy = false;

      async function check(resumed: boolean) {
        if (busy || document.visibilityState !== "visible") return;
        busy = true;
        try {
          const res = await fetch("/data/version.json", { cache: "no-store" });
          if (!res.ok) return;
          const live = (await res.json()) as Version;
          const action = updateAction(pageVersion(), live, { resumed, nearTop: scrollY < 120, path: location.pathname });
          if (action === "refresh") navigate(location.pathname + location.search, { history: "replace" });
          else if (action === "notice") notice()?.removeAttribute("hidden");
        } catch {
          // Offline: try again later.
        } finally {
          busy = false;
        }
      }

      setInterval(() => check(false), 60_000);
      document.addEventListener("visibilitychange", () => {
        if (document.visibilityState === "hidden") hiddenAt = Date.now();
        else if (hiddenAt && Date.now() - hiddenAt > 60_000) check(true);
      });
      document.addEventListener("astro:page-load", () => {
        notice()?.setAttribute("hidden", "");
        check(false);
      });
      document.addEventListener("click", (e) => {
        if (!(e.target as Element).closest?.("[data-news-notice]")) return;
        notice()?.setAttribute("hidden", "");
        navigate("/", { history: location.pathname === "/" ? "replace" : "push" });
      });
    </script>
  </body>
</html>
