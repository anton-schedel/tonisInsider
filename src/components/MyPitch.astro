---
import type { MyPlayer, StartStatus } from "../lib/match.ts";
import PitchFace from "./PitchFace.astro";
import PitchField from "./PitchField.astro";
import NewsBadge from "./NewsBadge.astro";
import KbPoints from "./KbPoints.astro";
import { slotStyle } from "../lib/pitch.ts";

interface Props {
  lines: MyPlayer[][];
  /** Player card data (cardAttr) by Kickbase player id. */
  cards: Map<string, string>;
  /** Kickbase ids of players with fresh news (newspaper icon). */
  fresh?: Set<string>;
}
const { lines, cards, fresh = new Set() } = Astro.props;
// The dot answers "will my player start?" according to LigaInsider's predicted lineup; "Bank" is the red note.
const TONE: Record<StartStatus, { dot: string; note?: string }> = {
  confirmed: { dot: "dot-green" },
  start: { dot: "dot-green" },
  contested: { dot: "dot-yellow" },
  doubtful: { dot: "dot-yellow", note: "Fraglich" },
  alternative: { dot: "dot-yellow", note: "Alternative" },
  bench: { dot: "dot-red", note: "Bank" },
  unknown: { dot: "dot-muted" },
};
---
<PitchField>
  {lines.map((line, i) =>
    line.map((p, j) => {
      const tone = TONE[p.status];
      const name = p.ligainsider?.name ?? p.kickbase.name;
      const note = p.status === "contested" && p.rival ? `Alt: ${p.rival}` : p.status === "doubtful" && p.statusLabel ? p.statusLabel : tone.note;
      return (
        <div class="absolute" style={slotStyle(i, lines.length, j, line.length)}>
          <button type="button" data-card={cards.get(p.kickbase.id)} class="press flex w-full flex-col items-center text-center">
            {/* Before kickoff the note: will he start? From kickoff on: his Kickbase points. */}
            <PitchFace photo={p.ligainsider?.photo ?? p.kickbase.image} name={name} note={p.kickbase.live?.state ? undefined : note} noteRed={p.status === "bench"}>
              {p.status === "confirmed"
                ? <span class="s11-badge" title="Startelf bestätigt">S11</span>
                : <span class:list={["start-dot", tone.dot]}></span>}
              {p.rival && <span class="swap-hint is-top" aria-hidden="true">⇄</span>}
              {fresh.has(p.kickbase.id) && <NewsBadge />}
              {p.club?.crest && <img src={p.club.crest} alt="" class="crest-overlay -bottom-0.5 -left-1 size-[20px]" />}
              {/* Right under the photo, so every player's points are level, however long his name. */}
              <KbPoints slot="points" id={p.kickbase.id} player={p.kickbase.id} live={p.kickbase.live} />
            </PitchFace>
          </button>
        </div>
      );
    }),
  )}
  <Fragment slot="legend">
    {lines.some((line) => line.some((p) => p.status === "confirmed")) && <span class="legend-item"><span class="s11-badge is-legend">S11</span>Startelf bestätigt</span>}
    <span class="legend-item"><i class="legend-dot dot-green"></i>Startelf</span>
    <span class="legend-item"><i class="legend-dot dot-yellow"></i>Fraglich oder Alternative</span>
    <span class="legend-item"><i class="legend-dot dot-red"></i>Nicht in der Startelf</span>
    <span class="legend-item"><i class="legend-dot dot-muted"></i>Keine Infos</span>
    {lines.some((line) => line.some((p) => fresh.has(p.kickbase.id))) && <span class="legend-item"><NewsBadge class="is-inline" />Neue News</span>}
    <span>Tippen für Prognose</span>
  </Fragment>
</PitchField>
