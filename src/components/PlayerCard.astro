---
/**
 * Player card laid out like a FIFA Ultimate Team card, in a sheet: opened by tapping any element with
 * data-card (JSON from cardAttr in lib/card.ts). One per page; the script fills it on tap.
 * The big number is the scorer chance (goal or assist), else the goal chance; below it the position and the club.
 */
---
<dialog class="player-card" data-player-card aria-label="Spieler">
  <div class="player-card-body">
    <div class="mx-auto mb-5 h-1 w-9 rounded-full bg-hairline" aria-hidden="true"></div>

    <div class="fut">
      <div class="fut-top">
        <div class="fut-side">
          <span data-f="rating" class="fut-rating"></span>
          <span data-f="caption" class="fut-caption"></span>
          <span class="fut-pos"><img data-f="crest" alt="" class="fut-crest" hidden /><span data-f="pos"></span></span>
        </div>
        <span class="fut-photo">
          <span data-f="initials" aria-hidden="true"></span>
          <img data-f="photo" alt="" hidden />
        </span>
      </div>
      <p data-f="name" class="fut-name"></p>
      <div class="mt-2 flex flex-wrap items-center gap-x-2 gap-y-1">
        <span data-f="status" class="rounded-full px-[8px] py-[2px] text-[12px] font-semibold" hidden></span>
        <span data-f="match" class="text-[14px] text-muted"></span>
      </div>
      <div data-f="stats" class="fut-stats"></div>
    </div>

    <div class="mt-5 flex gap-2">
      <a data-f="href" class="press flex-1 rounded-xl bg-surface py-3 text-center text-[15px] font-semibold" hidden>Zum Verein</a>
      <button type="button" data-card-close class="press flex-1 rounded-xl bg-fg py-3 text-[15px] font-semibold text-bg">Schließen</button>
    </div>
  </div>
</dialog>

<script>
  import type { CardData } from "../lib/card.ts";
  import { initials } from "../lib/format.ts";

  const STATS = [
    { key: "goal", label: "Tor" },
    { key: "win", label: "Sieg" },
    { key: "cleanSheet", label: "Zu Null" },
    { key: "card", label: "Karte" },
  ] as const;
  // Cards cost points: a high risk is marked.
  const CARD_WARN = 30;

  function fill(dialog: HTMLDialogElement, d: CardData) {
    const f = (name: string) => dialog.querySelector<HTMLElement>(`[data-f="${name}"]`)!;
    f("name").textContent = d.name;
    f("initials").textContent = initials(d.name);
    // Without assist odds the goal chance stands in.
    const rating = d.scorer ?? d.goal;
    f("rating").textContent = rating !== undefined ? `${rating}%` : "–";
    f("caption").textContent = d.scorer === undefined && d.goal !== undefined ? "Tor" : "Scorer";
    f("pos").textContent = d.pos ?? "";
    f("match").textContent = d.match ?? "";
    f("match").hidden = !d.match;

    const photo = f("photo") as HTMLImageElement;
    photo.hidden = true;
    photo.onload = () => (photo.hidden = false);
    photo.onerror = () => (photo.hidden = true);
    if (d.photo) photo.src = d.photo;
    else photo.removeAttribute("src");
    const crest = f("crest") as HTMLImageElement;
    crest.hidden = !d.crest;
    if (d.crest) crest.src = d.crest;

    const status = f("status");
    status.hidden = !d.status;
    status.textContent = d.status ?? "";
    status.style.cssText = d.tone === "grey" || !d.tone
      ? "background:var(--surface);color:var(--muted)"
      : `background:var(--${d.tone}-bg);color:var(--${d.tone}-fg)`;

    // Two columns like the stats on a FIFA card: value, then the label.
    // The goal chance standing in as the big number isn't repeated below.
    const shown = STATS.filter((s) => !(s.key === "goal" && d.scorer === undefined && d.goal !== undefined));
    f("stats").replaceChildren(...shown.map((s) => {
      const v = d[s.key];
      const el = document.createElement("span");
      el.className = "fut-stat";
      const value = document.createElement("b");
      value.textContent = v === undefined ? "–" : `${v}%`;
      if (s.key === "card" && v !== undefined && v >= CARD_WARN) value.className = "is-warn";
      el.append(value, s.label);
      return el;
    }));

    const link = f("href") as HTMLAnchorElement;
    link.hidden = !d.href;
    if (d.href) link.href = d.href;
  }

  const CLOSE_MS = 240;
  const reduced = () => matchMedia("(prefers-reduced-motion: reduce)").matches;

  /** Slides the sheet away, then closes it (the dialog's own close would make it vanish at once). */
  function closeCard(dialog: HTMLDialogElement) {
    if (!dialog.open || dialog.classList.contains("is-closing")) return;
    dialog.classList.remove("is-dragging");
    if (reduced()) {
      dialog.close();
      return;
    }
    dialog.classList.add("is-closing");
    setTimeout(() => {
      dialog.close();
      dialog.classList.remove("is-closing");
      dialog.style.removeProperty("--drag");
    }, CLOSE_MS);
  }

  document.addEventListener("click", (e) => {
    const target = e.target as Element | null;
    const dialog = document.querySelector<HTMLDialogElement>("[data-player-card]");
    if (!dialog || !target?.closest) return;
    if (dialog.open) {
      // Close button, or a tap on the dimmed backdrop (the dialog element itself, outside the body).
      if (target.closest("[data-card-close]") || target === dialog) closeCard(dialog);
      return;
    }
    // The ⇄ mark flips to the alternative (Base.astro) instead of opening the card.
    if (target.closest("[data-swap-hint]")) return;
    const trigger = target.closest<HTMLElement>("[data-card]");
    if (!trigger) return;
    try {
      fill(dialog, JSON.parse(trigger.dataset.card!) as CardData);
    } catch {
      return;
    }
    dialog.showModal();
  });
  // Escape animates like the button.
  document.addEventListener("cancel", (e) => {
    const dialog = e.target;
    if (!(dialog instanceof HTMLDialogElement) || !dialog.matches("[data-player-card]")) return;
    e.preventDefault();
    closeCard(dialog);
  }, true);

  // Swipe down to close: the sheet follows the finger; far enough (or fast enough) closes it, else it snaps back.
  let drag: { y: number; t: number; dialog: HTMLDialogElement } | undefined;
  document.addEventListener("touchstart", (e) => {
    const dialog = (e.target as Element).closest?.<HTMLDialogElement>("[data-player-card]");
    if (!dialog?.open || dialog.scrollTop > 0) return;
    drag = { y: e.touches[0].clientY, t: e.timeStamp, dialog };
  }, { passive: true });
  document.addEventListener("touchmove", (e) => {
    if (!drag) return;
    const dy = Math.max(0, e.touches[0].clientY - drag.y);
    drag.dialog.classList.add("is-dragging");
    drag.dialog.style.setProperty("--drag", `${dy}px`);
  }, { passive: true });
  document.addEventListener("touchend", (e) => {
    if (!drag) return;
    const { dialog, y, t } = drag;
    drag = undefined;
    const dy = Math.max(0, e.changedTouches[0].clientY - y);
    const fast = dy > 30 && dy / Math.max(1, e.timeStamp - t) > 0.5;
    if (dy > 90 || fast) return closeCard(dialog);
    dialog.classList.remove("is-dragging");
    dialog.style.removeProperty("--drag");
  });

  // Leaving the page (link in the card, back button) never leaves the sheet open behind.
  document.addEventListener("astro:before-preparation", () => document.querySelector<HTMLDialogElement>("[data-player-card]")?.close());
</script>
