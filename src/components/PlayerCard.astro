---
/**
 * Player card: a sheet with the odds-based outlook, opened by tapping any element with data-card
 * (JSON from cardAttr in lib/card.ts). One per page; the script fills it on tap.
 */
---
<dialog class="player-card" data-player-card aria-label="Spieler">
  <div class="player-card-body">
    <div class="mx-auto mb-4 h-1 w-9 rounded-full bg-hairline" aria-hidden="true"></div>
    <div class="flex items-center gap-3.5">
      <span class="relative shrink-0">
        <span class="relative inline-flex size-[60px] items-center justify-center overflow-hidden rounded-full bg-surface text-[21px] font-semibold text-muted">
          <span data-f="initials" aria-hidden="true"></span>
          <img data-f="photo" alt="" class="absolute inset-0 size-full object-cover" hidden />
        </span>
        <img data-f="crest" alt="" class="absolute -right-1.5 -bottom-1 size-6 object-contain" hidden />
      </span>
      <span class="min-w-0 flex-1">
        <span data-f="name" class="block text-[20px] leading-tight font-bold tracking-[-0.02em]"></span>
        <span data-f="match" class="mt-0.5 block truncate text-[14px] text-muted"></span>
        <span data-f="status" class="mt-1.5 inline-block rounded-full px-[7px] py-[2px] text-[11px] font-semibold" hidden></span>
      </span>
    </div>

    <dl data-f="rows" class="mt-5 divide-y divide-hairline border-y border-hairline"></dl>
    <p data-f="empty" class="mt-5 text-[14px] text-muted" hidden>Tor, Scorer und Karte kommen am Donnerstag vor dem Spieltag ab 18 Uhr.</p>
    <p class="mt-3 text-xs text-muted">Aus Wettquoten, Buchmacher-Marge herausgerechnet.</p>

    <div class="mt-5 flex gap-2">
      <a data-f="href" class="press flex-1 rounded-xl bg-surface py-3 text-center text-[15px] font-semibold" hidden>Zum Verein</a>
      <button type="button" data-card-close class="press flex-1 rounded-xl bg-fg py-3 text-[15px] font-semibold text-bg">Schließen</button>
    </div>
  </div>
</dialog>

<script>
  import type { CardData } from "../lib/card.ts";
  import { initials } from "../lib/format.ts";

  const ROWS = [
    { key: "goal", label: "Tor", hint: "trifft im nächsten Spiel" },
    { key: "scorer", label: "Scorer", hint: "Tor oder Vorlage" },
    { key: "cleanSheet", label: "Zu Null", hint: "sein Team bekommt kein Gegentor" },
    { key: "card", label: "Karte", hint: "Gelb oder Rot" },
  ] as const;
  // Cards cost points: a high risk is marked.
  const CARD_WARN = 30;

  function fill(dialog: HTMLDialogElement, d: CardData) {
    const f = (name: string) => dialog.querySelector<HTMLElement>(`[data-f="${name}"]`)!;
    f("name").textContent = d.name;
    f("initials").textContent = initials(d.name);
    f("match").textContent = d.match ?? "";
    f("match").hidden = !d.match;

    const photo = f("photo") as HTMLImageElement;
    photo.hidden = true;
    photo.onload = () => (photo.hidden = false);
    photo.onerror = () => (photo.hidden = true);
    if (d.photo) photo.src = d.photo;
    else photo.removeAttribute("src");
    const crest = f("crest") as HTMLImageElement;
    crest.hidden = !d.crest;
    if (d.crest) crest.src = d.crest;

    const status = f("status");
    status.hidden = !d.status;
    status.textContent = d.status ?? "";
    status.style.cssText = d.tone === "grey" || !d.tone
      ? "background:var(--surface);color:var(--muted)"
      : `background:var(--${d.tone}-bg);color:var(--${d.tone}-fg)`;

    const rows = ROWS.filter((r) => d[r.key] !== undefined);
    f("rows").replaceChildren(...rows.map((r) => {
      const v = d[r.key]!;
      const row = document.createElement("div");
      row.className = "flex items-center justify-between gap-3 py-3";
      const term = document.createElement("dt");
      term.innerHTML = `<span class="block text-[15px] font-semibold"></span><span class="block text-[13px] text-muted"></span>`;
      term.children[0].textContent = r.label;
      term.children[1].textContent = r.hint;
      const value = document.createElement("dd");
      value.className = "text-[22px] font-bold tracking-[-0.02em] tabular-nums";
      value.textContent = `${v} %`;
      if (r.key === "card" && v >= CARD_WARN) value.style.color = "var(--yellow-fg)";
      row.append(term, value);
      return row;
    }));
    f("rows").hidden = rows.length === 0;
    // Clean sheets come from the win odds all week; the player markets only from Thursday evening.
    f("empty").hidden = d.goal !== undefined || d.scorer !== undefined || d.card !== undefined;

    const link = f("href") as HTMLAnchorElement;
    link.hidden = !d.href;
    if (d.href) link.href = d.href;
  }

  document.addEventListener("click", (e) => {
    const target = e.target as Element | null;
    const dialog = document.querySelector<HTMLDialogElement>("[data-player-card]");
    if (!dialog || !target?.closest) return;
    if (dialog.open) {
      // Close button, or a tap on the dimmed backdrop (the dialog element itself, outside the body).
      if (target.closest("[data-card-close]") || target === dialog) dialog.close();
      return;
    }
    // The ⇄ mark flips to the alternative (Base.astro) instead of opening the card.
    if (target.closest("[data-swap-hint]")) return;
    const trigger = target.closest<HTMLElement>("[data-card]");
    if (!trigger) return;
    try {
      fill(dialog, JSON.parse(trigger.dataset.card!) as CardData);
    } catch {
      return;
    }
    dialog.showModal();
  });
  // Leaving the page (link in the card, back button) never leaves the sheet open behind.
  document.addEventListener("astro:before-preparation", () => document.querySelector<HTMLDialogElement>("[data-player-card]")?.close());
</script>
