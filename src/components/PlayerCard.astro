---
/**
 * Player card laid out like a FIFA Ultimate Team card, in a sheet: opened by tapping any element with
 * data-card (JSON from cardAttr in lib/card.ts). One per page; the script fills it on tap.
 * The big number is the scorer chance (goal or assist), else the goal chance; below it the position and the club.
 */
---
<dialog class="player-card" data-player-card aria-label="Spieler">
  {/* Takes the focus on opening (else the browser focuses the first news link and outlines it). */}
  <div class="player-card-body" tabindex="-1" autofocus>
    <div class="mx-auto mb-5 h-1 w-9 rounded-full bg-hairline" aria-hidden="true"></div>

    <div class="fut">
      <div class="fut-top">
        {/* Number at the top, who it is at the bottom: the column spans the photo's height. */}
        <div class="fut-side">
          <div>
            <span data-f="rating" class="fut-rating"></span>
            <span data-f="caption" class="fut-caption"></span>
          </div>
          <div>
            <p data-f="name" class="fut-name"></p>
            <div class="fut-meta">
              <img data-f="crest" alt="" class="fut-crest" hidden />
              <span data-f="pos" class="fut-pos"></span>
              <span data-f="status" class="rounded-full px-[7px] py-[1px] text-[11.5px] font-semibold" hidden></span>
            </div>
          </div>
        </div>
        <span class="fut-photo">
          <span data-f="initials" aria-hidden="true"></span>
          <img data-f="photo" alt="" hidden />
        </span>
      </div>
      <p data-f="match" class="mt-3 text-[14px] text-muted"></p>
      <div data-f="stats" class="fut-stats"></div>
      {/* From kickoff to the end of the matchday, instead of the odds: what he did and what it was worth. */}
      <div data-f="breakdown" class="fut-news" hidden>
        <p class="fut-news-label">Punkte am Spieltag</p>
        <div data-f="breakdownList" class="divide-y divide-hairline"></div>
      </div>
      {/* His latest news: tapping one opens the article (the card closes on the way). */}
      <div data-f="news" class="fut-news" hidden>
        <p class="fut-news-label">News</p>
        <div data-f="newsList" class="divide-y divide-hairline"></div>
      </div>
    </div>

  </div>
  {/* Always in reach: points and news scroll above it. */}
  <div class="player-card-foot">
    <button type="button" data-scout-toggle class="scout-toggle press flex-1 rounded-xl bg-surface py-3 text-[15px] font-semibold" aria-pressed="false" hidden>
      <svg viewBox="0 0 24 24" class="size-[17px]" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3.5l2.6 5.3 5.8.8-4.2 4.1 1 5.8L12 16.8l-5.2 2.7 1-5.8-4.2-4.1 5.8-.8z" /></svg>
      <span data-scout-label>Scouten</span>
    </button>
    <a data-f="href" class="press flex-1 rounded-xl bg-surface py-3 text-center text-[15px] font-semibold" hidden>Zum Verein</a>
    <button type="button" data-card-close class="press flex-1 rounded-xl bg-fg py-3 text-[15px] font-semibold text-bg">Schließen</button>
  </div>
</dialog>

<script>
  import type { CardData, CardNews } from "../lib/card.ts";
  import { actionTier, setTier, TIERS, type PlayerPoints, type PointsLine } from "../lib/livePoints.ts";
  import { ago, initials, kickoffDay } from "../lib/format.ts";
  import { NEWS_TYPE } from "../lib/newsTypes.ts";
  import { loadScout, setScouted } from "../lib/scoutClient.ts";

  /** The card's star: on the scout list or not (LigaInsider id in the card; none, no star). */
  function setStar(dialog: HTMLDialogElement, on: boolean) {
    const btn = dialog.querySelector<HTMLButtonElement>("[data-scout-toggle]")!;
    btn.setAttribute("aria-pressed", String(on));
    btn.querySelector("[data-scout-label]")!.textContent = on ? "Gescoutet" : "Scouten";
  }
  async function fillScout(dialog: HTMLDialogElement, id: number | undefined) {
    const btn = dialog.querySelector<HTMLButtonElement>("[data-scout-toggle]")!;
    btn.hidden = !id;
    dialog.dataset.player = id ? String(id) : "";
    if (!id) return;
    setStar(dialog, false);
    const state = await loadScout();
    if (dialog.dataset.player === String(id)) setStar(dialog, state.ids.includes(id));
  }

  /** "vor 3 Std." within a day, else the day ("Mi. 07.10."). */
  const when = (iso: string, now: Date) => (now.getTime() - Date.parse(iso) < 86_400_000 ? ago(iso, now) : kickoffDay(iso));

  function newsRow(n: CardNews, now: Date): HTMLElement {
    const row = document.createElement("a");
    row.href = `/artikel/${n.id}/`;
    row.className = "press-row fut-news-item";
    const title = document.createElement("span");
    title.className = "fut-news-title";
    title.textContent = n.title;
    const meta = document.createElement("span");
    meta.className = "fut-news-meta";
    const type = NEWS_TYPE[n.type];
    if (type) {
      const pill = document.createElement("span");
      pill.className = "fut-news-type";
      pill.style.cssText = `background:var(--${type.tone}-bg);color:var(--${type.tone}-fg)`;
      pill.textContent = type.label;
      meta.append(pill);
    }
    meta.append(when(n.at, now));
    row.append(title, meta);
    return row;
  }

  const STATS = [
    { key: "goal", label: "Tor" },
    { key: "win", label: "Sieg" },
    { key: "cleanSheet", label: "Zu Null" },
    { key: "card", label: "Karte" },
  ] as const;
  // Cards cost points: a high risk is marked.
  const CARD_WARN = 30;

  function pointsRow(l: PointsLine): HTMLElement {
    const row = document.createElement("div");
    row.className = "fut-points-row";
    const name = document.createElement("span");
    name.className = "min-w-0 flex-1 truncate";
    name.textContent = l.name;
    const count = document.createElement("span");
    count.className = "text-muted";
    count.textContent = l.count > 1 ? `${l.count}×` : "";
    const pts = document.createElement("b");
    setTier(pts, actionTier(l.points));
    pts.textContent = l.points > 0 ? `+${l.points}` : String(l.points);
    row.append(name, count, pts);
    return row;
  }

  /** Breakdowns already loaded (a player tapped again shows his at once). */
  const breakdowns = new Map<string, { at: number; data: PlayerPoints }>();
  async function loadBreakdown(player: string): Promise<PlayerPoints> {
    const res = await fetch(`/api/kickbase/player/${player}/`);
    if (!res.ok) throw new Error();
    const data = (await res.json()) as PlayerPoints;
    breakdowns.set(player, { at: Date.now(), data });
    return data;
  }

  /** Lines of the breakdown shown at first. */
  const SHOWN_LINES = 6;
  // The card can be reopened for someone else while a breakdown is still loading: only the latest one is drawn.
  let shown = 0;

  /** From kickoff on: the actions behind his points, instead of the odds (back to them if Kickbase fails). */
  async function fillBreakdown(dialog: HTMLDialogElement, player: string | undefined) {
    const f = (name: string) => dialog.querySelector<HTMLElement>(`[data-f="${name}"]`)!;
    const box = f("breakdown");
    const list = f("breakdownList");
    const mine = ++shown;
    box.querySelector(".fut-points-more")?.remove();
    box.hidden = !player;
    if (!player) return;
    const stats = f("stats");
    const hadStats = !stats.hidden;
    stats.hidden = true;
    // Placeholders as tall as the lines that replace them (6 shown), so the card keeps its height.
    const hit = breakdowns.get(player);
    const fresh = hit && Date.now() - hit.at < (hit.data.live.state === 2 ? 600_000 : 30_000);
    if (!fresh) {
      list.replaceChildren(...[0.62, 0.48, 0.55, 0.4, 0.5, 0.36].map((w) => {
        const row = document.createElement("div");
        row.className = "fut-points-row";
        row.innerHTML = `<span class="skeleton block h-3 rounded-full" style="width:${w * 100}%"></span><span class="skeleton ml-auto block h-3 w-7 rounded-full"></span>`;
        return row;
      }));
    }
    try {
      const data = fresh ? hit.data : await loadBreakdown(player);
      if (mine !== shown) return;
      if (data.live.state === 0 || data.lines.length === 0) throw new Error();
      // The biggest effects first; the rest one tap away, so his news stays in reach.
      const rows = data.lines.map(pointsRow);
      rows.slice(SHOWN_LINES).forEach((r) => (r.hidden = true));
      list.replaceChildren(...rows);
      if (!fresh) list.animate?.([{ opacity: 0 }, { opacity: 1 }], { duration: 180, easing: "ease-out" });
      if (rows.length > SHOWN_LINES) {
        const more = document.createElement("button");
        more.type = "button";
        more.className = "press fut-points-more";
        more.textContent = `Alle ${rows.length} Aktionen`;
        more.addEventListener("click", () => {
          rows.forEach((r) => (r.hidden = false));
          more.remove();
        });
        list.after(more);
      }
    } catch {
      if (mine !== shown) return;
      box.hidden = true;
      stats.hidden = !hadStats;
    }
  }

  /** From kickoff on (the tapped player shows his points chip): his points big, and their breakdown. */
  function fillPoints(dialog: HTMLDialogElement, trigger: HTMLElement) {
    const source = [...trigger.querySelectorAll<HTMLElement>("[data-kb-points]")].find((el) => !el.hidden);
    void fillBreakdown(dialog, source?.dataset.kbPlayer);
    if (!source) return;
    // From kickoff on the big number is his points, not the odds before the match.
    const text = source.querySelector("[data-kb-text]")?.textContent ?? "";
    const rating = dialog.querySelector<HTMLElement>('[data-f="rating"]')!;
    rating.textContent = text;
    setTier(rating, TIERS.find((t) => source.classList.contains(t)));
    const caption = dialog.querySelector<HTMLElement>('[data-f="caption"]')!;
    caption.textContent = "Punkte";
    if (source.classList.contains("is-live")) {
      const dot = document.createElement("span");
      dot.className = "kb-points-dot";
      dot.setAttribute("aria-label", "live");
      caption.append(dot);
    }
  }

  function fill(dialog: HTMLDialogElement, d: CardData) {
    const f = (name: string) => dialog.querySelector<HTMLElement>(`[data-f="${name}"]`)!;
    f("name").textContent = d.name;
    f("initials").textContent = initials(d.name);
    // The big number: the scorer chance; without assist odds the goal chance; for goalkeepers (no goal odds)
    // the clean sheet. Whichever it is isn't repeated in the row below.
    const hero = d.scorer !== undefined ? { key: "scorer", label: "Scorer" }
      : d.goal !== undefined ? { key: "goal", label: "Tor" }
      : d.cleanSheet !== undefined ? { key: "cleanSheet", label: "Zu Null" }
      : undefined;
    const rating = hero ? d[hero.key as "scorer" | "goal" | "cleanSheet"] : undefined;
    f("rating").textContent = rating !== undefined ? `${rating}%` : "–";
    setTier(f("rating"), undefined);
    f("caption").textContent = hero?.label ?? "Scorer";
    f("pos").textContent = d.pos ?? "";
    f("match").textContent = d.match ?? "";
    f("match").hidden = !d.match;

    const photo = f("photo") as HTMLImageElement;
    photo.hidden = true;
    photo.onload = () => (photo.hidden = false);
    photo.onerror = () => (photo.hidden = true);
    if (d.photo) photo.src = d.photo;
    else photo.removeAttribute("src");
    const crest = f("crest") as HTMLImageElement;
    crest.hidden = !d.crest;
    if (d.crest) crest.src = d.crest;

    const status = f("status");
    status.hidden = !d.status;
    status.textContent = d.status ?? "";
    status.style.cssText = d.tone === "grey" || !d.tone
      ? "background:var(--surface);color:var(--muted)"
      : `background:var(--${d.tone}-bg);color:var(--${d.tone}-fg)`;

    // A row of stats like on a FIFA card: value, then the label.
    // Only stats with a value, and not the one already shown big.
    const shown = STATS.filter((s) => d[s.key] !== undefined && s.key !== hero?.key);
    f("stats").replaceChildren(...shown.map((s) => {
      const v = d[s.key];
      const el = document.createElement("span");
      el.className = "fut-stat";
      const value = document.createElement("b");
      value.textContent = `${v}%`;
      if (s.key === "card" && v !== undefined && v >= CARD_WARN) value.className = "is-warn";
      el.append(value, s.label);
      return el;
    }));
    f("stats").hidden = shown.length === 0;

    const news = d.news ?? [];
    const now = new Date();
    f("newsList").replaceChildren(...news.map((n) => newsRow(n, now)));
    f("news").hidden = news.length === 0;

    const link = f("href") as HTMLAnchorElement;
    link.hidden = !d.href;
    if (d.href) link.href = d.href;
  }

  const CLOSE_MS = 240;
  const reduced = () => matchMedia("(prefers-reduced-motion: reduce)").matches;

  /** Slides the sheet away, then closes it (the dialog's own close would make it vanish at once). */
  function closeCard(dialog: HTMLDialogElement) {
    if (!dialog.open || dialog.classList.contains("is-closing")) return;
    dialog.classList.remove("is-dragging");
    if (reduced()) {
      dialog.close();
      return;
    }
    dialog.classList.add("is-closing");
    setTimeout(() => {
      dialog.close();
      dialog.classList.remove("is-closing");
      dialog.style.removeProperty("--drag");
    }, CLOSE_MS);
  }

  document.addEventListener("click", (e) => {
    const target = e.target as Element | null;
    const dialog = document.querySelector<HTMLDialogElement>("[data-player-card]");
    if (!dialog || !target?.closest) return;
    if (dialog.open) {
      const star = target.closest<HTMLButtonElement>("[data-scout-toggle]");
      if (star) {
        const id = Number(dialog.dataset.player);
        const on = star.getAttribute("aria-pressed") !== "true";
        setStar(dialog, on);
        setScouted(id, on).catch(() => setStar(dialog, !on));
        // The star changes for a moment, then the card goes (adding also clears the Scouting page's search).
        setTimeout(() => closeCard(dialog), 260);
        if (on) document.dispatchEvent(new CustomEvent("scout:added", { detail: id }));
        return;
      }
      // Close button, or a tap on the dimmed backdrop (the dialog element itself, outside the body).
      if (target.closest("[data-card-close]") || target === dialog) closeCard(dialog);
      return;
    }
    // The ⇄ mark flips to the alternative (Base.astro) instead of opening the card.
    if (target.closest("[data-swap-hint]")) return;
    const trigger = target.closest<HTMLElement>("[data-card]");
    if (!trigger) return;
    try {
      fill(dialog, JSON.parse(trigger.dataset.card!) as CardData);
      fillPoints(dialog, trigger);
      void fillScout(dialog, (JSON.parse(trigger.dataset.card!) as CardData).id);
    } catch {
      return;
    }
    dialog.showModal();
  });
  // Escape animates like the button.
  document.addEventListener("cancel", (e) => {
    const dialog = e.target;
    if (!(dialog instanceof HTMLDialogElement) || !dialog.matches("[data-player-card]")) return;
    e.preventDefault();
    closeCard(dialog);
  }, true);

  // Swipe down to close: the sheet follows the finger; far enough (or fast enough) closes it, else it snaps back.
  let drag: { y: number; t: number; dialog: HTMLDialogElement } | undefined;
  document.addEventListener("touchstart", (e) => {
    const dialog = (e.target as Element).closest?.<HTMLDialogElement>("[data-player-card]");
    // Only from the top of the content: further down a swipe scrolls it.
    if (!dialog?.open || (dialog.querySelector(".player-card-body")?.scrollTop ?? 0) > 0) return;
    drag = { y: e.touches[0].clientY, t: e.timeStamp, dialog };
  }, { passive: true });
  document.addEventListener("touchmove", (e) => {
    if (!drag) return;
    const dy = Math.max(0, e.touches[0].clientY - drag.y);
    drag.dialog.classList.add("is-dragging");
    drag.dialog.style.setProperty("--drag", `${dy}px`);
  }, { passive: true });
  document.addEventListener("touchend", (e) => {
    if (!drag) return;
    const { dialog, y, t } = drag;
    drag = undefined;
    const dy = Math.max(0, e.changedTouches[0].clientY - y);
    const fast = dy > 30 && dy / Math.max(1, e.timeStamp - t) > 0.5;
    if (dy > 90 || fast) return closeCard(dialog);
    dialog.classList.remove("is-dragging");
    dialog.style.removeProperty("--drag");
  });

  // Leaving the page (link in the card, back button) never leaves the sheet open behind.
  document.addEventListener("astro:before-preparation", () => document.querySelector<HTMLDialogElement>("[data-player-card]")?.close());
</script>
