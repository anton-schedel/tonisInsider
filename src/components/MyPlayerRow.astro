---
import type { MyPlayer } from "../lib/match.ts";
import Avatar from "./Avatar.astro";
import StartBadge from "./StartBadge.astro";
import { matchLine } from "../lib/card.ts";

interface Props {
  player: MyPlayer;
  index?: number;
  /** Player card data (cardAttr), opened on tap. */
  card?: string;
}
const { player: p, index = 0, card } = Astro.props;
const name = p.ligainsider?.name ?? p.kickbase.name;
const match = matchLine(p.lineup);
---
<button type="button" data-card={card} class="press-row enter flex w-full items-center gap-3 py-3 text-left" style={`--i:${index}`}>
  <span class="relative">
    <Avatar src={p.ligainsider?.photo ?? p.kickbase.image} name={name} size={44} />
    {p.club?.crest && <img src={p.club.crest} alt="" class="absolute -right-1.5 -bottom-1 size-[20px] object-contain drop-shadow-[0_1px_1px_rgba(0,0,0,0.35)]" />}
  </span>
  <span class="min-w-0 flex-1">
    <span class="block truncate text-[15px] font-semibold tracking-[-0.01em]">{name}</span>
    {match && <span class="block truncate text-xs text-muted">{match}</span>}
  </span>
  <StartBadge status={p.status} label={p.statusLabel} rival={p.rival} />
</button>
