---
import type { Lineup, Ref } from "../../scraper/types.ts";
import Avatar from "./Avatar.astro";
import PitchField from "./PitchField.astro";
import GoalChance from "./GoalChance.astro";
import { AVATAR, slotStyle } from "../lib/pitch.ts";

interface Props {
  lineup: Lineup;
  /** Chance to score in percent per player, if goalscorer odds exist for this match. */
  goal?: (player: Ref) => number | undefined;
}
const { lineup, goal = () => undefined } = Astro.props;
const anyGoal = lineup.lines.some((line) => line.some((p) => goal(p) !== undefined));
const rows = lineup.lines.length;
---
<PitchField>
  {lineup.lines.map((line, i) =>
    line.map((p, j) => (
      <div class="absolute w-[24%]" style={slotStyle(i, rows, j, line.length)}>
        <div>
          {p.alternative ? (
            // Tap swaps to the alternative and back (handler in Base.astro).
            <button type="button" data-swap aria-pressed="false" aria-label={`${p.name} oder ${p.alternative.name}`} class="swap grid w-full">
              <span class="swap-face flex flex-col items-center text-center">
                <span class="relative">
                  <Avatar src={p.photo} name={p.name} size={AVATAR} class="shadow-md ring-2 ring-white/80" />
                  <span class="absolute top-0 right-0 size-3.5 rounded-full border-2 border-white" style={`background:var(--${p.status === "doubtful" ? "yellow" : "green"}-dot)`} title={p.statusLabel ?? "Gesetzt"}></span>
                  <GoalChance percent={goal(p)} />
                  <span class="swap-hint" aria-hidden="true">⇄</span>
                </span>
                <span class="mt-1 line-clamp-2 text-[11px] leading-tight font-semibold break-words">{p.name}</span>
                <span class="line-clamp-1 text-[9.5px] leading-tight" style="color:var(--yellow-fg)">Alt: {p.alternative.name}</span>
              </span>
              <span class="swap-face swap-alt flex flex-col items-center text-center" aria-hidden="true">
                <span class="relative">
                  <Avatar src={p.alternative.photo} name={p.alternative.name} size={AVATAR} class="shadow-md ring-2 ring-[var(--yellow-dot)]" />
                  <GoalChance percent={goal(p.alternative)} />
                  <span class="swap-hint" aria-hidden="true">⇄</span>
                </span>
                <span class="mt-1 line-clamp-2 text-[11px] leading-tight font-semibold break-words">{p.alternative.name}</span>
                <span class="line-clamp-1 text-[9.5px] leading-tight" style="color:var(--yellow-fg)">statt {p.name}</span>
              </span>
            </button>
          ) : (
            <div class="flex flex-col items-center text-center">
              <span class="relative">
                <Avatar src={p.photo} name={p.name} size={AVATAR} class="shadow-md ring-2 ring-white/80" />
                <span class="absolute top-0 right-0 size-3.5 rounded-full border-2 border-white" style={`background:var(--${p.status === "doubtful" ? "yellow" : "green"}-dot)`} title={p.statusLabel ?? "Gesetzt"}></span>
                  <GoalChance percent={goal(p)} />
              </span>
              <span class="mt-1 line-clamp-2 text-[11px] leading-tight font-semibold break-words">{p.name}</span>
            </div>
          )}
        </div>
      </div>
    )),
  )}
  <Fragment slot="legend">
    <span class="flex items-center gap-1"><i class="size-2 rounded-full" style="background:var(--green-dot)"></i>Gesetzt</span>
    <span class="flex items-center gap-1"><i class="size-2 rounded-full" style="background:var(--yellow-dot)"></i>Fraglich</span>
    {anyGoal && <span class="flex items-center gap-1"><span class="goal-chance is-legend">40%</span>Torchance</span>}
  </Fragment>
</PitchField>
