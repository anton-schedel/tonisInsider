---
import type { Lineup, LineupPlayer, Ref } from "../../scraper/types.ts";
import type { PlayerInsight } from "../lib/scorers.ts";
import Avatar from "./Avatar.astro";
import PitchField from "./PitchField.astro";
import NewsBadge from "./NewsBadge.astro";
import { AVATAR, slotStyle } from "../lib/pitch.ts";
import { cardAttr, hasFreshNews, matchLine, rowPosition, type CardData, type CardNews } from "../lib/card.ts";

interface Props {
  lineup: Lineup;
  /** Odds-based outlook per player for the player card, if odds exist for this match. */
  insight?: (player: Ref) => PlayerInsight;
  /** Chance that this team keeps a clean sheet, in percent. */
  cleanSheet?: number;
  /** Chance that this team wins, in percent. */
  win?: number;
  /** LigaInsider confirmed this XI (shortly before kickoff). */
  confirmed?: boolean;
  /** A player's latest news for the card, by LigaInsider player id. */
  news?: (playerId: number) => CardNews[] | undefined;
}
const { lineup, insight = () => ({}), cleanSheet, win, confirmed = false, news = () => undefined } = Astro.props;
const rows = lineup.lines.length;
const match = matchLine(lineup);
const card = (p: Ref & { photo?: string }, pos: string, status: string, tone: CardData["tone"]) =>
  cardAttr({ name: p.name, photo: p.photo, crest: lineup.club.crest, pos, match, status, tone, ...insight(p), cleanSheet, win, news: news(p.id) });
const mainStatus = (p: LineupPlayer, pos: string) =>
  confirmed
    ? card(p, pos, "S11", "green")
    : p.status === "doubtful"
    ? card(p, pos, `Fraglich${p.statusLabel ? ` · ${p.statusLabel}` : ""}`, "yellow")
    : p.alternative
      ? card(p, pos, `Startelf · Alt. ${p.alternative.name}`, "yellow")
      : card(p, pos, "Startelf", "green");
---
<PitchField>
  {lineup.lines.map((line, i) =>
    line.map((p, j) => (
      <div class="absolute w-[24%]" style={slotStyle(i, rows, j, line.length, { mirror: true })}>
        <div>
          {p.alternative ? (
            // Tap opens the player card; the ⇄ mark swaps to the alternative and back (handler in Base.astro).
            <div data-swap class="swap grid w-full">
              <button type="button" data-card={mainStatus(p, rowPosition(i, rows))} class="press swap-face flex flex-col items-center text-center">
                <span class="relative">
                  <Avatar src={p.photo} name={p.name} size={AVATAR} class="shadow-md ring-2 ring-white/80" />
                  {hasFreshNews(news(p.id)) && <NewsBadge />}
                  {confirmed ? <span class="s11-badge" title="Startelf bestätigt">S11</span> : <span class="absolute top-0 right-0 size-3.5 rounded-full border-2 border-white" style={`background:var(--${p.status === "doubtful" ? "yellow" : "green"}-dot)`} title={p.statusLabel ?? "Gesetzt"}></span>}
                  <span class="swap-hint" data-swap-hint role="button" aria-label={`${p.alternative.name} zeigen`}>⇄</span>
                </span>
                <span class="mt-1 line-clamp-2 text-[11px] leading-tight font-semibold break-words">{p.name}</span>
                <span class="line-clamp-1 text-[9.5px] leading-tight" style="color:var(--yellow-fg)">Alt: {p.alternative.name}</span>
              </button>
              <button type="button" data-card={card(p.alternative, rowPosition(i, rows), `Alternative zu ${p.name}`, "yellow")} class="press swap-face swap-alt flex flex-col items-center text-center" aria-hidden="true" inert>
                <span class="relative">
                  <Avatar src={p.alternative.photo} name={p.alternative.name} size={AVATAR} class="shadow-md ring-2 ring-[var(--yellow-dot)]" />
                  {hasFreshNews(news(p.alternative.id)) && <NewsBadge />}
                  <span class="swap-hint" data-swap-hint role="button" aria-label={`${p.name} zeigen`}>⇄</span>
                </span>
                <span class="mt-1 line-clamp-2 text-[11px] leading-tight font-semibold break-words">{p.alternative.name}</span>
                <span class="line-clamp-1 text-[9.5px] leading-tight" style="color:var(--yellow-fg)">statt {p.name}</span>
              </button>
            </div>
          ) : (
            <button type="button" data-card={mainStatus(p, rowPosition(i, rows))} class="press flex w-full flex-col items-center text-center">
              <span class="relative">
                <Avatar src={p.photo} name={p.name} size={AVATAR} class="shadow-md ring-2 ring-white/80" />
                {hasFreshNews(news(p.id)) && <NewsBadge />}
                {confirmed ? <span class="s11-badge" title="Startelf bestätigt">S11</span> : <span class="absolute top-0 right-0 size-3.5 rounded-full border-2 border-white" style={`background:var(--${p.status === "doubtful" ? "yellow" : "green"}-dot)`} title={p.statusLabel ?? "Gesetzt"}></span>}
              </span>
              <span class="mt-1 line-clamp-2 text-[11px] leading-tight font-semibold break-words">{p.name}</span>
            </button>
          )}
        </div>
      </div>
    )),
  )}
  <Fragment slot="legend">
    {confirmed ? (
      <span class="flex items-center gap-1"><span class="s11-badge is-legend">S11</span>Startelf bestätigt</span>
    ) : (
      <>
        <span class="flex items-center gap-1"><i class="size-2 rounded-full" style="background:var(--green-dot)"></i>Gesetzt</span>
        <span class="flex items-center gap-1"><i class="size-2 rounded-full" style="background:var(--yellow-dot)"></i>Fraglich</span>
      </>
    )}
    {lineup.lines.flat().some((p) => hasFreshNews(news(p.id)) || (!!p.alternative && hasFreshNews(news(p.alternative.id)))) && (
      <span class="flex items-center gap-1"><NewsBadge class="is-inline" />Neue News</span>
    )}
    <span>Tippen für Prognose</span>
  </Fragment>
</PitchField>
