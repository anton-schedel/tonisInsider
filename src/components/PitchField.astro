---
/** The pitch shared by the team pages and Mein Team; players go in the default slot (see lib/pitch.ts). */
const box = "absolute left-1/2 -translate-x-1/2 border-[1.5px] border-[var(--pitch-line)]";
---
{/* Grass green with mowing stripes in light and dark mode alike; .pitch re-colours text and notes for it. */}
<div class="pitch relative w-full overflow-hidden rounded-[18px]" style="aspect-ratio:4 / 5.2">
  <div class="absolute inset-3 rounded-[3px] border-[1.5px] border-[var(--pitch-line)]"></div>
  <div class="absolute inset-x-3 top-1/2 border-t-[1.5px] border-[var(--pitch-line)]"></div>
  <div class="absolute top-1/2 left-1/2 size-[22%] -translate-1/2 rounded-full border-[1.5px] border-[var(--pitch-line)]"></div>
  <div class="absolute top-1/2 left-1/2 size-1.5 -translate-1/2 rounded-full bg-[var(--pitch-line)]"></div>
  {/* Penalty and goal areas, top and bottom. */}
  <div class:list={[box, "top-3 h-[15%] w-[56%] border-t-0"]}></div>
  <div class:list={[box, "top-3 h-[6%] w-[26%] border-t-0"]}></div>
  <div class:list={[box, "bottom-3 h-[15%] w-[56%] border-b-0"]}></div>
  <div class:list={[box, "bottom-3 h-[6%] w-[26%] border-b-0"]}></div>
  <slot />
</div>
<div class="flex flex-wrap justify-center gap-x-4 gap-y-1 py-3 text-[11px] text-muted">
  <slot name="legend" />
</div>
