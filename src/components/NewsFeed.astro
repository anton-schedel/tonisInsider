---
import type { Article } from "../../scraper/types.ts";
import ArticleRow from "./ArticleRow.astro";
import { groupByDay } from "../lib/data.ts";
import { dayLabel } from "../lib/format.ts";

interface Props { articles: Article[] }
const now = new Date();
const groups = groupByDay(Astro.props.articles);
let index = 0;
---
{groups.length === 0 && <p class="py-10 text-center text-muted">Noch keine News.</p>}
{groups.map((g) => (
  <section class="mb-4">
    <h2 class="sticky top-0 z-10 -mx-1 bg-bg/90 px-1 pt-3 pb-1.5 text-[15px] font-semibold backdrop-blur">
      {(() => {
        const [rel, date] = dayLabel(g.first, now).split(" · ");
        return date ? <>{rel} <span class="font-normal text-muted">{date}</span></> : rel;
      })()}
    </h2>
    <div class="divide-y divide-hairline">
      {g.items.map((a) => <ArticleRow article={a} index={index++} />)}
    </div>
  </section>
))}

