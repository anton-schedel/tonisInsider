---
import type { Article } from "../../scraper/types.ts";
import ArticleRow from "./ArticleRow.astro";
import { groupByDay } from "../lib/data.ts";
import { dayLabel } from "../lib/format.ts";

interface Props {
  articles: Article[];
  pinned?: Article[];
  /** Only these day groups (index from, to); the rest comes from `more`. */
  days?: { from: number; to?: number };
  /** Where the older days are (a partial page): loaded when the reader scrolls near the end. */
  more?: string;
}
const { pinned = [], days = { from: 0 }, more } = Astro.props;
const now = new Date();
const allGroups = groupByDay(Astro.props.articles);
const groups = allGroups.slice(days.from, days.to);
const hasMore = !!more && days.to !== undefined && allGroups.length > days.to;
// A post pinned for a while: on top until then, in its day after (the page may be older than the pin).
const until = new Map(pinned.flatMap((a) => (a.pinnedUntil ? [[a.id, a.pinnedUntil] as const] : [])));
let index = 0;
---
{pinned.length > 0 && (
  <section data-pinned>
    <h2 class="day-band">
      <svg viewBox="0 0 24 24" class="size-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 17v5M9 3h6l-1 6 4 4H6l4-4z" /></svg>
      Angeheftet
    </h2>
    {/* The rows' script lands after the last row, so divide-y would give that row a line too. */}
    <div class="divide-y divide-hairline [&>a:last-of-type]:border-b-0">
      {pinned.map((a) => <ArticleRow article={a} index={index++} withDay pinnedUntil={a.pinnedUntil} />)}
    </div>
  </section>
)}
{allGroups.length === 0 && <p class="py-10 text-center text-muted">Noch keine News.</p>}
{groups.map((g) => (
  <section>
    {/* Each day opens with a slim band (global.css .day-band) that stays at the top while its posts scroll by.
        Today's needs none (the newest posts are always today's) unless pinned posts come before it. */}
    <h2 class="day-band sticky top-0 z-10" data-day={g.first} data-today={dayLabel(g.first, now).startsWith("Heute ") ? "" : undefined}>
      {(() => {
        const [rel, date] = dayLabel(g.first, now).split(" · ");
        return date ? <>{rel} <span class="font-normal text-muted">{date}</span></> : rel;
      })()}
    </h2>
    <div class="feed-rows -mx-2.5 px-2.5" style={`--n:${g.items.length}`}>
      <div class="divide-y divide-hairline">
        {g.items.map((a) => <ArticleRow article={a} index={index++} showAfter={until.get(a.id)} />)}
      </div>
    </div>
  </section>
))}
{hasMore && (
  // Older days: fetched once the reader gets near here (script below); the button is the fallback.
  <div data-feed-more={more} class="pb-4">
    <button type="button" data-feed-more-btn class="press w-full rounded-xl bg-surface py-3 text-[15px] font-semibold">Ältere News laden</button>
  </div>
)}

<script is:inline>
  // Unpin posts whose time is up, before the page shows (also runs again after each client-side navigation,
  // and for older days once they're loaded).
  window.__unpin = () => {
    const now = Date.now();
    for (const el of document.querySelectorAll("[data-pinned-until]")) if (Date.parse(el.dataset.pinnedUntil) <= now) el.remove();
    for (const el of document.querySelectorAll("[data-show-after]")) if (Date.parse(el.dataset.showAfter) <= now) el.hidden = false;
    const section = document.querySelector("[data-pinned]");
    if (section && !section.querySelector("a")) section.remove();
  };
  window.__unpin();
</script>

<script>
  import { dayLabel } from "../lib/format.ts";

  declare global {
    interface Window { __unpin?: () => void }
  }

  // "Heute" / "Gestern" relative to now, not to when the page was built (it may be from yesterday).
  function labelDays(root: ParentNode) {
    const now = new Date();
    for (const h of root.querySelectorAll<HTMLElement>("[data-day]")) {
      const [rel, date] = dayLabel(h.dataset.day!, now).split(" · ");
      h.toggleAttribute("data-today", rel === "Heute");
      h.textContent = rel;
      if (date) {
        const muted = document.createElement("span");
        muted.className = "font-normal text-muted";
        muted.textContent = date;
        h.append(" ", muted);
      }
    }
  }

  /** The older days once fetched: back on News (e.g. from an article opened down there) they're put in at once,
   * before the router restores the scroll position. */
  let olderHtml: string | undefined;

  function appendOlder(marker: HTMLElement, html: string) {
    const doc = new DOMParser().parseFromString(html, "text/html");
    // Rows from the partial page shouldn't play the first-load entrance again.
    for (const el of doc.querySelectorAll(".enter")) el.classList.remove("enter");
    labelDays(doc);
    const target = marker.ownerDocument;
    marker.replaceWith(...[...doc.querySelectorAll("section")].map((s) => target.importNode(s, true)));
    if (target === document) window.__unpin?.();
  }

  /** Fetches the older days (the partial page) and appends their sections where the "more" marker is. */
  async function loadMore(marker: HTMLElement) {
    if (marker.dataset.loading) return;
    marker.dataset.loading = "1";
    const btn = marker.querySelector<HTMLButtonElement>("[data-feed-more-btn]");
    if (btn) btn.textContent = "Lädt …";
    try {
      const res = await fetch(marker.dataset.feedMore!);
      if (!res.ok) throw new Error();
      olderHtml = await res.text();
      if (marker.isConnected) appendOlder(marker, olderHtml);
    } catch {
      delete marker.dataset.loading;
      if (btn) btn.textContent = "Nicht geladen. Nochmal versuchen";
    }
  }

  // Into the incoming page before it's shown: the router restores the scroll position right after the swap,
  // and without the older days the page would be too short to get back down there.
  document.addEventListener("astro:before-swap", (e) => {
    const marker = e.newDocument.querySelector<HTMLElement>("[data-feed-more]");
    if (marker && olderHtml) appendOlder(marker, olderHtml);
  });

  document.addEventListener("astro:page-load", () => {
    labelDays(document);
    const marker = document.querySelector<HTMLElement>("[data-feed-more]");
    if (!marker) return;
    marker.querySelector("[data-feed-more-btn]")?.addEventListener("click", () => void loadMore(marker));
    // Well before the end, so scrolling doesn't stop at it.
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) {
        io.disconnect();
        void loadMore(marker);
      }
    }, { rootMargin: "1500px 0px" });
    io.observe(marker);
    document.addEventListener("astro:before-swap", () => io.disconnect(), { once: true });
  });
</script>
