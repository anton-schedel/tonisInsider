---
import type { Article } from "../../scraper/types.ts";
import Avatar from "./Avatar.astro";
import Crest from "./Crest.astro";
import StatusPill from "./StatusPill.astro";
import { dayKey, kickoffDay, time } from "../lib/format.ts";
import { commentCount } from "../lib/data.ts";
import { LOGO, NAME } from "../lib/brand.ts";
import { confirmedLineup } from "../lib/lineupNews.ts";

interface Props {
  article: Article;
  index?: number;
  /** Show the date too (outside the day-grouped feed, e.g. pinned articles). */
  withDay?: boolean;
  /** Pinned for a while: removed from the top once this time has passed (script in NewsFeed). */
  pinnedUntil?: string;
  /** The same post in the feed: hidden until its pin runs out. */
  showAfter?: string;
}
const { article: a, index = 0, withDay = false, pinnedUntil } = Astro.props;
// A scheduled post (the coach's) is built ahead and shown from its minute on (NewsFeed's __unpin).
const showAfter = [Astro.props.showAfter, Date.parse(a.publishedAt) > Date.now() ? a.publishedAt : undefined]
  .filter((t): t is string => !!t).sort().at(-1);
const comments = commentCount(a.id);
// Confirmed lineups show the XI right here, no need to open them.
const lineup = confirmedLineup(a);
// A post with neither player nor club carries our name and logo.
const by = { name: NAME, logo: LOGO };
---
{/* Club, time and comments: the same line under every kind of post. */}
{(() => {
  const meta = (
    <span class="flex items-center gap-1.5 text-[13px] text-muted">
      <StatusPill type={a.newsType} />
      {/* The name shortens on narrow rows; the time always stays visible. */}
      <span class="min-w-[3.5em] truncate">{a.player?.name ?? a.club?.name ?? by.name}</span>
      <span class="-ml-0.5 shrink-0 tabular-nums">·&nbsp;{withDay && dayKey(a.publishedAt) !== dayKey(new Date().toISOString()) && `${kickoffDay(a.publishedAt).replace(/^\S+ /, "")} `}{time(a.publishedAt)}</span>
      {/* Refreshed live by the script below. Hidden while there are no comments. */}
      <span class:list={["ml-auto flex shrink-0 items-center gap-1 pl-2 tabular-nums", !comments && "hidden"]} data-comment-count={a.id} aria-label="Kommentare">
        <svg viewBox="0 0 24 24" class="size-[15px]" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M4 5.5A1.5 1.5 0 0 1 5.5 4h13A1.5 1.5 0 0 1 20 5.5v9a1.5 1.5 0 0 1-1.5 1.5H10l-4.5 4v-4h0A1.5 1.5 0 0 1 4 14.5z" /></svg>
        <span data-n>{comments ?? 0}</span>
      </span>
    </span>
  );
  return lineup ? (
    // A confirmed lineup: crest, headline and XI like every other post (crest + gap = 80 px like the other
    // rows' picture + gap, so all text starts at the same edge); the bench runs on under the crest to keep it short.
    <a href={`/artikel/${a.id}/`} class="press-row enter block py-3.5" style={`--i:${index}`} data-pinned-until={pinnedUntil} data-show-after={showAfter} hidden={!!showAfter}>
      <span class="flex items-center gap-2">
        <span class="shrink-0">
          {a.club ? <Crest src={a.club.crest} name={a.club.name} size={72} /> : <Avatar src={by.logo} name={by.name} size={72} />}
        </span>
        <span class="min-w-0 flex-1">
          <span class="mb-1 block text-[17px] leading-snug font-semibold tracking-[-0.015em]">{a.headline}</span>
          {meta}
          <span class="mt-2 block text-[15px] leading-snug">{lineup.xi}</span>
        </span>
      </span>
      {lineup.bench && <span class="mt-2 block text-[13px] leading-snug text-muted">Bank: {lineup.bench}</span>}
    </a>
  ) : (
    <a href={`/artikel/${a.id}/`} class="press-row enter flex items-center gap-4 py-3.5" style={`--i:${index}`} data-pinned-until={pinnedUntil} data-show-after={showAfter} hidden={!!showAfter}>
      <span class="relative shrink-0">
        {a.player
          ? <Avatar src={a.player.photo} name={a.player.name} size={64} />
          : a.club
            ? <Crest src={a.club.crest} name={a.club.name} size={64} />
            : <Avatar src={by.logo} name={by.name} size={64} />}
        {a.player && a.club?.crest && (
          <img src={a.club.crest} alt="" class="absolute -right-1.5 -bottom-1 size-[26px] object-contain drop-shadow-[0_1px_1px_rgba(0,0,0,0.35)]" />
        )}
      </span>
      <span class="min-w-0 flex-1">
        <span class="mb-1 block text-[17px] leading-snug font-semibold tracking-[-0.015em]">{a.headline}</span>
        {meta}
      </span>
    </a>
  );
})()}

<script>
  // Refresh the counts of LigaInsider's newest articles live (the built page has the counts of the last scrape).
  document.addEventListener("astro:page-load", async () => {
    const badges = document.querySelectorAll<HTMLElement>("[data-comment-count]");
    if (!badges.length) return;
    // Our own posts: their count comes from our own comments.
    for (const b of badges) {
      const id = Number(b.dataset.commentCount);
      if (id < 900_000_000) continue;
      fetch(`/api/own-comments/${id}/`)
        .then((r) => (r.ok ? (r.json() as Promise<{ total: number }>) : undefined))
        .then((d) => {
          if (!d) return;
          b.querySelector("[data-n]")!.textContent = String(d.total);
          b.classList.toggle("hidden", d.total === 0);
        })
        .catch(() => {});
    }
    try {
      const res = await fetch("/api/comment-counts/");
      if (!res.ok) return;
      const counts = (await res.json()) as Record<string, number>;
      for (const b of badges) {
        const n = counts[b.dataset.commentCount!];
        if (n === undefined) continue;
        b.querySelector("[data-n]")!.textContent = String(n);
        b.classList.toggle("hidden", n === 0);
      }
    } catch {}
  });
</script>
