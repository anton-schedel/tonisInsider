---
import Crest from "./Crest.astro";
import type { Fixture } from "../lib/fixtures.ts";
import { kickoffDay, time } from "../lib/format.ts";
import type { Lineup } from "../../scraper/types.ts";
import type { Chances } from "../../scraper/odds.ts";
import { likelyScore } from "../lib/odds.ts";

interface Props {
  fixture: Fixture;
  /** "hero" on a team page: bigger, and the current club isn't a link. */
  size?: "list" | "hero";
  /** Slug of the club whose page this is. */
  current?: string;
  index?: number;
  /** Shown under the date on the hero card. */
  matchday?: number;
  /** Win chances from bookmaker odds; the bar is hidden without them. */
  chances?: Chances;
}
const { fixture: f, size = "list", current, index = 0, matchday, chances } = Astro.props;
// The likelier team gets the strong tone; draw stays neutral.
const strong = chances && (chances.home >= chances.away ? "home" : "away");
const score = chances && likelyScore(chances);
const hero = size === "hero";
const crest = hero ? 64 : 52;
const sides: { lineup?: Lineup; name: string }[] = [
  { lineup: f.home, name: f.homeName },
  { lineup: f.away, name: f.awayName },
];
---
<div
  data-fixture
  class:list={["rounded-[22px] bg-surface", hero ? "px-3 py-6" : "enter px-2 py-4"]}
  style={hero ? undefined : `--i:${index}`}
>
<div class="flex items-center">
  {sides.map((s, i) => {
    const slug = s.lineup?.club.slug;
    const inner = (
      <>
        <Crest src={s.lineup?.club.crest} name={s.name} size={crest} />
        <span class:list={["mt-2 line-clamp-2 text-center leading-tight font-semibold", hero ? "text-[14px]" : "text-[12px]"]}>{s.name}</span>
      </>
    );
    const box = "flex min-w-0 flex-1 flex-col items-center px-1";
    return (
      <>
        {i === 1 && (
          <div class:list={["shrink-0 text-center", hero ? "w-28" : "w-20"]} data-live={f.kickoff && f.awayName ? JSON.stringify({ home: f.homeName, away: f.awayName, kickoff: f.kickoff }) : undefined}>
            {f.kickoff ? (
              <>
                {/* Once the match has started, the script below puts the live score here. */}
                <p data-live-main class:list={["font-bold tracking-tight tabular-nums", hero ? "text-[30px] leading-none" : "text-[17px]"]}>{time(f.kickoff)}</p>
                <p data-live-sub class:list={["text-muted", hero ? "mt-1.5 text-[13px]" : "text-[11px]"]}>{kickoffDay(f.kickoff)}</p>
                {hero && matchday && <p class="text-[13px] text-muted">{matchday}. Spieltag</p>}
                {!hero && score && <p data-live-tip class="mt-0.5 text-[11px] text-muted tabular-nums">Tipp {score.home}:{score.away}</p>}
              </>
            ) : (
              <p class="text-sm text-muted">vs</p>
            )}
          </div>
        )}
        {slug && slug !== current ? (
          <a href={`/vereine/${slug}/`} class:list={["press", box]}>{inner}</a>
        ) : (
          <div class:list={[box, !s.lineup && "opacity-50"]}>{inner}</div>
        )}
      </>
    );
  })}
</div>
{hero && <div data-live-goals class="mt-4 grid grid-cols-2 gap-x-6 px-3 text-[13px] text-muted tabular-nums" hidden></div>}
{chances && (
  <div class:list={["px-3", hero ? "mt-5" : "mt-3"]} aria-label={`Siegchancen laut Wettquoten: ${f.homeName} ${chances.home} %, Unentschieden ${chances.draw} %, ${f.awayName} ${chances.away} %`}>
    <div class="flex h-1.5 gap-0.5 overflow-hidden rounded-full" aria-hidden="true">
      <span class:list={["odds-seg", strong === "home" ? "is-strong" : "is-weak"]} style={`flex:${chances.home}`}></span>
      <span class="odds-seg is-draw" style={`flex:${chances.draw}`}></span>
      <span class:list={["odds-seg", strong === "away" ? "is-strong" : "is-weak"]} style={`flex:${chances.away}`}></span>
    </div>
    <div class:list={["mt-1.5 grid grid-cols-3 tabular-nums text-muted", hero ? "text-[13px]" : "text-[11px]"]} aria-hidden="true">
      <span>{hero && "Sieg "}<b class="font-semibold text-fg">{chances.home} %</b></span>
      <span class="text-center">{hero && "Remis "}{chances.draw} %</span>
      <span class="text-right">{hero && "Sieg "}<b class="font-semibold text-fg">{chances.away} %</b></span>
    </div>
    {hero && score && (
      <p class="mt-3 text-center text-[13px] text-muted">
        Wahrscheinlichstes Ergebnis <b class="font-semibold text-fg tabular-nums">{score.home}:{score.away}</b> ({score.percent} %)
      </p>
    )}
  </div>
)}
</div>

<script>
  import { findLive, LIVE_URL, maybeLive, parseLive, started, type LiveMatch } from "../lib/live.ts";

  // Live scores: fetched only while a match on the page has started, every 30 s while one runs.
  const POLL_MS = 30_000;
  let timer = 0;
  let cache: { at: number; matches: LiveMatch[] } | undefined;

  async function matches(): Promise<LiveMatch[]> {
    if (cache && Date.now() - cache.at < POLL_MS - 5000) return cache.matches;
    const res = await fetch(LIVE_URL, { cache: "no-store" });
    if (!res.ok) throw new Error(`HTTP ${res.status}`);
    cache = { at: Date.now(), matches: parseLive(await res.json()) };
    return cache.matches;
  }

  function show(box: HTMLElement, m: LiveMatch) {
    const main = box.querySelector<HTMLElement>("[data-live-main]")!;
    const sub = box.querySelector<HTMLElement>("[data-live-sub]")!;
    main.textContent = `${m.score[0]}:${m.score[1]}`;
    sub.textContent = m.finished ? "Ende" : "Live";
    sub.style.color = m.finished ? "" : "var(--red-fg)";
    sub.style.fontWeight = m.finished ? "" : "600";
    box.querySelector<HTMLElement>("[data-live-tip]")?.remove();
    const goals = box.closest("[data-fixture]")?.querySelector<HTMLElement>("[data-live-goals]");
    if (!goals) return;
    // Scorers in two columns, home left and away right, in the order they fell.
    let prev = [0, 0];
    const cols = [document.createElement("ol"), document.createElement("ol")];
    cols[1].className = "text-right";
    for (const g of m.goals) {
      const side = g.home > prev[0] ? 0 : 1;
      prev = [g.home, g.away];
      const li = document.createElement("li");
      li.textContent = `${g.minute !== undefined ? `${g.minute}' ` : ""}${g.name}${g.penalty ? " (11m)" : ""}${g.own ? " (ET)" : ""}`;
      cols[side].append(li);
    }
    goals.replaceChildren(...cols);
    goals.hidden = m.goals.length === 0;
  }

  async function refresh() {
    clearTimeout(timer);
    const now = Date.now();
    const boxes = [...document.querySelectorAll<HTMLElement>("[data-live]")].flatMap((box) => {
      try {
        const d = JSON.parse(box.dataset.live!) as { home: string; away: string; kickoff: string };
        return started(d.kickoff, now) ? [{ box, ...d }] : [];
      } catch {
        return [];
      }
    });
    if (boxes.length === 0 || document.visibilityState !== "visible") return;
    let list: LiveMatch[];
    try {
      list = await matches();
    } catch {
      // Unreachable: the card keeps its kickoff time; try again with the next poll.
      list = [];
    }
    let running = false;
    for (const b of boxes) {
      const m = findLive(list, b.home, b.away);
      if (m) show(b.box, m);
      if (maybeLive(b.kickoff, now) && !m?.finished) running = true;
    }
    if (running) timer = window.setTimeout(refresh, POLL_MS);
  }

  document.addEventListener("astro:page-load", refresh);
  document.addEventListener("visibilitychange", () => void refresh());
</script>
