---
/**
 * Comments on our own posts, from our own database via /api/own-comments/<id>/. They look and work like
 * LigaInsider's (Comments.astro; both draw with lib/commentUi.ts), without a login: everyone writes under a name
 * of their choice (remembered in this browser) and votes once per comment or poll.
 */
import { NAME_MAX, TEXT_MAX } from "../lib/ownComments.ts";
import { QUESTION_MAX } from "../lib/ownVotes.ts";
import { FIELD } from "../lib/commentUi.ts";
import CommentComposer from "./CommentComposer.astro";
import CommentsSkeleton from "./CommentsSkeleton.astro";

interface Props { postId: number }
const { postId } = Astro.props;
---
<section class="mt-10" data-own-comments={postId}>
  <h2 class="mb-4 flex items-baseline gap-2 text-[20px] font-bold tracking-[-0.02em]">
    Kommentare <span class="text-[15px] font-semibold text-muted" data-own-count></span>
  </h2>

  <CommentComposer textMax={TEXT_MAX} questionMax={QUESTION_MAX} class="mb-6">
    <input slot="before" data-own-name maxlength={NAME_MAX} placeholder="Dein Name" autocomplete="nickname" class={FIELD} />
    <p data-own-error class="min-h-5 text-sm" style="color:var(--red-fg)"></p>
  </CommentComposer>

  <CommentsSkeleton />
  <p data-own-status class="hidden text-sm text-muted"></p>
  <ul class="flex flex-col" data-comment-list></ul>
</section>

<script>
  import type { OwnComment } from "../lib/ownComments.ts";
  import type { PollView } from "../lib/ownVotes.ts";
  import { NAME_MAX, TEXT_MAX } from "../lib/ownComments.ts";
  import { ANSWER_MAX } from "../lib/ownVotes.ts";
  import { FIELD, h, pollOf, renderComment, renderPoll, revealIn, setVote, settle, showResults, swapPoll, voteButton, withVote, wireComposer, type PollOpts, type RenderOpts } from "../lib/commentUi.ts";

  const NAME_KEY = "commentName";
  const savedName = () => { try { return localStorage.getItem(NAME_KEY) ?? ""; } catch { return ""; } };
  const saveName = (n: string) => { try { localStorage.setItem(NAME_KEY, n); } catch {} };

  const apiBase = (section: HTMLElement) => `/api/own-comments/${section.dataset.ownComments}/`;
  async function call<T>(url: string, body: unknown): Promise<T> {
    const res = await fetch(url, { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(body) });
    const data = (await res.json().catch(() => ({}))) as T & { error?: string };
    if (!res.ok && res.status !== 409) throw new Error(data.error || "Hat nicht geklappt.");
    return data;
  }

  // Anyone can vote here; a preview (no id yet) can't.
  const pollOpts = (commentId: number): PollOpts => ({ key: commentId, canVote: commentId > 0 });
  const view: RenderOpts<OwnComment> = {
    vote: (c) => voteButton(c.id, c.voted ? 1 : 0, c.score),
    poll: (c) => renderPoll(c.poll!, pollOpts(c.id)),
    canReply: (_, reply) => !reply,
  };
  const render = (c: OwnComment, now: Date, reply = false, pending = false) => renderComment(c, now, { ...view, reply, pending });

  function setCount(section: HTMLElement, n: number) {
    section.dataset.n = String(n);
    section.querySelector("[data-own-count]")!.textContent = n ? String(n) : "";
  }

  async function load(section: HTMLElement) {
    const list = section.querySelector<HTMLElement>("[data-comment-list]")!;
    const status = section.querySelector<HTMLElement>("[data-own-status]")!;
    try {
      const res = await fetch(apiBase(section));
      if (!res.ok) throw new Error();
      const data = (await res.json()) as { total: number; comments: OwnComment[] };
      const now = new Date();
      list.replaceChildren(...data.comments.map((c) => render(c, now)));
      setCount(section, data.total);
      status.classList.toggle("hidden", data.total > 0);
      status.textContent = "Noch keine Kommentare. Schreib den ersten!";
    } catch {
      status.classList.remove("hidden");
      status.textContent = "Kommentare konnten nicht geladen werden.";
    } finally {
      section.querySelector("[data-skeleton]")?.remove();
    }
  }

  type Draft = { name: string; text: string; parent?: number; poll?: { question: string; options: string[] } };

  /** Sends a comment or poll; shows it at once (faded), then turns it into the saved one in place, or takes it back. */
  async function send(section: HTMLElement, d: Draft, target: HTMLElement, error: HTMLElement) {
    const now = new Date();
    const preview: OwnComment = {
      id: 0, user: d.name, date: now.toISOString(), text: d.poll?.question ?? d.text, replies: [], score: 0, voted: false,
      ...(d.poll ? { poll: { question: d.poll.question, total: 0, options: d.poll.options.map((label, i) => ({ id: -i - 1, label, pct: 0 })) } } : {}),
    };
    const pending = render(preview, now, !!d.parent, true);
    if (d.parent) { target.hidden = false; target.append(pending); } else target.prepend(pending);
    revealIn(pending);
    section.querySelector("[data-own-status]")?.classList.add("hidden");
    try {
      const data = await call<{ comment?: OwnComment }>(apiBase(section), d);
      if (!data.comment) throw new Error("Konnte nicht gesendet werden.");
      settle(pending, render(data.comment, new Date(), !!d.parent));
      setCount(section, Number(section.dataset.n ?? 0) + 1);
      return true;
    } catch (err) {
      pending.remove();
      if (d.parent) target.hidden = !target.children.length;
      error.textContent = (err as Error).message;
      return false;
    }
  }

  function replyForm(section: HTMLElement, li: HTMLElement, parent: number) {
    li.querySelector("[data-own-reply-form]")?.remove();
    const form = h("form", "mt-2 flex flex-col gap-2");
    form.dataset.ownReplyForm = "";
    const name = h("input", FIELD);
    name.maxLength = NAME_MAX;
    name.placeholder = "Dein Name";
    name.value = savedName();
    const text = h("textarea", FIELD);
    text.rows = 2;
    text.maxLength = TEXT_MAX;
    text.placeholder = "Antworten …";
    const row = h("div", "flex items-center gap-3");
    const error = h("p", "min-w-0 flex-1 text-sm");
    error.style.color = "var(--red-fg)";
    const submit = h("button", "press rounded-full bg-fg px-4 py-2 text-sm font-semibold text-bg", "Senden");
    submit.type = "submit";
    row.append(error, submit);
    form.append(name, text, row);
    const replies = li.querySelector<HTMLElement>(":scope > [data-replies]")!;
    replies.before(form);
    revealIn(form);
    (name.value ? text : name).focus();
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      error.textContent = "";
      const n = name.value.trim();
      const t = text.value.trim();
      if (n.length < 2) return void (error.textContent = "Gib einen Namen ein.");
      if (!t) return void (error.textContent = "Schreib etwas.");
      saveName(n);
      form.hidden = true;
      if (await send(section, { name: n, text: t, parent }, replies, error)) form.remove();
      else form.hidden = false;
    });
  }

  document.addEventListener("astro:page-load", () => {
    const section = document.querySelector<HTMLElement>("[data-own-comments]");
    if (!section || section.dataset.ready) return;
    section.dataset.ready = "1";
    const form = section.querySelector<HTMLFormElement>("[data-composer]")!;
    const name = form.querySelector<HTMLInputElement>("[data-own-name]")!;
    const error = form.querySelector<HTMLElement>("[data-own-error]")!;
    const composer = wireComposer(form, { answerMax: ANSWER_MAX });
    name.value = savedName();
    void load(section);

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      error.textContent = "";
      const n = name.value.trim();
      if (n.length < 2) return void (error.textContent = "Gib einen Namen ein.");
      saveName(n);
      const list = section.querySelector<HTMLElement>("[data-comment-list]")!;
      const d = composer.read();
      let draft: Draft;
      if (composer.polling()) {
        const q = d.question.trim();
        const answers = d.answers.map((a) => a.trim()).filter(Boolean);
        if (q.length < 3) return void (error.textContent = "Schreib eine Frage.");
        if (answers.length < 2) return void (error.textContent = "Mindestens zwei Antworten.");
        draft = { name: n, text: "", poll: { question: q, options: answers } };
      } else {
        const t = d.text.trim();
        if (!t) return void (error.textContent = "Schreib etwas.");
        draft = { name: n, text: t };
      }
      composer.clear();
      if (!(await send(section, draft, list, error))) composer.restore(d);
    });

    section.addEventListener("click", async (e) => {
      const target = e.target instanceof Element ? e.target : null;
      const replyBtn = target?.closest<HTMLElement>("[data-reply]");
      const up = target?.closest<HTMLButtonElement>("[data-up]");
      const option = target?.closest<HTMLButtonElement>("[data-option]");
      if (replyBtn) return replyForm(section, replyBtn.closest("li")!, Number(replyBtn.dataset.reply));
      if (up) {
        // One request at a time per comment; taps meanwhile are ignored.
        if (up.dataset.busy) return;
        up.dataset.busy = "1";
        const voted = up.dataset.vote === "1";
        const score = Number(up.dataset.score);
        setVote(up, !voted, score + (voted ? -1 : 1));
        try {
          const r = await call<{ score: number; voted: boolean }>(`${apiBase(section)}vote/`, { comment: Number(up.dataset.up), on: !voted });
          setVote(up, r.voted, r.score);
        } catch {
          setVote(up, voted, score);
        } finally {
          delete up.dataset.busy;
        }
      } else if (option) {
        const box = option.closest<HTMLElement>(".poll")!;
        const before = pollOf(box) as PollView;
        const optionId = Number(option.dataset.option);
        const commentId = Number(box.dataset.poll);
        const after = swapPoll(box, withVote(before, optionId), pollOpts(commentId));
        try {
          // A repeat vote (409) answers with the poll as it stands, the earlier choice ticked.
          const r = await call<{ poll?: PollView }>(`${apiBase(section)}poll-vote/`, { comment: commentId, option: optionId });
          if (r.poll?.mine === optionId) showResults(after, r.poll);
          else if (r.poll) swapPoll(after, r.poll, pollOpts(commentId));
        } catch {
          swapPoll(after, before, pollOpts(commentId));
        }
      }
    });
  });
</script>
