---
import Avatar from "./Avatar.astro";

interface Props { src?: string; name: string; size?: number }
const { src, name, size = 32 } = Astro.props;
---
{/* Club logos are shown as they are: no circle, background or padding (some crests have real corners). */}
{src ? (
  <img src={src} alt={name} loading="lazy" decoding="async" class="shrink-0 object-contain" style={`width:${size}px;height:${size}px`} />
) : (
  <Avatar name={name} size={size} />
)}
