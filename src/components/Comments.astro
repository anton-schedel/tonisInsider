---
interface Props { articleId: number; url: string }
const { articleId, url } = Astro.props;
const field = "w-full rounded-xl bg-surface px-4 py-3 text-[16px] outline-none focus:ring-2 focus:ring-[var(--accent)]";
---
<!-- Loaded live from LigaInsider (via /api/comments/<id>/). Logged-in reads are personal and uncached. -->
<section class="mt-10" data-comments={articleId}>
  <h2 class="mb-4 flex items-baseline gap-2 text-[20px] font-bold tracking-[-0.02em]">
    Kommentare <span class="text-[15px] font-semibold text-muted" data-comments-count></span>
  </h2>

  <div data-li-box class="mb-6 hidden">
    <form data-li-form class="flex flex-col gap-2">
      <textarea data-li-body rows="3" maxlength="2000" placeholder="Was sagst du dazu?" class={field}></textarea>
      <div data-li-poll class="hidden flex flex-col gap-2">
        <input data-li-question maxlength="200" placeholder="Frage der Umfrage…" class={field} />
        <div data-li-options class="flex flex-col gap-2"></div>
        <button type="button" data-li-add class="self-start text-sm font-medium text-accent">Weitere Antwort</button>
      </div>
      <div class="flex items-center gap-2">
        <button type="button" data-li-mode="text" class="press rounded-full bg-fg px-3 py-1.5 text-[13px] font-semibold text-bg">Kommentar</button>
        <button type="button" data-li-mode="poll" class="press rounded-full bg-surface px-3 py-1.5 text-[13px] font-semibold">Umfrage</button>
        <span class="flex-1"></span>
        <button type="submit" class="press rounded-full bg-fg px-4 py-2 text-sm font-semibold text-bg">Senden</button>
      </div>
    </form>
    <form method="post" action="/api/li-logout/" class="mt-2" data-astro-reload>
      <input type="hidden" name="next" value="/" data-li-next />
      <button type="submit" class="text-xs text-muted">LigaInsider abmelden</button>
    </form>
  </div>
  <p data-li-guest class="mb-6 hidden text-sm text-muted">
    <a data-li-login href="/einstellungen/#ligainsider" class="font-medium text-accent">Mit LigaInsider anmelden</a>, um zu kommentieren, zu antworten und abzustimmen.
  </p>

  <p class="text-sm text-muted" data-comments-status>Kommentare werden geladen …</p>
  <ul class="flex flex-col" data-comments-list></ul>
  <a
    href={url}
    target="_blank"
    rel="noopener noreferrer"
    class="mt-4 hidden text-sm text-accent"
    data-comments-more
  >Alle Kommentare auf ligainsider.de ↗</a>
</section>

<script>
  import type { Comment, Comments, Poll } from "../lib/comments.ts";
  import { ago, initials } from "../lib/format.ts";

  const field = "w-full rounded-xl bg-surface px-4 py-3 text-[16px] outline-none focus:ring-2 focus:ring-[var(--accent)]";

  // Builds DOM with textContent only: comment text is untrusted and never parsed as HTML.
  function h(tag: string, cls = "", text?: string) {
    const el = document.createElement(tag);
    if (cls) el.className = cls;
    if (text !== undefined) el.textContent = text;
    return el;
  }

  function loggedIn() {
    return /(?:^|; )liin=1/.test(document.cookie);
  }

  function voteControl(c: Comment): HTMLElement {
    const mine = c.vote === 1;
    // The up-vote count is always visible, voted or not, logged in or not.
    const label = c.score ? String(c.score) : "";
    if (!loggedIn()) {
      const link = h("a", "vote-btn press");
      link.append(h("span", "vote-chevron", "▲"), h("span", "vote-count", label));
      link.setAttribute("href", `/einstellungen/?next=${encodeURIComponent(location.pathname)}#ligainsider`);
      link.setAttribute("aria-label", "Zum Hochvoten anmelden");
      return link;
    }
    const up = h("button", `vote-btn press${mine ? " is-on" : ""}`);
    up.setAttribute("type", "button");
    up.dataset.up = String(c.id);
    up.dataset.vote = String(c.vote);
    up.dataset.score = String(c.score);
    up.setAttribute("aria-pressed", String(mine));
    up.setAttribute("aria-label", mine ? "Deine Stimme" : "Hochvoten");
    up.append(h("span", "vote-chevron", "▲"), h("span", "vote-count", label));
    return up;
  }

  function renderComment(c: Comment, now: Date, reply = false, pending = false): HTMLElement {
    const li = h("li", reply ? "comment comment-reply" : "comment");
    if (pending) li.classList.add("is-pending");
    const row = h("div", "flex items-start gap-2");
    const main = h("div", "min-w-0 flex-1");
    const head = h("div", "flex items-center gap-2.5");
    const size = reply ? "size-7 text-[10px]" : "size-8 text-[11px]";
    head.append(
      h("span", `flex ${size} shrink-0 items-center justify-center rounded-full bg-surface font-semibold text-muted`, initials(c.user) || "?"),
      h("b", "min-w-0 truncate text-[14px] font-semibold", c.user),
      h("span", "shrink-0 text-xs text-muted", pending ? "Wird gesendet …" : c.date ? ago(c.date, now) : ""),
    );
    main.append(head);
    if (c.text) main.append(h("p", "mt-1 text-[15px] leading-[1.45] whitespace-pre-line break-words", c.text));
    if (c.poll) main.append(renderPoll(c.poll));
    if (loggedIn() && c.id && !pending) {
      const replyBtn = h("button", "mt-1 text-xs font-medium text-muted", "Antworten");
      replyBtn.type = "button";
      replyBtn.dataset.reply = String(c.id);
      main.append(replyBtn);
    }
    row.append(main);
    if (c.id) row.append(voteControl(c));
    li.append(row);

    if (c.replies.length) {
      const ul = h("ul", "mt-3 flex flex-col gap-3 border-l-2 border-hairline pl-3 ml-[15px]");
      for (const r of c.replies) ul.append(renderComment(r, now, true));
      li.append(ul);
    }
    return li;
  }

  const polls = new WeakMap<HTMLElement, Poll>();

  function renderPoll(poll: Poll, mine?: number): HTMLElement {
    // Results are always shown (like the rest of the comments). Note: Tailwind only sees whole class
    // words, so classes must not touch a ${…} placeholder.
    const box = h("div", "poll mt-2 rounded-xl bg-surface p-3");
    polls.set(box, poll);
    box.append(h("p", "mb-2 text-[14px] font-semibold", poll.question));
    const voted = poll.voted;
    const best = Math.max(...poll.options.map((o) => o.pct));
    for (const o of poll.options) {
      const canVote = !voted && loggedIn() && poll.votingId && o.id;
      const row = h(voted ? "div" : canVote ? "button" : "a", "poll-choice relative mb-1.5 w-full overflow-hidden rounded-xl px-3 py-3 text-left text-[15px]");
      if (!voted && !canVote) {
        row.classList.add("press");
        row.setAttribute("href", `/einstellungen/?next=${encodeURIComponent(location.pathname)}#ligainsider`);
      }
      if (row instanceof HTMLButtonElement) {
        row.type = "button";
        row.classList.add("press");
        row.dataset.voting = String(poll.votingId);
        row.dataset.option = String(o.id);
      }
      const fill = h("span", "poll-fill absolute inset-y-0 left-0");
      fill.dataset.pct = String(o.pct);
      fill.style.width = `${o.pct}%`;
      if (o.pct === best && o.pct > 0) fill.classList.add("is-best");
      const label = h("span", "relative", o.label);
      if (mine !== undefined && o.id === mine) {
        row.classList.add("is-mine");
        label.append(h("span", "poll-check", " ✓"));
      }
      row.append(fill, label, h("span", "poll-pct relative float-right font-semibold tabular-nums", `${o.pct}%`));
      box.append(row);
    }
    box.append(h("p", "poll-total mt-1 text-xs text-muted", `${poll.total} Stimmen`));
    return box;
  }

  function sectionOf() {
    return document.querySelector<HTMLElement>("[data-comments]");
  }

  async function post(payload: Record<string, unknown>) {
    const section = sectionOf();
    const res = await fetch("/api/li-comment/", {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify({ articleId: Number(section?.dataset.comments), ...payload }),
    });
    const data = (await res.json().catch(() => ({}))) as { error?: string };
    if (!res.ok) throw new Error(data.error || "Konnte nicht gesendet werden.");
  }

  // Short message above the tab bar, so it's seen wherever on the page the tap was.
  let toastTimer = 0;
  function toast(err: unknown) {
    let el = document.querySelector<HTMLElement>("[data-toast]");
    if (!el) {
      el = h("div", "toast");
      el.dataset.toast = "";
      el.setAttribute("role", "status");
      document.body.append(el);
    }
    el.textContent = err instanceof Error ? err.message : "Konnte nicht gesendet werden.";
    el.classList.add("is-on");
    clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => el!.classList.remove("is-on"), 3500);
  }

  // Changes show at once; the request runs in the background and a failure undoes the change.
  function setVote(btn: HTMLElement, vote: number, score: number) {
    btn.dataset.vote = String(vote);
    btn.dataset.score = String(score);
    btn.classList.toggle("is-on", vote === 1);
    btn.setAttribute("aria-pressed", String(vote === 1));
    btn.setAttribute("aria-label", vote === 1 ? "Deine Stimme" : "Hochvoten");
    btn.querySelector(".vote-count")!.textContent = score ? String(score) : "";
  }

  function withVote(poll: Poll, optionId: number): Poll {
    const counts = poll.options.map((o) => Math.round((o.pct * poll.total) / 100) + (o.id === optionId ? 1 : 0));
    const total = poll.total + 1;
    // Whole percentages that add up to 100 (largest remainders get the leftover points).
    const exact = counts.map((n) => (n / total) * 100);
    const pct = exact.map(Math.floor);
    const order = exact.map((x, i) => i).sort((i, j) => (exact[j] - pct[j]) - (exact[i] - pct[i]));
    const left = 100 - pct.reduce((s, x) => s + x, 0);
    for (let k = 0; k < left; k++) pct[order[k % order.length]]++;
    return { ...poll, voted: true, total, options: poll.options.map((o, i) => ({ ...o, pct: pct[i] })) };
  }

  function myName() {
    const raw = document.cookie.split("; ").find((p) => p.startsWith("lin="))?.slice(4) ?? "";
    try { return decodeURIComponent(raw) || "Du"; } catch { return raw || "Du"; }
  }

  function pendingComment(text: string): Comment {
    return { id: 0, user: myName(), date: new Date().toISOString(), text, score: 0, vote: 0, replies: [] };
  }

  async function load() {
    const section = sectionOf();
    if (!section) return;
    const status = section.querySelector<HTMLElement>("[data-comments-status]");
    const list = section.querySelector<HTMLElement>("[data-comments-list]")!;
    const more = section.querySelector<HTMLElement>("[data-comments-more]")!;
    try {
      const res = await fetch(`/api/comments/${section.dataset.comments}/`);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = (await res.json()) as Comments;
      const now = new Date();
      section.querySelector("[data-comments-count]")!.textContent = data.total ? String(data.total) : "";
      list.replaceChildren();
      if (!data.comments.length) {
        if (status) status.textContent = "Noch keine Kommentare.";
        status?.classList.remove("hidden");
        return;
      }
      status?.remove();
      for (const c of data.comments) list.append(renderComment(c, now));
      const count = (cs: Comment[]): number => cs.reduce((n, c) => n + 1 + count(c.replies), 0);
      const shown = count(data.comments);
      if (data.total > shown) {
        more.textContent = `Alle ${data.total} Kommentare auf ligainsider.de ↗`;
        more.classList.remove("hidden");
        more.classList.add("inline-block");
      } else {
        more.classList.add("hidden");
      }
    } catch {
      if (status) {
        status.textContent = "Kommentare gerade nicht erreichbar.";
        status.classList.remove("hidden");
      }
      more.classList.remove("hidden");
      more.classList.add("inline-block");
    }
  }

  function optionInput(value = "") {
    const input = h("input", field) as HTMLInputElement;
    input.maxLength = 80;
    input.placeholder = "Antwort…";
    input.value = value;
    input.dataset.liOption = "";
    return input;
  }

  function setup(section: HTMLElement) {
    const here = `${location.pathname}${location.search}`;
    section.querySelectorAll<HTMLInputElement>("[data-li-next]").forEach((input) => { input.value = here; });
    const login = section.querySelector<HTMLAnchorElement>("[data-li-login]");
    if (login) login.href = `/einstellungen/?next=${encodeURIComponent(location.pathname)}#ligainsider`;
    const box = section.querySelector<HTMLElement>("[data-li-box]")!;
    const guest = section.querySelector<HTMLElement>("[data-li-guest]")!;
    if (loggedIn()) box.classList.remove("hidden");
    else guest.classList.remove("hidden");

    const poll = section.querySelector<HTMLElement>("[data-li-poll]")!;
    const options = section.querySelector<HTMLElement>("[data-li-options]")!;
    const body = section.querySelector<HTMLTextAreaElement>("[data-li-body]")!;
    options.append(optionInput(), optionInput());

    section.querySelectorAll<HTMLButtonElement>("[data-li-mode]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const on = btn.dataset.liMode === "poll";
        poll.classList.toggle("hidden", !on);
        body.classList.toggle("hidden", on);
        section.querySelectorAll<HTMLButtonElement>("[data-li-mode]").forEach((b) => {
          const active = b === btn;
          b.classList.toggle("bg-fg", active);
          b.classList.toggle("text-bg", active);
          b.classList.toggle("bg-surface", !active);
        });
      });
    });
    section.querySelector<HTMLButtonElement>("[data-li-add]")!.addEventListener("click", () => {
      if (options.children.length >= 6) return;
      options.append(optionInput());
    });

    const form = section.querySelector<HTMLFormElement>("[data-li-form]")!;
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const list = section.querySelector<HTMLElement>("[data-comments-list]")!;
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (submit.disabled) return;
      const polling = !poll.classList.contains("hidden");
      const questionInput = section.querySelector<HTMLInputElement>("[data-li-question]")!;
      const question = questionInput.value;
      const labels = [...options.querySelectorAll<HTMLInputElement>("[data-li-option]")].map((i) => i.value);
      const text = body.value;
      if (polling ? !question.trim() : !text.trim()) return;
      // Shown at once (greyed out), the form is cleared; a failure puts everything back.
      const draft = pendingComment(polling ? "" : text);
      if (polling) draft.poll = { question, total: 0, voted: true, options: labels.filter((l) => l.trim()).map((label) => ({ label, pct: 0 })) };
      const shown = renderComment(draft, new Date(), false, true);
      list.prepend(shown);
      section.querySelector("[data-comments-status]")?.classList.add("hidden");
      body.value = "";
      questionInput.value = "";
      options.replaceChildren(optionInput(), optionInput());
      submit.disabled = true;
      try {
        await post(polling ? { kind: "poll", question, options: labels } : { kind: "comment", body: text });
        await load();
      } catch (err) {
        shown.remove();
        body.value = text;
        questionInput.value = question;
        options.replaceChildren(...labels.map((l) => optionInput(l)));
        toast(err);
      } finally {
        submit.disabled = false;
      }
    });

    section.querySelector<HTMLElement>("[data-comments-list]")!.addEventListener("click", async (e) => {
      const target = e.target instanceof Element ? e.target : null;
      const up = target?.closest<HTMLButtonElement>("[data-up]");
      const replyBtn = target?.closest<HTMLButtonElement>("[data-reply]");
      const option = target?.closest<HTMLButtonElement>("[data-option]");
      if (up) {
        // One request at a time per comment; taps meanwhile are ignored.
        if (up.dataset.busy) return;
        up.dataset.busy = "1";
        const vote = Number(up.dataset.vote);
        const score = Number(up.dataset.score);
        const next = vote === 1 ? 0 : 1;
        setVote(up, next, score + next - vote);
        try { await post({ kind: "vote", commentId: Number(up.dataset.up), currentVote: vote }); }
        catch (err) { setVote(up, vote, score); toast(err); }
        finally { delete up.dataset.busy; }
      } else if (option) {
        const box = option.closest<HTMLElement>(".poll")!;
        const before = polls.get(box)!;
        const optionId = Number(option.dataset.option);
        const after = renderPoll(withVote(before, optionId), optionId);
        box.replaceWith(after);
        try { await post({ kind: "pollvote", votingId: Number(option.dataset.voting), optionId }); }
        catch (err) { after.replaceWith(renderPoll(before)); toast(err); }
      } else if (replyBtn && !replyBtn.nextElementSibling?.matches("[data-reply-row]")) {
        const row = h("form", "mt-2 flex gap-2");
        row.dataset.replyRow = "";
        const input = h("input", field) as HTMLInputElement;
        input.maxLength = 2000;
        input.placeholder = "Antwort…";
        const go = h("button", "press shrink-0 rounded-full bg-fg px-3 text-sm font-semibold text-bg", "Senden");
        go.type = "submit";
        row.append(input, go);
        replyBtn.after(row);
        row.addEventListener("submit", async (ev) => {
          ev.preventDefault();
          const text = input.value;
          if (go.disabled || !text.trim()) return;
          // The reply shows at once under its comment; the box closes and comes back on failure.
          const li = replyBtn.closest<HTMLElement>("li")!;
          let replies = li.querySelector<HTMLElement>(":scope > ul");
          if (!replies) {
            replies = h("ul", "mt-3 flex flex-col gap-3 border-l-2 border-hairline pl-3 ml-[15px]");
            li.append(replies);
          }
          const shown = renderComment(pendingComment(text), new Date(), true, true);
          replies.append(shown);
          row.remove();
          try {
            await post({ kind: "reply", commentId: Number(replyBtn.dataset.reply), body: text });
            await load();
          } catch (err) {
            shown.remove();
            replyBtn.after(row);
            input.value = text;
            toast(err);
          }
        });
        input.focus();
      }
    });
  }

  function boot() {
    const section = sectionOf();
    if (!section || section.dataset.ready) return;
    section.dataset.ready = "1";
    setup(section);
    void load();
  }

  document.addEventListener("astro:page-load", boot);
</script>
