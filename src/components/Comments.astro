---
import { threadKey, type Thread } from "../lib/comments.ts";
import CommentComposer from "./CommentComposer.astro";
import CommentsSkeleton from "./CommentsSkeleton.astro";

/** thread: the article id, or a club's lineup page (its match and team); url: the same page on LigaInsider. */
interface Props { thread: Thread; url: string }
const { thread, url } = Astro.props;
---
<!-- Loaded live from LigaInsider (via /api/comments/<thread key>/). Logged-in reads are personal and uncached. -->
<section class="mt-10" data-comments={threadKey(thread)} data-li-page={url}>
  <h2 class="mb-4 flex items-baseline gap-2 text-[20px] font-bold tracking-[-0.02em]">
    Kommentare <span class="text-[15px] font-semibold text-muted" data-comments-count></span>
  </h2>

  <div data-li-box class="mb-6 hidden">
    <CommentComposer textMax={2000} questionMax={200} />
    <form method="post" action="/api/li-logout/" class="mt-2" data-astro-reload>
      <input type="hidden" name="next" value="/" data-li-next />
      <button type="submit" class="press text-xs text-muted">LigaInsider abmelden</button>
    </form>
  </div>
  <p data-li-guest class="mb-6 hidden text-sm text-muted">
    <a data-li-login href="/einstellungen/#ligainsider" class="press inline-block font-medium text-accent">Mit LigaInsider anmelden</a>, um zu kommentieren, zu antworten und abzustimmen.
  </p>

  <p class="hidden text-sm text-muted" data-comments-status></p>
  <p class="mb-3 hidden text-xs text-muted" data-comments-stale>LigaInsider antwortet gerade nicht. Das ist der zuletzt geladene Stand.</p>
  <p class="hidden pb-2 text-xs text-muted" data-comments-slow>LigaInsider antwortet gerade langsam …</p>
  <CommentsSkeleton />
  <ul class="flex flex-col" data-comment-list></ul>
  {/* Loads LigaInsider's next batch into the list (script below); hidden after the last one. */}
  <button type="button" class="press mt-3 hidden w-full rounded-xl bg-surface py-3 text-[15px] font-semibold" data-comments-load>Weitere Kommentare laden</button>
  <a
    href={url}
    target="_blank"
    rel="noopener noreferrer"
    class="press mt-4 hidden text-sm text-accent"
    data-comments-more
  >Alle Kommentare auf ligainsider.de ↗</a>
</section>

<script>
  import type { Comment, Comments, MoreCursor, Poll } from "../lib/comments.ts";
  import { FIELD, h, pollOf, renderComment, renderPoll, revealIn, setVote, settle, swapPoll, voteButton, withVote, wireComposer, type PollOpts, type RenderOpts } from "../lib/commentUi.ts";

  function loggedIn() {
    return /(?:^|; )liin=1/.test(document.cookie);
  }
  const loginHref = () => `/einstellungen/?next=${encodeURIComponent(location.pathname)}#ligainsider`;

  // The up-vote count is always visible; logged out, the ▲ leads to the login.
  function voteControl(c: Comment): HTMLElement {
    if (loggedIn()) return voteButton(c.id, c.vote, c.score);
    const link = h("a", "vote-btn press");
    link.append(h("span", "vote-chevron", "▲"), h("span", "vote-count", c.score ? String(c.score) : ""));
    link.href = loginHref();
    link.setAttribute("aria-label", "Zum Hochvoten anmelden");
    return link;
  }

  // LigaInsider only says whether you voted, not for what: the choice is remembered in this browser.
  const VOTES_KEY = "pollVotes";
  const MAX_VOTES = 300;
  function myVotes(): Record<string, number> {
    try { return JSON.parse(localStorage.getItem(VOTES_KEY) || "{}") as Record<string, number>; } catch { return {}; }
  }
  function rememberVote(votingId: number, optionId: number) {
    try {
      const votes = myVotes();
      votes[votingId] = optionId;
      // Integer keys iterate in ascending order: the oldest polls go first.
      const keys = Object.keys(votes);
      for (const k of keys.slice(0, Math.max(0, keys.length - MAX_VOTES))) delete votes[k];
      localStorage.setItem(VOTES_KEY, JSON.stringify(votes));
    } catch {}
  }

  const pollOpts = (p: Poll): PollOpts => ({ key: p.votingId, canVote: loggedIn() && !!p.votingId, loginHref: loginHref() });
  const view: RenderOpts<Comment> = {
    vote: voteControl,
    poll: (c) => renderPoll({ ...c.poll!, mine: c.poll!.votingId ? myVotes()[c.poll!.votingId] : undefined }, pollOpts(c.poll!)),
    canReply: loggedIn,
  };
  const render = (c: Comment, now: Date, reply = false, pending = false) => renderComment(c, now, { ...view, reply, pending });

  function sectionOf() {
    return document.querySelector<HTMLElement>("[data-comments]");
  }

  async function post(payload: Record<string, unknown>): Promise<{ commentId?: number }> {
    const section = sectionOf();
    const res = await fetch("/api/li-comment/", {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify({ thread: section?.dataset.comments, page: section?.dataset.liPage, ...payload }),
    });
    const data = (await res.json().catch(() => ({}))) as { error?: string; commentId?: number };
    if (!res.ok) throw new Error(data.error || "Konnte nicht gesendet werden.");
    window.posthog?.capture("ligainsider_interaction_completed", { action_kind: String(payload.kind) });
    return data;
  }

  // Short message above the tab bar, so it's seen wherever on the page the tap was.
  let toastTimer = 0;
  function toast(err: unknown) {
    let el = document.querySelector<HTMLElement>("[data-toast]");
    if (!el) {
      el = h("div", "toast");
      el.dataset.toast = "";
      el.setAttribute("role", "status");
      document.body.append(el);
    }
    el.textContent = err instanceof Error ? err.message : "Konnte nicht gesendet werden.";
    el.classList.add("is-on");
    clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => el!.classList.remove("is-on"), 3500);
  }

  function myName() {
    let s = document.cookie.split("; ").find((p) => p.startsWith("lin="))?.slice(4) ?? "";
    // Names from older logins were encoded twice.
    for (let i = 0; i < 2 && /%[0-9a-f]{2}/i.test(s); i++) { try { s = decodeURIComponent(s); } catch { break; } }
    return s.trim() || "Du";
  }

  function pendingComment(text: string): Comment {
    return { id: 0, user: myName(), date: new Date().toISOString(), text, score: 0, vote: 0, replies: [] };
  }

  const countAll = (cs: Comment[]): number => cs.reduce((n, c) => n + 1 + countAll(c.replies), 0);
  // The thread on this page: what's shown and where LigaInsider's next batch starts.
  let thread: { total: number; shown: Set<number>; count: number; more?: MoreCursor } | undefined;

  /** A sent comment or reply stays where it is (no reload, loaded batches stay), now counted. */
  function sent(section: HTMLElement, shown: HTMLElement, draft: Comment, id: number | undefined, reply: boolean) {
    settle(shown, render({ ...draft, id: id ?? 0, date: new Date().toISOString() }, new Date(), reply));
    thread ??= { total: 0, shown: new Set(), count: 0 };
    if (id && !reply) thread.shown.add(id);
    thread.total++;
    thread.count++;
    section.querySelector("[data-comments-count]")!.textContent = String(thread.total);
  }

  function showLoadMore(section: HTMLElement) {
    const btn = section.querySelector<HTMLButtonElement>("[data-comments-load]");
    if (!btn) return;
    const left = thread ? thread.total - thread.count : 0;
    btn.classList.toggle("hidden", !thread?.more);
    btn.textContent = left > 0 ? `Weitere Kommentare laden (${left})` : "Weitere Kommentare laden";
  }

  async function loadMore(section: HTMLElement, btn: HTMLButtonElement) {
    if (!thread?.more || btn.classList.contains("is-busy")) return;
    const from = thread.more;
    btn.classList.add("is-busy");
    btn.setAttribute("aria-busy", "true");
    try {
      const q = new URLSearchParams({ offset: String(from.offset), goffset: String(from.goffset), moffset: String(from.moffset), cursor: String(from.cursor) });
      const res = await fetch(`/api/comments/${section.dataset.comments}/more/?${q}`);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = (await res.json()) as Comments;
      const list = section.querySelector<HTMLElement>("[data-comment-list]")!;
      const now = new Date();
      // Batches can overlap by a comment; each shows once.
      const fresh = data.comments.filter((c) => !thread!.shown.has(c.id));
      for (const c of fresh) {
        thread.shown.add(c.id);
        const li = render(c, now);
        list.append(li);
        revealIn(li);
      }
      thread.count += countAll(fresh);
      // An empty batch or the same cursor again means the end.
      thread.more = fresh.length && data.more && data.more.cursor !== from.cursor ? data.more : undefined;
    } catch {
      toast(new Error("Weitere Kommentare gerade nicht erreichbar."));
    } finally {
      btn.classList.remove("is-busy");
      btn.removeAttribute("aria-busy");
      showLoadMore(section);
    }
  }

  async function load() {
    const section = sectionOf();
    if (!section) return;
    const status = section.querySelector<HTMLElement>("[data-comments-status]");
    const list = section.querySelector<HTMLElement>("[data-comment-list]")!;
    const more = section.querySelector<HTMLElement>("[data-comments-more]")!;
    const skeleton = section.querySelector("[data-skeleton]");
    const slowNote = section.querySelector("[data-comments-slow]");
    // LigaInsider is sometimes very slow; say so instead of leaving only the placeholder.
    const slow = setTimeout(() => slowNote?.classList.remove("hidden"), 4000);
    const get = async () => {
      const res = await fetch(`/api/comments/${section.dataset.comments}/`);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      return res;
    };
    try {
      let res: Response;
      try {
        res = await get();
      } catch {
        // One quiet second try: LigaInsider often answers the next request right away.
        await new Promise((r) => setTimeout(r, 800));
        res = await get();
      }
      section.querySelector("[data-comments-stale]")?.classList.toggle("hidden", res.headers.get("x-stale") !== "1");
      const data = (await res.json()) as Comments;
      skeleton?.remove();
      const now = new Date();
      section.querySelector("[data-comments-count]")!.textContent = data.total ? String(data.total) : "";
      list.replaceChildren();
      if (!data.comments.length) {
        if (status) status.textContent = "Noch keine Kommentare.";
        status?.classList.remove("hidden");
        return;
      }
      status?.remove();
      for (const c of data.comments) list.append(render(c, now));
      thread = { total: data.total, shown: new Set(data.comments.map((c) => c.id)), count: countAll(data.comments), more: data.more };
      showLoadMore(section);
      // Without a next batch to load (e.g. LigaInsider stops sending one), the rest stays a link.
      if (!data.more && data.total > thread.count) {
        more.textContent = `Alle ${data.total} Kommentare auf ligainsider.de ↗`;
        more.classList.remove("hidden");
        more.classList.add("inline-block");
      } else {
        more.classList.add("hidden");
      }
    } catch {
      skeleton?.remove();
      if (status) {
        status.textContent = "Kommentare gerade nicht erreichbar.";
        status.classList.remove("hidden");
      }
      more.classList.remove("hidden");
      more.classList.add("inline-block");
    } finally {
      clearTimeout(slow);
      slowNote?.classList.add("hidden");
    }
  }

  function setup(section: HTMLElement) {
    const loadBtn = section.querySelector<HTMLButtonElement>("[data-comments-load]");
    if (loadBtn) {
      loadBtn.addEventListener("click", () => void loadMore(section, loadBtn));
      // Scrolling toward the end loads the next batch on its own, before the button is reached. Observing
      // again after each batch fires once more if the button is still near (short batches).
      const near = new IntersectionObserver(async (entries) => {
        if (!entries.some((e) => e.isIntersecting) || loadBtn.classList.contains("hidden")) return;
        await loadMore(section, loadBtn);
        near.unobserve(loadBtn);
        if (thread?.more) near.observe(loadBtn);
      }, { rootMargin: "0px 0px 800px 0px" });
      near.observe(loadBtn);
      document.addEventListener("astro:before-swap", () => near.disconnect(), { once: true });
    }
    const here = `${location.pathname}${location.search}`;
    section.querySelectorAll<HTMLInputElement>("[data-li-next]").forEach((input) => { input.value = here; });
    const login = section.querySelector<HTMLAnchorElement>("[data-li-login]");
    if (login) login.href = loginHref();
    const box = section.querySelector<HTMLElement>("[data-li-box]")!;
    const guest = section.querySelector<HTMLElement>("[data-li-guest]")!;
    if (loggedIn()) box.classList.remove("hidden");
    else guest.classList.remove("hidden");

    const form = section.querySelector<HTMLFormElement>("[data-composer]")!;
    const composer = wireComposer(form, { answerMax: 80 });
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const list = section.querySelector<HTMLElement>("[data-comment-list]")!;
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (submit.disabled) return;
      const polling = composer.polling();
      const d = composer.read();
      if (polling ? !d.question.trim() : !d.text.trim()) return;
      // Shown at once (greyed out), the form is cleared; a failure puts everything back.
      const draft = pendingComment(polling ? "" : d.text);
      if (polling) draft.poll = { question: d.question, total: 0, voted: true, options: d.answers.filter((l) => l.trim()).map((label) => ({ label, pct: 0 })) };
      const shown = render(draft, new Date(), false, true);
      list.prepend(shown);
      revealIn(shown);
      section.querySelector("[data-comments-status]")?.classList.add("hidden");
      composer.clear();
      submit.disabled = true;
      try {
        const r = await post(polling ? { kind: "poll", question: d.question, options: d.answers } : { kind: "comment", body: d.text });
        sent(section, shown, draft, r.commentId, false);
      } catch (err) {
        shown.remove();
        composer.restore(d);
        toast(err);
      } finally {
        submit.disabled = false;
      }
    });

    list.addEventListener("click", async (e) => {
      const target = e.target instanceof Element ? e.target : null;
      const up = target?.closest<HTMLButtonElement>("[data-up]");
      const replyBtn = target?.closest<HTMLButtonElement>("[data-reply]");
      const option = target?.closest<HTMLButtonElement>("[data-option]");
      if (up) {
        // One request at a time per comment; taps meanwhile are ignored.
        if (up.dataset.busy) return;
        up.dataset.busy = "1";
        const vote = Number(up.dataset.vote);
        const score = Number(up.dataset.score);
        const next = vote === 1 ? 0 : 1;
        setVote(up, next === 1, score + next - vote);
        try { await post({ kind: "vote", commentId: Number(up.dataset.up), currentVote: vote }); }
        catch (err) { setVote(up, vote === 1, score); up.dataset.vote = String(vote); toast(err); }
        finally { delete up.dataset.busy; }
      } else if (option) {
        const box = option.closest<HTMLElement>(".poll")!;
        const before = pollOf(box) as Poll;
        const optionId = Number(option.dataset.option);
        const votingId = Number(box.dataset.poll);
        const after = swapPoll(box, withVote(before, optionId), pollOpts(before));
        try {
          await post({ kind: "pollvote", votingId, optionId });
          rememberVote(votingId, optionId);
        }
        catch (err) { swapPoll(after, before, pollOpts(before)); toast(err); }
      } else if (replyBtn && !replyBtn.nextElementSibling?.matches("[data-reply-row]")) {
        const row = h("form", "mt-2 flex gap-2");
        row.dataset.replyRow = "";
        const input = h("input", FIELD);
        input.maxLength = 2000;
        input.placeholder = "Antwort…";
        const go = h("button", "press shrink-0 rounded-full bg-fg px-3 text-sm font-semibold text-bg", "Senden");
        go.type = "submit";
        row.append(input, go);
        replyBtn.after(row);
        revealIn(row);
        row.addEventListener("submit", async (ev) => {
          ev.preventDefault();
          const text = input.value;
          if (go.disabled || !text.trim()) return;
          // The reply shows at once under its comment; the box closes and comes back on failure.
          const replies = replyBtn.closest<HTMLElement>("li")!.querySelector<HTMLElement>(":scope > [data-replies]")!;
          const draft = pendingComment(text);
          const shown = render(draft, new Date(), true, true);
          replies.hidden = false;
          replies.append(shown);
          revealIn(shown);
          row.remove();
          try {
            const r = await post({ kind: "reply", commentId: Number(replyBtn.dataset.reply), body: text });
            sent(section, shown, draft, r.commentId, true);
          } catch (err) {
            shown.remove();
            replies.hidden = !replies.children.length;
            replyBtn.after(row);
            input.value = text;
            toast(err);
          }
        });
        input.focus();
      }
    });
  }

  function boot() {
    const section = sectionOf();
    if (!section || section.dataset.ready) return;
    section.dataset.ready = "1";
    setup(section);
    void load();
  }

  document.addEventListener("astro:page-load", boot);
</script>
