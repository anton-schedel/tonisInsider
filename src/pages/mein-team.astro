---
import Base from "../layouts/Base.astro";
import MyPlayerRow from "../components/MyPlayerRow.astro";
import MyPitch from "../components/MyPitch.astro";
import PlayerCard from "../components/PlayerCard.astro";
import { env } from "cloudflare:workers";
import { clubTable, KickbaseAuthError, leagues as fetchLeagues, login, myEleven, squad as fetchSquad, teamRoster, type KbPlayer, type KbTeam } from "../lib/kickbase.ts";
import { articlePlayer, mapClubs, matchSquad, pitchLines, type MyPlayer } from "../lib/match.ts";
import { toFixtures } from "../lib/fixtures.ts";
import { chancesFor } from "../lib/odds.ts";
import { matchInsights, type PlayerInsight } from "../lib/scorers.ts";
import { cardAttr, hasFreshNews, matchLine, newsByPlayer, POSITIONS, startLabel, type CardNews } from "../lib/card.ts";
import { confirmedClubs } from "../lib/lineupNews.ts";
import { anyRunning } from "../lib/livePoints.ts";
import { clearSession, LEAGUE_COOKIE, relogin, TOKEN_COOKIE } from "../lib/session.ts";
import { loadSnapshot } from "../lib/snapshotServer.ts";

export const prerender = false;

type PlayerOutlook = PlayerInsight & { cleanSheet?: number; win?: number };

// Personal page: never cache it anywhere (shared phones, back button, link prefetch).
Astro.response.headers.set("Cache-Control", "private, no-store");

const key = env.CREDENTIALS_KEY;
const doLogin = (email: string, password: string) => login(fetch, email, password);
const DAY = 86_400_000;

// Public Bundesliga data, identical for every user: cached per Worker isolate for a day (only if non-empty).
const g = globalThis as unknown as {
  __kbTable?: { at: number; teams: KbTeam[] };
  __kbRosters?: Map<string, { at: number; names: string[] }>;
};
const rosters = (g.__kbRosters ??= new Map());

async function load(token: string) {
  // Needed whatever the league: asked for while Kickbase looks up the leagues.
  const table = !g.__kbTable || Date.now() - g.__kbTable.at > DAY
    ? clubTable(fetch, token).then((teams) => void (teams.length > 0 && (g.__kbTable = { at: Date.now(), teams })))
    : undefined;
  table?.catch(() => {}); // still thrown below; this only covers the early returns
  const snapshotLoad = loadSnapshot(Astro.url);
  const leagues = await fetchLeagues(fetch, token);
  const picked = Astro.url.searchParams.get("league");
  const wanted = picked ?? Astro.cookies.get(LEAGUE_COOKIE)?.value;
  const league = leagues.find((l) => l.id === wanted) ?? leagues[0];
  if (!league) return { leagues, league, players: [] as MyPlayer[], starterCount: 0, points: undefined as number | undefined, outlook: new Map<string, PlayerOutlook>(), cardNews: new Map<string, CardNews[]>() };
  // Only an explicit choice is remembered (not prefetches or defaults).
  if (picked && league.id === picked) {
    Astro.cookies.set(LEAGUE_COOKIE, league.id, { path: "/", secure: true, sameSite: "lax", maxAge: 60 * 60 * 24 * 400 });
  }
  // The manager's own XI and bench; if Kickbase can't deliver it, fall back to the plain squad list.
  const eleven = (token: string, id: string): Promise<{ starters: KbPlayer[]; bench: KbPlayer[]; points?: number }> =>
    myEleven(fetch, token, id).catch((err) => {
      if (err instanceof KickbaseAuthError) throw err;
      return fetchSquad(fetch, token, id).then((all) => ({ starters: [], bench: all }));
    });
  const [{ starters, bench, points }, snapshot] = await Promise.all([eleven(token, league.id), snapshotLoad, table]);
  const squad = [...starters, ...bench];
  const teamIds = [...new Set(squad.map((p) => p.teamId))];
  await Promise.all(
    teamIds
      .filter((id) => !rosters.get(id) || Date.now() - rosters.get(id)!.at > DAY)
      .map((id) =>
        teamRoster(fetch, token, id)
          .then((names) => void (names.length > 0 && rosters.set(id, { at: Date.now(), names })))
          .catch(() => undefined),
      ),
  );
  const rosterMap = new Map(teamIds.flatMap((id) => (rosters.get(id) ? [[id, rosters.get(id)!.names] as const] : [])));
  // Starters of a confirmed XI (LigaInsider's "Aufstellung von …" before kickoff) are certain.
  const confirmed = confirmedClubs(snapshot?.articles ?? [], snapshot?.lineups ?? []);
  const players = matchSquad(squad, mapClubs(g.__kbTable?.teams ?? [], snapshot?.lineups ?? []), rosterMap).map((p) =>
    p.lineup && confirmed.has(p.lineup.club.id) && (p.status === "start" || p.status === "contested" || p.status === "doubtful")
      ? { ...p, status: "confirmed" as const, statusLabel: undefined, rival: undefined }
      : p,
  );
  // Odds-based outlook per Kickbase player id; the clean sheet is the player's team's.
  const fixtures = toFixtures(snapshot?.lineups ?? []);
  const insights = new Map<object, ReturnType<typeof matchInsights>>();
  const outlook = new Map<string, PlayerOutlook>();
  for (const p of players) {
    const fixture = p.lineup && fixtures.find((f) => f.home === p.lineup || f.away === p.lineup);
    if (!fixture) continue;
    if (!insights.has(fixture)) insights.set(fixture, matchInsights(fixture, snapshot?.state.odds, snapshot?.state.scorers));
    const mi = insights.get(fixture);
    if (!mi) continue;
    const chances = chancesFor(fixture, snapshot?.state.odds);
    outlook.set(p.kickbase.id, {
      ...(p.ligainsider ? mi.player(p.ligainsider) : {}),
      cleanSheet: fixture.home === p.lineup ? mi.cleanSheet.home : mi.cleanSheet.away,
      win: chances && (fixture.home === p.lineup ? chances.home : chances.away),
    });
  }
  const byNewest = [...(snapshot?.articles ?? [])].sort((a, b) => b.publishedAt.localeCompare(a.publishedAt));
  const playerNews = newsByPlayer(byNewest);
  const cardNews = new Map(players.flatMap((p) => {
    // Players outside the predicted lineup have no LigaInsider id from it; their club's news names them.
    const list = playerNews(articlePlayer(p, byNewest)?.id);
    return list ? [[p.kickbase.id, list] as const] : [];
  }));
  return { leagues, league, players, starterCount: starters.length, points, outlook, cardNews };
}

let error: string | undefined;
// Not signed in (or the session ran out): the page says so itself instead of redirecting, so the tab bar
// doesn't glide to Mein Team and then on to the settings.
let signedOut: "none" | "expired" | undefined;
let data: Awaited<ReturnType<typeof load>> = { leagues: [], league: undefined, players: [], starterCount: 0, points: undefined, outlook: new Map(), cardNews: new Map() };
try {
  // Expired cookie → quietly log in again with the encrypted credentials (if the user has them).
  let token = Astro.cookies.get(TOKEN_COOKIE)?.value ?? (await relogin(Astro.cookies, key, doLogin));
  if (!token) signedOut = "none";
  else {
    try {
      data = await load(token);
    } catch (err) {
      if (!(err instanceof KickbaseAuthError)) throw err;
      token = await relogin(Astro.cookies, key, doLogin);
      if (token) data = await load(token);
      else {
        clearSession(Astro.cookies);
        signedOut = "expired";
      }
    }
  }
} catch (err) {
  if (err instanceof KickbaseAuthError) {
    clearSession(Astro.cookies);
    signedOut = "expired";
  } else {
    error = "Kickbase ist gerade nicht erreichbar. Versuch es gleich nochmal.";
  }
}
const { leagues, league, players, starterCount, points, outlook, cardNews } = data;
// The XI's Kickbase points this matchday, once one of its matches has started (updated live, script below).
const started = players.slice(0, starterCount).some((p) => p.kickbase.live?.state);
const running = anyRunning(players.map((p) => p.kickbase.live), Date.now());
// Player card per Kickbase id: status, next match and the odds-based outlook.
const cards = new Map(players.map((p) => {
  const start = startLabel(p.status, p.statusLabel, p.rival);
  return [p.kickbase.id, cardAttr({
    id: p.ligainsider?.id,
    name: p.ligainsider?.name ?? p.kickbase.name,
    photo: p.ligainsider?.photo ?? p.kickbase.image,
    crest: p.club?.crest,
    pos: POSITIONS[p.kickbase.position] || undefined,
    match: matchLine(p.lineup),
    status: start.text,
    tone: start.tone,
    href: p.club ? `/vereine/${p.club.slug}/` : undefined,
    ...outlook.get(p.kickbase.id),
    news: cardNews.get(p.kickbase.id),
  })] as const;
}));
// Players with fresh news get a newspaper icon; the news themselves are in their card.
const fresh = new Set([...cardNews].flatMap(([id, list]) => (hasFreshNews(list) ? [id] : [])));
// matchSquad keeps the order: the first starterCount players are the XI.
const pitch = pitchLines(players.slice(0, starterCount));
const benchPlayers = players.slice(starterCount);

const GROUPS = [
  { pos: 1, label: "Torwart" },
  { pos: 2, label: "Abwehr" },
  { pos: 3, label: "Mittelfeld" },
  { pos: 4, label: "Sturm" },
] as const;
let index = 0;
---
<Base title="Mein Team" tab="mein-team">
  {signedOut && (
    <div class="py-10 text-center">
      <p class="text-[17px] font-semibold">{signedOut === "expired" ? "Deine Kickbase-Sitzung ist abgelaufen." : "Dein Kickbase-Team auf einen Blick."}</p>
      <p class="mx-auto mt-2 max-w-[320px] text-[15px] text-muted">Melde dich mit Kickbase an: Hier siehst du dann deine Spieler, ob sie spielen, und ihre Punkte live.</p>
      <a href="/einstellungen/#kickbase" class="press mt-5 inline-block rounded-full bg-fg px-5 py-2.5 text-[15px] font-semibold text-bg">Mit Kickbase anmelden</a>
    </div>
  )}
  {error && <p class="mb-4 rounded-xl px-4 py-3 text-sm font-medium" style="background:var(--red-bg);color:var(--red-fg)">{error}</p>}

  {leagues.length > 1 && (
    <nav class="mb-4 flex overflow-x-auto rounded-[10px] bg-surface p-[2px] text-[13px] font-semibold">
      {leagues.map((l) => (
        <a href={`/mein-team/?league=${encodeURIComponent(l.id)}`} data-astro-prefetch="false"
          class:list={["press flex-1 rounded-lg px-3 py-1.5 text-center whitespace-nowrap", league?.id === l.id ? "bg-raised text-fg shadow-sm" : "text-muted"]}>{l.name}</a>
      ))}
    </nav>
  )}

  {!error && league && players.length === 0 && <p class="py-10 text-center text-muted">Keine Spieler in dieser Liga.</p>}
  {!error && !signedOut && !league && <p class="py-10 text-center text-muted">Du bist in keiner Kickbase-Liga.</p>}

  {starterCount > 0 ? (
    <>
      <section>
        <div class="mb-3 flex items-baseline justify-between gap-3">
          <h2 class="text-[22px] font-bold tracking-[-0.02em]">Aufstellung</h2>
          <span class="flex items-baseline gap-2 text-[15px] font-semibold text-muted tabular-nums">
            {pitch.formation}
            <span data-kb-total hidden={!started || points === undefined} class="text-fg">· <span data-kb-total-n>{points}</span> Pkt.</span>
          </span>
        </div>
        <MyPitch lines={pitch.lines} cards={cards} fresh={fresh} />
      </section>
      {benchPlayers.length > 0 && (
        <section class="mt-5">
          <h2 class="mb-1 text-[22px] font-bold tracking-[-0.02em]">Bank</h2>
          <div class="divide-y divide-hairline">
            {benchPlayers.map((p) => <MyPlayerRow player={p} index={index++} card={cards.get(p.kickbase.id)} fresh={fresh.has(p.kickbase.id)} />)}
          </div>
        </section>
      )}
    </>
  ) : (
    // No Kickbase lineup set (or not available): the squad by position.
    GROUPS.map((group) => {
      const inGroup = players.filter((p) => p.kickbase.position === group.pos);
      return inGroup.length > 0 && (
        <section class="mb-3">
          <h2 class="pt-3 pb-1 text-[15px] font-semibold">{group.label}</h2>
          <div class="divide-y divide-hairline">
            {inGroup.map((p) => <MyPlayerRow player={p} index={index++} card={cards.get(p.kickbase.id)} fresh={fresh.has(p.kickbase.id)} />)}
          </div>
        </section>
      );
    })
  )}

  {/* While a match runs: the points every 30 s (only while the page is visible). */}
  {league && <div hidden data-kb-live-league={league.id} data-kb-running={running ? "1" : ""}></div>}

  {!signedOut && (
    <form method="post" action="/api/logout/" class="mt-8" data-astro-reload>
      <button type="submit" class="press w-full rounded-xl bg-surface py-3 text-sm font-semibold" style="color:var(--red-fg)">Abmelden</button>
    </form>
  )}
  <PlayerCard />
</Base>

<script>
  import type { KbLive } from "../lib/kickbase.ts";
  import { anyRunning, pointsLabel, setTier } from "../lib/livePoints.ts";
  import { swapText } from "../lib/swapText.ts";

  const POLL_MS = 30_000;
  let timer = 0;

  function draw(data: { points?: number; players: Record<string, KbLive> }) {
    for (const el of document.querySelectorAll<HTMLElement>("[data-kb-points]")) {
      const label = pointsLabel(data.players[el.dataset.kbPoints!]);
      const wasShown = !el.hidden;
      el.hidden = !label;
      if (!label) continue;
      // A shown number that changes dips once; one that just appears is set.
      const text = el.querySelector("[data-kb-text]")!;
      if (wasShown) swapText(text, label.text);
      else text.textContent = label.text;
      el.classList.toggle("is-live", label.live);
      setTier(el, label.tier);
      el.setAttribute("aria-label", `${label.text} Kickbase-Punkte${label.live ? ", live" : ""}`);
    }
    const total = document.querySelector<HTMLElement>("[data-kb-total]");
    if (total && data.points !== undefined) {
      const n = total.querySelector("[data-kb-total-n]")!;
      if (total.hidden) n.textContent = String(data.points);
      else swapText(n, String(data.points));
      total.hidden = false;
    }
  }

  async function tick() {
    clearTimeout(timer);
    const box = document.querySelector<HTMLElement>("[data-kb-live-league]");
    if (!box?.dataset.kbRunning || document.visibilityState !== "visible") return;
    try {
      const res = await fetch(`/api/kickbase/live/?league=${encodeURIComponent(box.dataset.kbLiveLeague!)}`);
      if (res.ok) {
        const data = (await res.json()) as { points?: number; players: Record<string, KbLive> };
        draw(data);
        // All matches over: stop asking.
        if (!anyRunning(Object.values(data.players), Date.now())) box.dataset.kbRunning = "";
      }
    } catch {}
    if (box.isConnected && box.dataset.kbRunning) timer = window.setTimeout(tick, POLL_MS);
  }

  document.addEventListener("astro:page-load", () => {
    clearTimeout(timer);
    if (document.querySelector("[data-kb-live-league]")) timer = window.setTimeout(tick, POLL_MS);
  });
  document.addEventListener("visibilitychange", () => {
    if (document.visibilityState === "visible" && document.querySelector("[data-kb-live-league]")) void tick();
  });
</script>
