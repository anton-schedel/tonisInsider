---
import Base from "../layouts/Base.astro";
import { env } from "cloudflare:workers";
import { coachSignedIn } from "../lib/coachApi.ts";
import { listPosts, listTeamPhotos } from "../lib/coachDb.ts";
import { BOT_MOODS, CLUB } from "../lib/coachPosts.ts";
import { NEWS_TYPE } from "../lib/newsTypes.ts";
import type { CoachPost } from "../lib/coachPosts.ts";
import type { TeamPhoto } from "../lib/teamPhotos.ts";

export const prerender = false;

// The coach's page: never cached (it shows their drafts and plans).
Astro.response.headers.set("Cache-Control", "private, no-store");

const signedIn = await coachSignedIn(Astro.cookies);
let posts: CoachPost[] = [];
let team: TeamPhoto[] = [];
if (signedIn && env.COMMENTS) [posts, team] = await Promise.all([listPosts(env.COMMENTS), listTeamPhotos(env.COMMENTS).catch(() => [])]);  // no table before migration 0006: no row, the page still works
const badges = Object.entries(NEWS_TYPE).flatMap(([id, t]) => (t ? [{ id, label: t.label }] : []));
const field = "field w-full";
---
<Base title="Trainerbank" hideHeading tabbar={false}>
  {/* The club's crest, large and faint behind the page. */}
  <img src={CLUB.crest} alt="" aria-hidden="true" class="coach-watermark" />

  <div class="relative" data-coach>
    <header class="pt-2 pb-6">
      <div class="flex items-center gap-3">
        <img src={CLUB.crest} alt="" class="size-11" />
        <span class="text-[15px] font-semibold text-muted">{CLUB.name}</span>
      </div>
      <h1 class="mt-3 text-[34px] leading-[1.05] font-bold tracking-[-0.035em]">Trainerbank</h1>
      <p class="mt-2 max-w-[34ch] text-[15px] leading-snug text-muted">Aufstellungen, Ergebnisse und Spielernews für die News auf TonInsider.</p>
    </header>

    {/* Sign in */}
    <form data-view="login" hidden={signedIn} class="flex max-w-sm flex-col gap-2.5" novalidate>
      <input name="password" type="password" required autocomplete="current-password" placeholder="Passwort" class={field} />
      <p class="min-h-5 text-[14px] text-[var(--red-fg)]" data-error aria-live="polite"></p>
      <button type="submit" class="press coach-primary">Anmelden</button>
    </form>

    {/* The coach's posts */}
    <section data-view="list" hidden={!signedIn}>
      <button type="button" class="press coach-primary w-full" data-new>Neuer Beitrag</button>
      <h2 class="mt-8 mb-1 text-[20px] font-bold tracking-[-0.02em]">Deine Beiträge</h2>
      <ul class="divide-y divide-hairline" data-posts></ul>
      <p class="py-6 text-[15px] text-muted" data-empty hidden>Noch nichts geschrieben. Die erste Aufstellung ist ein guter Anfang.</p>
      <button type="button" class="press mt-6 text-[14px] text-muted underline underline-offset-2" data-logout>Abmelden</button>
    </section>

    {/* Writing or changing a post */}
    <form data-view="edit" hidden class="flex flex-col" novalidate>
      <div class="mb-5 flex items-center justify-between">
        <button type="button" class="press -ml-1 flex items-center gap-1 text-[16px] font-medium" data-back>
          <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
          Beiträge
        </button>
        <button type="button" class="press text-[15px] font-medium text-[var(--red-fg)]" data-delete hidden>Löschen</button>
      </div>

      <div class="seg mb-6" style="--n:3" data-type-seg role="radiogroup" aria-label="Art">
        <span class="seg-thumb" aria-hidden="true"></span>
        <button type="button" data-type="lineup" role="radio">Aufstellung</button>
        <button type="button" data-type="result" role="radio">Ergebnis</button>
        <button type="button" data-type="player" role="radio">Spielernews</button>
      </div>

      {/* Lineup: rows from the goalkeeper forward, names separated by commas. */}
      <fieldset data-for="lineup" class="coach-sheet">
        <legend class="sr-only">Aufstellung</legend>
        {["Tor", "Abwehr", "Mittelfeld", "Sturm"].map((label, i) => (
          <label class="coach-line">
            <span>{label}</span>
            <input name={`line${i}`} autocomplete="off" autocapitalize="words" placeholder={["Coach", "Gerl, Dallwig, Chatfield", "Torres, Ellenberger", "Loibl"][i]} />
          </label>
        ))}
        <label class="coach-line is-bench">
          <span>Bank</span>
          <input name="bench" autocomplete="off" autocapitalize="words" placeholder="Enciu, Schedel, Leonhard" />
        </label>
      </fieldset>
      <p data-for="lineup" class="mt-2 mb-6 text-[13px] text-muted">Namen mit Komma trennen. Eine leere Reihe fällt weg.</p>

      {/* Result */}
      <div data-for="result" class="mb-6 flex flex-col gap-2.5" hidden>
        <input name="opponent" placeholder="Gegner, z. B. FC Förderbedarf" autocomplete="off" class={field} />
        <div class="flex items-center gap-3">
          <label class="coach-score"><span>Wir</span><input name="ours" type="number" inputmode="numeric" min="0" max="99" value="0" /></label>
          <span class="text-[22px] font-bold text-muted">:</span>
          <label class="coach-score"><span>Gegner</span><input name="theirs" type="number" inputmode="numeric" min="0" max="99" value="0" /></label>
        </div>
        <div class="seg" style="--n:2" data-home-seg>
          <span class="seg-thumb" aria-hidden="true"></span>
          <button type="button" data-home="1">Heimspiel</button>
          <button type="button" data-home="0">Auswärts</button>
        </div>
      </div>

      {/* Player news */}
      <div data-for="player" class="mb-6 flex flex-col gap-2.5" hidden>
        <input name="playerName" placeholder="Spieler, z. B. Kevin Nguyen" autocomplete="off" autocapitalize="words" class={field} />
        <div class="flex flex-wrap gap-2" data-badges>
          {badges.map((b) => <button type="button" class="press coach-chip" data-badge={b.id}>{b.label}</button>)}
          <button type="button" class="press coach-chip" data-badge="sonstiges">Ohne</button>
        </div>
      </div>

      <input name="headline" placeholder="Überschrift" autocomplete="off" class={`${field} text-[17px] font-semibold`} />
      <textarea name="text" rows="4" placeholder="Text (optional)" class={`${field} mt-2.5 resize-y leading-snug`}></textarea>

      {/* The preview: the feed's row and the article as the readers will see them. Its pictures are where they're
          chosen: each opens a sheet for that spot only (coachClient). */}
      <h3 class="mt-7 mb-0.5 text-[15px] font-semibold">Vorschau</h3>
      <p class="mb-2.5 text-[13px] text-muted" data-vs-hint>Tippe auf ein Bild, um es zu ändern.</p>
      <div class="coach-vs" aria-live="off">
        <p class="coach-cap">Im Feed</p>
        {/* ArticleRow: the picture (64 px, a lineup's crest 72), headline, pill, name and time; a lineup's XI and bench. */}
        <div class="flex items-center gap-4" data-vs-row>
          <button type="button" class="coach-spot is-round" data-feed-spot aria-label="Bild im Feed ändern" aria-haspopup="dialog">
            <span class="coach-feed-pic" data-feed-pic></span>
            <img src={CLUB.crest} alt="" class="crest-overlay -right-1.5 -bottom-1 z-[1] size-[26px]" data-feed-badge hidden />
            <span class="coach-edit"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20h4L19 9l-4-4L4 16z" /><path d="M13.5 6.5l4 4" /></svg></span>
          </button>
          <span class="min-w-0 flex-1">
            <span class="feed-title" data-feed-title></span>
            <span class="feed-meta" data-feed-meta></span>
            <span class="mt-2 block text-[15px] leading-snug" data-feed-xi hidden></span>
          </span>
        </div>
        <span class="mt-2 block text-[13px] leading-snug text-muted" data-feed-bench hidden></span>

        <div class="coach-vs-article">
          <p class="coach-cap">Im Artikel</p>
          {/* The article page (artikel/[id]): back button, the feed's picture small, player and club, the pill. */}
          <div class="flex min-h-[44px] items-center gap-3" aria-hidden="true">
            <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-surface">
              <svg viewBox="0 0 24 24" class="size-[22px]" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7" /></svg>
            </span>
            <span class="coach-head-pic" data-head-pic></span>
            <span class="min-w-0 text-xs leading-snug text-muted">
              <b class="block truncate text-sm text-fg" data-head-name></b>
              <span class="block truncate">{CLUB.name}</span>
            </span>
            <span class="ml-auto shrink-0" data-head-pill></span>
          </div>
          <div class="pt-6">
            <p class="mb-2 text-[26px] leading-[1.15] font-bold tracking-[-0.025em] [overflow-wrap:anywhere]" data-art-title></p>
            <p class="mb-6 text-xs text-muted" data-art-meta></p>
            <button type="button" class="coach-spot coach-banner mb-6 w-full" data-banner aria-label="Bild im Artikel ändern" aria-haspopup="dialog" style="aspect-ratio:16/9">
              <span class="absolute inset-0" data-banner-pics></span>
              <span class="coach-edit is-chip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20h4L19 9l-4-4L4 16z" /><path d="M13.5 6.5l4 4" /></svg><span>Ändern</span></span>
            </button>
            <div class="prose-body text-[16px] leading-[1.6] [overflow-wrap:anywhere]" data-art-body></div>
          </div>
        </div>
      </div>

      <h3 class="mt-7 mb-2 text-[15px] font-semibold">Wann</h3>
      <div class="seg" style="--n:2" data-when-seg>
        <span class="seg-thumb" aria-hidden="true"></span>
        <button type="button" data-when="now">Jetzt</button>
        <button type="button" data-when="later">Geplant</button>
      </div>
      <input name="at" type="datetime-local" class={`${field} mt-2.5`} data-at hidden />
      <label class="mt-3 flex items-center justify-between gap-3 text-[15px]">
        <span>Oben anheften</span>
        <span class="coach-select"><select name="pin">
          <option value="0">Nicht</option>
          <option value="1">1 Stunde</option>
          <option value="2">2 Stunden</option>
          <option value="3">3 Stunden</option>
          <option value="6">6 Stunden</option>
          <option value="12">12 Stunden</option>
          <option value="24">1 Tag</option>
        </select></span>
      </label>

      <h3 class="mt-7 mb-2 text-[15px] font-semibold">Kommentare</h3>
      <label class="flex items-center justify-between gap-3 text-[15px]">
        <span>Bot-Kommentare<span class="block text-[13px] text-muted">25 bis 42 Kommentare in den ersten Minuten.</span></span>
        <input type="checkbox" name="bots" class="coach-switch" checked />
      </label>
      <div data-context>
        <p class="mt-3 mb-1.5 text-[13px] text-muted">Stimmung der Kommentare</p>
        <div class="flex flex-wrap gap-2" data-moods>
          {Object.entries(BOT_MOODS).map(([id, label]) => <button type="button" class="press coach-chip" data-mood={id}>{label[0].toUpperCase() + label.slice(1)}</button>)}
        </div>
        <textarea name="context" rows="2" placeholder="Was die Bots wissen sollen, z. B. „Zwei Stammspieler waren krank.“" class={`${field} mt-2.5 resize-y leading-snug`}></textarea>
      </div>

      {/* The post's comments, so the coach can take one down. */}
      <div data-comments-box hidden>
        <h3 class="mt-7 mb-1 text-[15px] font-semibold">Kommentare <span class="font-normal text-muted" data-comments-count></span></h3>
        <ul class="divide-y divide-hairline" data-comments></ul>
      </div>
      {/* Bot comments still to come: shown and, if wanted, brought forward. */}
      <div class="mt-3 flex items-center justify-between gap-3 rounded-[14px] bg-surface px-4 py-3 text-[14px]" data-planned hidden>
        <span data-planned-text></span>
        <button type="button" class="press shrink-0 font-semibold text-[var(--gold)]" data-planned-now>Jetzt veröffentlichen</button>
      </div>

      <div class="coach-savebar">
        <p class="min-h-5 text-[14px]" data-status aria-live="polite"></p>
        <button type="submit" class="press coach-primary w-full" data-save>Speichern</button>
      </div>
    </form>

    {/* The sheets of the preview's two pictures: slid up from the picture, each changes only its own spot. */}
    <dialog class="coach-dlg" data-sheet="feed" aria-labelledby="coach-sheet-feed">
      <div class="coach-dlg-in" tabindex="-1" autofocus>
        <div class="coach-dlg-head" data-sheet-drag>
          <span class="coach-handle" aria-hidden="true"></span>
          <div class="flex items-center justify-between gap-3">
            <h2 id="coach-sheet-feed" class="text-[19px] font-bold tracking-[-0.02em]">Bild im Feed</h2>
            <button type="button" class="press coach-quiet" data-sheet-done>Fertig</button>
          </div>
          <p class="mt-0.5 text-[13px] text-muted">Der Kreis in den News und klein oben im Artikel.</p>
        </div>
        <div class="coach-grid" data-tiles role="group" aria-label="Bild im Feed"></div>
        <div class="mt-4 flex flex-wrap gap-2 empty:hidden">
          <button type="button" class="press coach-quiet" data-crop-toggle aria-expanded="false" aria-controls="coach-crop-box" hidden>Zuschneiden</button>
          <button type="button" class="press coach-quiet" data-merken hidden></button>
          <button type="button" class="press coach-quiet" data-avatar-make hidden>Teamfoto-Bild erstellen</button>
        </div>
        {/* Placing the circle on the photo: drag, zoom with the slider or two fingers. */}
        <div id="coach-crop-box" data-crop-box hidden>
          <div class="pt-4">
            <div class="coach-crop" data-crop>
              <img alt="" draggable="false" data-crop-img />
              <span class="coach-crop-ring" aria-hidden="true"></span>
            </div>
            <label class="mt-3 flex items-center gap-3 text-muted">
              <span class="sr-only">Zoom</span>
              <svg viewBox="0 0 24 24" class="size-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="5" width="14" height="14" rx="3" /></svg>
              <input type="range" min="1" max="4" step="0.01" value="1" class="coach-zoom" data-zoom />
              <svg viewBox="0 0 24 24" class="size-6 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4" /></svg>
            </label>
            <p class="mt-1.5 text-[13px] text-muted">Ziehen zum Verschieben, zoomen mit dem Regler oder zwei Fingern.</p>
          </div>
        </div>
        <p class="mt-3 text-[13px] text-muted empty:hidden" data-sheet-status aria-live="polite"></p>
      </div>
    </dialog>
    <dialog class="coach-dlg" data-sheet="article" aria-labelledby="coach-sheet-article">
      <div class="coach-dlg-in" tabindex="-1" autofocus>
        <div class="coach-dlg-head" data-sheet-drag>
          <span class="coach-handle" aria-hidden="true"></span>
          <div class="flex items-center justify-between gap-3">
            <h2 id="coach-sheet-article" class="text-[19px] font-bold tracking-[-0.02em]">Bild im Artikel</h2>
            <button type="button" class="press coach-quiet" data-sheet-done>Fertig</button>
          </div>
          <p class="mt-0.5 text-[13px] text-muted">Das große Foto im Artikel. Der Feed bleibt, wie er ist.</p>
        </div>
        <div class="coach-grid is-wide" data-tiles role="group" aria-label="Bild im Artikel"></div>
        <div class="mt-4 flex flex-wrap gap-2 empty:hidden">
          <button type="button" class="press coach-quiet" data-merken hidden></button>
        </div>
        <p class="mt-3 text-[13px] text-muted empty:hidden" data-sheet-status aria-live="polite"></p>
      </div>
    </dialog>
  </div>

  <script type="application/json" data-coach-posts set:html={JSON.stringify(posts).replace(/</g, "\\u003c")} />
  <script type="application/json" data-coach-team set:html={JSON.stringify(team).replace(/</g, "\\u003c")} />
</Base>

<style>
  .coach-watermark {
    position: fixed; z-index: 0; pointer-events: none; user-select: none;
    width: min(150vw, 640px); right: max(-38vw, -230px); top: 40px;
    opacity: 0.06;
  }
  :global(:root[data-theme="dark"]) .coach-watermark { opacity: 0.09; }
  /* Text fields (.field) with the club's gold ring and the page's rounder corners. */
  [data-coach] { --field-ring: var(--gold); --field-radius: 14px; }
  .coach-line input:focus, .coach-score input:focus { box-shadow: 0 0 0 2px var(--gold); }
  :global(.coach-primary) {
    border-radius: 14px; background: var(--gold); color: #fff; padding: 13px 18px; font-size: 16px; font-weight: 600;
  }
  :global(:root[data-theme="dark"] .coach-primary) { color: #15130d; }
  :global(.coach-primary:disabled) { opacity: 0.55; }

  /* The lineup as a team sheet: one row per line of the team, the bench set apart. */
  .coach-sheet { border-radius: 16px; background: var(--color-surface); overflow: hidden; }
  .coach-line { display: flex; align-items: center; gap: 12px; padding: 0 16px; min-height: 50px; }
  .coach-line + .coach-line { border-top: 1px solid var(--color-hairline); }
  .coach-line.is-bench { border-top-width: 6px; border-top-color: var(--color-bg); }
  .coach-line span { width: 84px; flex-shrink: 0; font-size: 14px; font-weight: 600; color: var(--color-muted); }
  .coach-line input { min-width: 0; flex: 1; background: transparent; padding: 13px 0; font-size: 16px; outline: none; border-radius: 6px; }

  .coach-score { display: flex; flex: 1; flex-direction: column; align-items: center; gap: 4px; border-radius: 14px; background: var(--color-surface); padding: 10px; }
  .coach-score span { font-size: 13px; color: var(--color-muted); }
  .coach-score input { width: 100%; background: transparent; text-align: center; font-size: 34px; font-weight: 700; letter-spacing: -0.03em; outline: none; border-radius: 8px; }

  :global(.coach-chip) { border-radius: 999px; background: var(--color-surface); padding: 7px 13px; font-size: 14px; font-weight: 600; }
  :global(.coach-chip.is-on) { background: var(--color-fg); color: var(--color-bg); }
  /* Vorschau: the feed's row and the article page on the page's own background, a hairline between them. */
  .coach-vs { border: 1px solid var(--color-hairline); border-radius: 18px; padding: 12px 14px 2px; background: var(--color-bg); }
  .coach-vs-article { margin: 14px -14px 0; padding: 12px 14px 0; border-top: 1px solid var(--color-hairline); }
  .coach-cap { margin-bottom: 8px; font-size: 12px; color: var(--color-muted); }
  /* The pictures in the preview are buttons: a small pencil says so, a press answers the finger. */
  .coach-spot { position: relative; display: block; flex-shrink: 0; border-radius: 999px; -webkit-tap-highlight-color: transparent; transition: scale 200ms var(--ease-soft); }
  .coach-spot:not(:disabled):active { scale: 0.96; transition-duration: 70ms; }
  .coach-spot.coach-banner:not(:disabled):active { scale: 0.985; }
  .coach-spot:disabled { cursor: default; }
  .coach-spot:focus-visible { outline: 2px solid var(--color-fg); outline-offset: 3px; }
  .coach-edit {
    position: absolute; z-index: 2; top: -3px; right: -5px; display: grid; place-items: center; width: 22px; height: 22px; border-radius: 999px;
    background: var(--color-raised); color: var(--color-fg); box-shadow: 0 0 0 2px var(--color-bg), 0 1px 4px rgb(0 0 0 / 0.16);
  }
  :global(:root[data-theme="dark"]) .coach-edit { background: var(--color-hairline); }
  .coach-edit :global(svg) { width: 12px; height: 12px; }
  .coach-edit.is-chip {
    top: auto; right: 10px; bottom: 10px; display: flex; align-items: center; gap: 5px; width: auto; height: auto; padding: 5px 11px 5px 9px;
    font-size: 13px; font-weight: 600; color: #fff; background: rgb(0 0 0 / 0.42); box-shadow: none;
    -webkit-backdrop-filter: blur(12px) saturate(1.4); backdrop-filter: blur(12px) saturate(1.4);
  }
  .coach-edit.is-chip :global(svg) { width: 13px; height: 13px; }
  .coach-spot:disabled .coach-edit { display: none; }
  /* The feed's picture (64 px, a lineup's crest 72) and the article header's (40): the crest as it is, or a
     circle (layers that fade into each other). */
  .coach-feed-pic { position: relative; display: block; width: 64px; height: 64px; }
  .coach-head-pic { position: relative; display: block; width: 40px; height: 40px; flex-shrink: 0; }
  :global(.coach-layer) { position: absolute; inset: 0; display: block; }
  :global(.coach-layer.is-round) { overflow: hidden; border-radius: 999px; background: var(--color-surface); }
  :global(.coach-layer > img) { width: 100%; height: 100%; object-fit: cover; }
  :global(.coach-layer.is-crest > img) { object-fit: contain; }
  /* The article's banner: rounded like on the article page, at the photo's own shape. */
  .coach-banner { overflow: hidden; border-radius: 16px; background: var(--color-surface); }
  /* Quiet buttons: a grey pill (a shade lighter than the sheet in dark). */
  :global(.coach-quiet) { border-radius: 999px; background: var(--color-surface); padding: 7px 14px; font-size: 14px; font-weight: 600; }
  :global(.coach-quiet:disabled) { opacity: 0.55; }
  .coach-dlg :global(.coach-quiet) { background: var(--sheet-fill); }
  /* Zuschneiden while the framing is open: pressed, like a chip that is on. */
  .coach-dlg [data-crop-toggle][aria-expanded="true"] { background: var(--color-fg); color: var(--color-bg); }
  .coach-dlg :global(.coach-quiet:focus-visible) { outline: 2px solid var(--color-fg); outline-offset: 2px; }

  /* A picture's sheet, from the bottom like iOS: the preview stays visible (dimmed a little) above it. */
  .coach-dlg {
    --sheet: var(--color-bg); --sheet-fill: var(--color-surface);
    position: fixed; inset: auto 0 0; margin: 0 auto; width: 100%; max-width: 520px; max-height: 78dvh;
    padding: 0; border: 0; border-radius: 22px 22px 0 0; background: var(--sheet); color: var(--color-fg);
    box-shadow: 0 -8px 40px rgb(0 0 0 / 0.18); overscroll-behavior: contain;
  }
  :global(:root[data-theme="dark"]) .coach-dlg { --sheet: var(--color-surface); --sheet-fill: var(--color-raised); }
  .coach-dlg[open] { display: flex; flex-direction: column; }
  /* The page behind stays put (iOS would scroll it when swiping in the sheet). */
  :global(html:has(.coach-dlg[open])) { overflow: hidden; }
  .coach-dlg::backdrop { background: rgb(0 0 0 / 0.28); transition: background 240ms ease, overlay 280ms allow-discrete, display 280ms allow-discrete; }
