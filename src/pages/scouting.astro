---
import Base from "../layouts/Base.astro";
import PlayerCard from "../components/PlayerCard.astro";
import { allPlayers } from "../lib/players.ts";

// Every squad player with his card, for the search and the scout list (rendered in the browser below).
const players = allPlayers();
---
<Base title="Scouting" tab="scouting">
  <label class="search-field mt-1">
    <svg viewBox="0 0 24 24" class="size-[18px] shrink-0 text-muted" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="M16 16l4.5 4.5" /></svg>
    <input type="search" data-search placeholder="Spieler oder Verein suchen" autocomplete="off" autocapitalize="off" spellcheck="false" enterkeyhint="search" aria-label="Spieler suchen" />
    <button type="button" class="search-clear press" data-search-clear aria-label="Suche leeren" hidden>
      <svg viewBox="0 0 24 24" class="size-[11px]" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </button>
  </label>

  <section data-results hidden class="mt-3">
    <ul class="divide-y divide-hairline" data-results-list></ul>
    <p class="py-6 text-center text-sm text-muted" data-results-empty hidden>Kein Spieler gefunden.</p>
    <p class="py-4 text-center text-xs text-muted" data-results-more hidden></p>
  </section>

  <section data-scoutlist class="mt-7">
    <div class="mb-1 flex items-baseline justify-between">
      <h2 class="text-[22px] font-bold tracking-[-0.02em]">Scoutliste</h2>
      <span class="text-[15px] font-semibold text-muted tabular-nums" data-scout-count></span>
    </div>
    <ul class="divide-y divide-hairline" data-scout-list></ul>
    <p class="py-4 text-sm text-muted" data-scout-empty hidden>
      Noch niemand auf deiner Liste. Such einen Spieler und tipp in seiner Karte auf „Scouten“: Hier siehst du dann seine News, und der Tab zeigt dir, wenn es Neues gibt.
    </p>
    <p class="mt-3 text-xs text-muted" data-scout-where></p>
  </section>

  <script type="application/json" data-players set:html={JSON.stringify(players)} />
  <PlayerCard />
</Base>

<script>
  import type { PlayerEntry } from "../lib/players.ts";
  import { cachedScout, loadScout, markSeen, unseen, type ScoutState } from "../lib/scoutClient.ts";
  import { ago, fold, initials, kickoffDay } from "../lib/format.ts";
  import { NEWS_TYPE } from "../lib/newsTypes.ts";

  const LIMIT = 40;
  type Indexed = PlayerEntry & { key: string };

  function h(tag: string, cls = "", text?: string) {
    const el = document.createElement(tag);
    if (cls) el.className = cls;
    if (text !== undefined) el.textContent = text;
    return el;
  }

  function avatar(p: PlayerEntry) {
    const box = h("span", "relative inline-flex size-11 shrink-0 items-center justify-center overflow-hidden rounded-full bg-surface text-[15px] font-semibold text-muted");
    box.append(h("span", "", initials(p.name)));
    if (p.photo) {
      const img = document.createElement("img");
      img.src = p.photo;
      img.alt = "";
      img.loading = "lazy";
      img.className = "img-fade absolute inset-0 size-full object-cover";
      img.onload = () => img.classList.add("is-loaded");
      img.onerror = () => img.remove();
      box.append(img);
    }
    if (p.crest) {
      const wrap = h("span", "relative shrink-0");
      const crest = document.createElement("img");
      crest.src = p.crest;
      crest.alt = "";
      crest.className = "absolute -right-1.5 -bottom-1 size-[18px] object-contain drop-shadow-[0_1px_1px_rgba(0,0,0,0.35)]";
      wrap.append(box, crest);
      return wrap;
    }
    return box;
  }

  const when = (iso: string, now: Date) => (now.getTime() - Date.parse(iso) < 86_400_000 ? ago(iso, now) : kickoffDay(iso));

  /** One player: photo with crest, name, then his status, or (scout list) his latest news. */
  function row(p: PlayerEntry, opts: { news?: boolean; fresh?: boolean } = {}) {
    const li = h("li");
    const btn = h("button", "press-row flex w-full items-center gap-3 py-3 text-left") as HTMLButtonElement;
    btn.type = "button";
    btn.dataset.card = JSON.stringify(p.card);
    const text = h("span", "min-w-0 flex-1");
    const top = h("span", "flex items-center gap-1.5");
    top.append(h("span", "truncate text-[15px] font-semibold tracking-[-0.01em]", p.name));
    if (opts.fresh) top.append(h("span", "scout-new", "Neu"));
    text.append(top);
    const latest = p.card.news?.[0];
    if (opts.news && latest) {
      const line = h("span", "mt-0.5 flex items-center gap-1.5 text-xs text-muted");
      const type = NEWS_TYPE[latest.type];
      if (type) {
        const pill = h("span", "shrink-0 rounded-full px-[6px] py-[1px] text-[10px] font-semibold", type.label);
        pill.style.cssText = `background:var(--${type.tone}-bg);color:var(--${type.tone}-fg)`;
        line.append(pill);
      }
      line.append(h("span", "min-w-0 truncate", latest.title), h("span", "ml-auto shrink-0 pl-1 tabular-nums", when(latest.at, new Date())));
      text.append(line);
    } else {
      text.append(h("span", "block truncate text-xs text-muted", [p.club, p.card.status].filter(Boolean).join(" · ")));
    }
    btn.append(avatar(p), text);
    li.append(btn);
    return li;
  }

  /** Nicknames the clubs go by, so "bvb" or "gladbach" finds them. */
  const NICKNAMES: Record<string, string> = {
    "Borussia Dortmund": "bvb", "Hamburger SV": "hsv", "FC Bayern München": "fcb", "Borussia Mönchengladbach": "gladbach bmg fohlen",
    "Eintracht Frankfurt": "sge", "SV Werder Bremen": "svw werder", "FC Schalke 04": "s04", "Bayer 04 Leverkusen": "b04 bayer",
    "1. FC Union Berlin": "fcu eisern", "1. FC Köln": "effzeh koeln", "TSG Hoffenheim": "tsg", "RB Leipzig": "rbl", "SC Freiburg": "scf",
  };
  /** Lower case, no accents, hyphens and dots as spaces: "Simpson-Pusey" and "1. FC Köln" match as written. */
  const normal = (s: string) => fold(s).replace(/[-.']/g, " ");
  /** "mueller", "koeln": the German spellings without umlauts find the names with them. */
  const plain = (w: string) => w.replace(/ae/g, "a").replace(/oe/g, "o").replace(/ue/g, "u");

  function search(index: Indexed[], query: string): { hits: Indexed[]; more: number } {
    const words = normal(query).split(/\s+/).filter(Boolean);
    if (!words.length) return { hits: [], more: 0 };
    // Every word must start a word of the name or club (longer ones may sit inside one: "gladbach").
    const has = (key: string, w: string) => key.includes(` ${w}`) || (w.length >= 4 && key.includes(w));
    const hits = index.filter((p) => words.every((w) => has(p.key, w) || has(p.key, plain(w))));
    // A surname match first, then starters, then the name.
    const surname = (p: Indexed) => (normal(p.name).split(" ").pop() ?? "").startsWith(words[0]) ? 0 : 1;
    hits.sort((a, b) => surname(a) - surname(b) || a.rank - b.rank || a.name.localeCompare(b.name, "de"));
    return { hits: hits.slice(0, LIMIT), more: Math.max(0, hits.length - LIMIT) };
  }

  function renderList(byId: Map<number, Indexed>, state: ScoutState, fresh: Set<number>) {
    const list = document.querySelector<HTMLElement>("[data-scout-list]");
    if (!list) return;
    const players = state.ids.flatMap((id) => byId.get(id) ?? []);
    // Players with news since the last look first, then the newest news.
    const latest = (p: PlayerEntry) => Date.parse(p.card.news?.[0]?.at ?? "") || 0;
    players.sort((a, b) => Number(fresh.has(b.id)) - Number(fresh.has(a.id)) || latest(b) - latest(a));
    list.replaceChildren(...players.map((p) => row(p, { news: true, fresh: fresh.has(p.id) })));
    document.querySelector<HTMLElement>("[data-scout-empty]")!.hidden = players.length > 0;
    document.querySelector<HTMLElement>("[data-scout-count]")!.textContent = players.length ? String(players.length) : "";
    document.querySelector<HTMLElement>("[data-scout-where]")!.textContent = state.account
      ? "Gespeichert mit deinem Konto: auf jedem Gerät, auf dem du angemeldet bist."
      : players.length ? "Nur in diesem Browser gespeichert. Mit Kickbase oder LigaInsider angemeldet hast du sie auf jedem Gerät." : "";
  }

  document.addEventListener("astro:page-load", async () => {
    const data = document.querySelector<HTMLScriptElement>("[data-players]");
    if (!data) return;
    const index: Indexed[] = (JSON.parse(data.textContent ?? "[]") as PlayerEntry[])
      .map((p) => ({ ...p, key: ` ${normal(`${p.name} ${p.club} ${NICKNAMES[p.club] ?? ""}`)}` }));
    const byId = new Map(index.map((p) => [p.id, p]));

    const input = document.querySelector<HTMLInputElement>("[data-search]")!;
    const results = document.querySelector<HTMLElement>("[data-results]")!;
    const scoutList = document.querySelector<HTMLElement>("[data-scoutlist]")!;
    const clear = document.querySelector<HTMLButtonElement>("[data-search-clear]")!;
    const show = () => {
      const q = input.value.trim();
      // Kept for this tab: back from a player's club, the search is still there.
      try { sessionStorage.setItem("scoutQuery", input.value); } catch { /* private mode */ }
      clear.hidden = !input.value;
      results.hidden = !q;
      scoutList.hidden = !!q;
      if (!q) return;
      const { hits, more } = search(index, q);
      document.querySelector<HTMLElement>("[data-results-list]")!.replaceChildren(...hits.map((p) => row(p)));
      document.querySelector<HTMLElement>("[data-results-empty]")!.hidden = hits.length > 0;
      const moreNote = document.querySelector<HTMLElement>("[data-results-more]")!;
      moreNote.hidden = !more;
      moreNote.textContent = `Und ${more} weitere: schreib etwas mehr vom Namen.`;
    };
    try { input.value = sessionStorage.getItem("scoutQuery") ?? ""; } catch { /* private mode */ }
    input.addEventListener("input", show);
    // Enter (the keyboard's search key) only closes the keyboard: the results are already there.
    input.addEventListener("keydown", (e) => { if (e.key === "Enter") input.blur(); });
    clear.addEventListener("click", () => {
      input.value = "";
      show();
      input.focus();
    });
    show();
    // A player picked from the results: back to the list, where he now is.
    document.addEventListener("scout:added", () => {
      if (!input.isConnected || !input.value) return;
      input.value = "";
      input.blur();
      show();
    });

    // The list at once from the last known state, then as the account has it now. News times come from the
    // index on this page (no extra download).
    const times = Object.fromEntries(index.flatMap((p) => (p.card.news?.[0] ? [[p.id, p.card.news[0].at]] : [])));
    const shown = cachedScout();
    const fresh = new Set(await unseen(shown, times));
    void renderList(byId, shown, fresh);
    const state = await loadScout(true);
    for (const id of await unseen(state, times)) fresh.add(id);
    void renderList(byId, state, fresh);
    if (fresh.size) await markSeen();
    // Scouting or unscouting in the card updates the list right away (the "Neu" marks stay for this visit).
    window.addEventListener("scout:change", (e) => void renderList(byId, (e as CustomEvent<ScoutState>).detail, fresh));
  });
</script>
