---
import Base from "../layouts/Base.astro";
import FixtureCard from "../components/FixtureCard.astro";
import { lineups } from "../lib/data.ts";
import { toFixtures } from "../lib/fixtures.ts";

const all = lineups();
const fixtures = toFixtures(all);
const matchday = all.find((l) => l.matchday)?.matchday;
---
<Base title={matchday ? `${matchday}. Spieltag` : "Aufstellungen"} tab="aufstellungen">
  <p class="-mt-1 mb-4 text-sm text-muted">Voraussichtliche Aufstellungen. Tippe auf ein Team.</p>
  {fixtures.length === 0 && <p class="py-10 text-center text-muted">Noch keine Aufstellungen.</p>}
  <div class="grid gap-3 sm:grid-cols-2">
    {fixtures.map((f, i) => <FixtureCard fixture={f} index={i} />)}
  </div>
</Base>
