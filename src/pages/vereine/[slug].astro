---
import Base from "../../layouts/Base.astro";
import Pitch from "../../components/Pitch.astro";
import FixtureCard from "../../components/FixtureCard.astro";
import ArticleRow from "../../components/ArticleRow.astro";
import PlayerCard from "../../components/PlayerCard.astro";
import SectionHead from "../../components/SectionHead.astro";
import Comments from "../../components/Comments.astro";
import { articles, clubArticles, lineups, odds, scorers } from "../../lib/data.ts";
import { confirmedClubs } from "../../lib/lineupNews.ts";
import { matchLine, newsByPlayer } from "../../lib/card.ts";
import { matchInsights } from "../../lib/scorers.ts";
import { chancesFor } from "../../lib/odds.ts";
import { toFixtures } from "../../lib/fixtures.ts";
import type { Lineup } from "../../../scraper/types.ts";

export function getStaticPaths() {
  const fixtures = toFixtures(lineups());
  return lineups().map((lineup) => ({
    params: { slug: lineup.club.slug },
    props: { lineup, fixture: fixtures.find((f) => f.home === lineup || f.away === lineup) },
  }));
}
const { lineup, fixture } = Astro.props as { lineup: Lineup; fixture?: ReturnType<typeof toFixtures>[number] };
// News about players on the pitch (starters and alternatives) are in their cards; the list below keeps the
// club's own news and those about everyone else.
const onPitch = new Set(lineup.lines.flat().flatMap((p) => [p.id, ...(p.alternative ? [p.alternative.id] : [])]));
// Only the last week here (a player's card still lists his older news, e.g. a long injury).
const NEWS_DAYS = 7;
const since = Date.now() - NEWS_DAYS * 86_400_000;
const news = clubArticles(lineup.club.id).filter((a) => (!a.player || !onPitch.has(a.player.id)) && Date.parse(a.publishedAt) >= since);
// Odds-based outlook per player for the player card: goal, scorer (goal or assist), card, and the team's clean sheet.
const insights = fixture ? matchInsights(fixture, odds(), scorers()) : undefined;
const cleanSheet = insights && (fixture?.home === lineup ? insights.cleanSheet.home : insights.cleanSheet.away);
const chances = fixture ? chancesFor(fixture, odds()) : undefined;
const win = chances && (fixture?.home === lineup ? chances.home : chances.away);
const confirmed = confirmedClubs(articles(), [lineup]).has(lineup.club.id);
const playerNews = newsByPlayer(articles());
const NEWS_SHOWN = 5;
// A button for a single hidden row isn't worth it: then all of them.
const shown = news.length <= NEWS_SHOWN + 1 ? news.length : NEWS_SHOWN;
---
<Base title={lineup.club.name} tab="aufstellungen" back={{ href: "/aufstellungen/", label: "Aufstellungen" }}>
  {/* Wide screens (global.css "Wide screens"): the match and the lineup on the left, the club's news and the
      discussion beside them. */}
  <div class="team-cols club-cols">
  <div class="team-pitch">
  {fixture && <FixtureCard fixture={fixture} size="hero" current={lineup.club.slug} matchday={lineup.matchday} chances={chances} />}

  <section class="mt-9">
    <SectionHead title="Aufstellung" class="mb-3">{lineup.formation}</SectionHead>
    <Pitch lineup={lineup} insight={insights?.player} cleanSheet={cleanSheet} win={win} confirmed={confirmed} news={playerNews} />
    {/* From the first substitution on: everyone who came on, with his points, right here (script below) — no face to
        flip to find him. Hidden while nobody has come on. */}
    {lineup.kickoff && (
      <div data-kb-subs hidden data-crest={lineup.club.crest} data-match={matchLine(lineup)}>
        <h3 class="pt-1 pb-1 text-[15px] font-semibold">Eingewechselt</h3>
        <div data-kb-subs-list class="divide-y divide-hairline"></div>
      </div>
    )}
    {/* From kickoff on: the players' Kickbase points (script below). */}
    {lineup.kickoff && <div hidden data-kb-club={lineup.club.slug} data-kickoff={lineup.kickoff}></div>}
    {/* From kickoff on, before the first paint: the points chips wait as placeholders where the points will be,
        and the predictions (alternatives) are hidden, so nothing jumps when the points arrive. */}
    <script is:inline>
      (() => {
        const box = document.querySelector("[data-kb-club]");
        const kickoff = Date.parse(box?.dataset.kickoff ?? "");
        // Already drawn from this tab's last points while the page came in (astro:before-swap, script below).
        if (box.hasAttribute("data-kb-drawn") || !(kickoff <= Date.now() && Date.now() < kickoff + 4 * 86400000)) return;
        for (const el of document.querySelectorAll("[data-kb-points^='li']")) {
          if (!el.hidden) continue;
          el.hidden = false;
          el.classList.add("is-loading");
        }
        for (const el of document.querySelectorAll("[data-slot] [data-prediction], [data-slot] [data-swap-hint]")) el.hidden = true;
      })();
    </script>
  </section>
  </div>

  <div class="team-side">
  <section class="mt-7">
    <SectionHead title="News" class="mb-1">{news.length > 0 && news.length}</SectionHead>
    {news.length === 0 && <p class="py-4 text-sm text-muted">Keine weiteren News aus den letzten 7 Tagen. Die zu den Spielern oben stehen in ihrer Karte.</p>}
    {/* The newest few; the rest on tap, so the discussion below isn't far down (all of them when only one more). */}
    <div class="divide-y divide-hairline">
      {news.slice(0, shown).map((a, i) => <ArticleRow article={a} index={i} withDay />)}
    </div>
    {news.length > shown && (
      <div>
        <div class="divide-y divide-hairline border-t border-hairline" hidden>
          {news.slice(shown).map((a, i) => <ArticleRow article={a} index={i} withDay />)}
        </div>
        <button type="button" class="press btn btn-quiet mt-2 w-full" data-news-all>Alle {news.length} News zeigen</button>
      </div>
    )}
  </section>
  {/* LigaInsider's discussion under this lineup (for the coming match), live like under the articles. */}
  {lineup.comments && <Comments thread={lineup.comments} url={`https://www.ligainsider.de/${lineup.club.slug}/${lineup.club.id}/`} />}
  </div>
  </div>
  <PlayerCard />
</Base>

<script>
  import { applyPoints, pointsLabel, subCard, subNote, type ClubPoints, type ClubSub } from "../../lib/livePoints.ts";
  import { initials } from "../../lib/format.ts";
  import type { SlotPlay } from "../../lib/match.ts";
  import { revealIn } from "../../lib/commentUi.ts";

  const POLL_MS = 30_000;
  /** Points matter from kickoff until the next matchday's lineup replaces this one; polled while it runs. */
  const MAX_AFTER_MS = 4 * 86_400_000;
  let timer = 0;

  /** One player face: no longer flippable, no predictions ("Alt: …", "statt …"). */
  function settle(face: HTMLElement) {
    face.classList.remove("swap-face", "swap-alt");
    face.removeAttribute("inert");
    face.removeAttribute("aria-hidden");
    face.querySelectorAll("[data-swap-hint], [data-prediction]").forEach((el) => el.remove());
    return face;
  }

  function note(text: string) {
    const el = document.createElement("span");
    el.className = "pitch-note";
    el.dataset.subNote = "";
    el.textContent = text;
    return el;
  }

  /**
   * From kickoff on the pitch shows who really played: the alternative goes (or takes the slot, if it was him who
   * started); a substituted starter stays one face, with when he went off and who came on (that one is listed under
   * the pitch with his points).
   */
  function applySlot(slot: HTMLElement, play: SlotPlay) {
    if (!slot.dataset.settled) {
      const swap = slot.querySelector<HTMLElement>("[data-swap]");
      if (swap) {
        const face = swap.querySelector<HTMLElement>(play.show === "alt" ? ".swap-alt" : ".swap-face:not(.swap-alt)")!;
        swap.replaceWith(settle(face));
      }
      slot.dataset.settled = "1";
    }
    if (!play.sub || slot.dataset.sub) return;
    slot.querySelector<HTMLElement>(":scope > button")!.append(note(`bis ${play.sub.minute}' · ${play.sub.name}`));
    slot.dataset.sub = "1";
  }

  /** One who came on, like a bench row on Mein Team: photo (yellow ring), name, "63' für …", his points. */
  function subRow(sub: ClubSub, box: HTMLElement, doc: Document): HTMLElement {
    const row = doc.createElement("button");
    row.type = "button";
    row.className = "press-row flex w-full items-center gap-3 py-2.5 text-left";
    row.dataset.card = JSON.stringify(subCard(sub, { crest: box.dataset.crest, match: box.dataset.match }));
    const pic = doc.createElement("span");
    pic.className = "relative inline-flex size-10 shrink-0 items-center justify-center overflow-hidden rounded-full bg-surface text-[14px] font-semibold text-muted ring-2 ring-[var(--yellow-dot)]";
    pic.textContent = initials(sub.name);
    if (sub.photo) {
      const img = doc.createElement("img");
      img.src = sub.photo;
      img.alt = "";
      img.loading = "lazy";
      img.className = "absolute inset-0 size-full object-cover";
      img.addEventListener("error", () => img.remove());
      pic.append(img);
    }
    const text = doc.createElement("span");
    text.className = "min-w-0 flex-1";
    const name = doc.createElement("span");
    name.className = "block truncate text-[15px] font-semibold tracking-[-0.01em]";
    name.textContent = sub.name;
    const when = doc.createElement("span");
    when.className = "block truncate text-xs text-muted";
    when.textContent = subNote(sub);
    text.append(name, when);
    const chip = doc.createElement("span");
    chip.className = "kb-points is-row";
    chip.dataset.kbPoints = `kb${sub.kb}`;
    chip.dataset.kbPlayer = sub.kb;
    chip.hidden = true;
    chip.innerHTML = '<span class="kb-points-dot" aria-hidden="true"></span><span data-kb-text></span>';
    row.append(pic, text, chip);
    return row;
  }

  /** Everyone who came on, under the pitch: rebuilt only when someone new came on (draw() updates the chips). */
  function drawSubs(subs: ClubSub[], doc: Document) {
    const box = doc.querySelector<HTMLElement>("[data-kb-subs]");
    if (!box) return;
    const key = subs.map((s) => s.kb).join(",");
    if (box.dataset.kbSubsKey === key) return;
    box.dataset.kbSubsKey = key;
    box.hidden = subs.length === 0;
    box.querySelector("[data-kb-subs-list]")!.replaceChildren(...subs.map((s) => subRow(s, box, doc)));
  }

  /** doc: the page shown, or the incoming one during a navigation (not shown yet: no fades). */
  function draw(data: ClubPoints, doc: Document = document) {
    for (const [id, play] of Object.entries(data.slots ?? {})) {
      const slot = doc.querySelector<HTMLElement>(`[data-slot="${id}"]`);
      if (slot) applySlot(slot, play);
    }
    drawSubs(data.subs ?? [], doc);
    const subPoints = new Map((data.subs ?? []).map((s) => [s.kb, s.points] as const));
    for (const el of doc.querySelectorAll<HTMLElement>("[data-kb-points^='li'], [data-kb-points^='kb']")) {
      const key = el.dataset.kbPoints!;
      const liId = Number(key.slice(2));
      const points = key.startsWith("kb") ? subPoints.get(key.slice(2)) : data.players[liId];
      if (key.startsWith("li") && data.ids?.[liId]) el.dataset.kbPlayer = data.ids[liId];
      // A player without points after the match didn't play: "–"; during it "0".
      const label = pointsLabel({ ...data.live, ...(points !== undefined ? { points } : {}) });
      const wasShown = doc === document && !el.hidden && !el.classList.contains("is-loading");
      el.classList.remove("is-loading");
      applyPoints(el, label, wasShown);
    }
  }

  /** The last points per club, for an instant first draw when the page is opened again. */
  const cacheKey = (slug: string) => `kbclub:${slug}`;
  function cached(slug: string): ClubPoints | undefined {
    try { return JSON.parse(sessionStorage.getItem(cacheKey(slug)) ?? "null") ?? undefined; } catch { return undefined; }
  }

  /** The club's points box when its points matter now (from kickoff on). */
  function pointsBox(doc: Document) {
    const box = doc.querySelector<HTMLElement>("[data-kb-club]");
    const kickoff = Date.parse(box?.dataset.kickoff ?? "");
    return box && kickoff <= Date.now() && Date.now() < kickoff + MAX_AFTER_MS ? box : undefined;
  }

  async function tick(first = false) {
    clearTimeout(timer);
    const box = pointsBox(document);
    if (!box || document.visibilityState !== "visible") return;
    const slug = box.dataset.kbClub!;
    // Drawn from the cache already during the swap (below).
    if (first && !box.hasAttribute("data-kb-drawn")) {
      const last = cached(slug);
      if (last) draw(last);
    }
    let running = true;
    try {
      const res = await fetch(`/api/kickbase/club/${slug}/`);
      if (res.ok) {
        const data = (await res.json()) as ClubPoints;
        draw(data);
        running = data.live.state !== 2;
        try { sessionStorage.setItem(cacheKey(slug), JSON.stringify(data)); } catch {}
      }
    } catch {}
    if (box.isConnected && running) timer = window.setTimeout(tick, POLL_MS);
  }

  // Back on a club page: the last points are in before it's shown, so the chips don't wait as placeholders.
  document.addEventListener("astro:before-swap", (e) => {
    const box = pointsBox(e.newDocument);
    const last = box && cached(box.dataset.kbClub!);
    if (!box || !last) return;
    draw(last, e.newDocument);
    box.setAttribute("data-kb-drawn", "");
  });

  document.addEventListener("astro:page-load", () => {
    void tick(true);
    // The older news unfold under the newest instead of popping in.
    document.querySelector<HTMLButtonElement>("[data-news-all]")?.addEventListener("click", (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      const rest = btn.previousElementSibling as HTMLElement;
      rest.hidden = false;
      btn.remove();
      revealIn(rest);
    });
  });
  document.addEventListener("visibilitychange", () => void tick());
</script>
