---
import Base from "../../layouts/Base.astro";
import Pitch from "../../components/Pitch.astro";
import FixtureCard from "../../components/FixtureCard.astro";
import ArticleRow from "../../components/ArticleRow.astro";
import PlayerCard from "../../components/PlayerCard.astro";
import { articles, clubArticles, lineups, odds, scorers } from "../../lib/data.ts";
import { confirmedClubs } from "../../lib/lineupNews.ts";
import { newsByPlayer } from "../../lib/card.ts";
import { matchInsights } from "../../lib/scorers.ts";
import { chancesFor } from "../../lib/odds.ts";
import { toFixtures } from "../../lib/fixtures.ts";
import type { Lineup } from "../../../scraper/types.ts";

export function getStaticPaths() {
  const fixtures = toFixtures(lineups());
  return lineups().map((lineup) => ({
    params: { slug: lineup.club.slug },
    props: { lineup, fixture: fixtures.find((f) => f.home === lineup || f.away === lineup) },
  }));
}
const { lineup, fixture } = Astro.props as { lineup: Lineup; fixture?: ReturnType<typeof toFixtures>[number] };
// News about players on the pitch (starters and alternatives) are in their cards; the list below keeps the
// club's own news and those about everyone else.
const onPitch = new Set(lineup.lines.flat().flatMap((p) => [p.id, ...(p.alternative ? [p.alternative.id] : [])]));
const news = clubArticles(lineup.club.id).filter((a) => !a.player || !onPitch.has(a.player.id));
// Odds-based outlook per player for the player card: goal, scorer (goal or assist), card, and the team's clean sheet.
const insights = fixture ? matchInsights(fixture, odds(), scorers()) : undefined;
const cleanSheet = insights && (fixture?.home === lineup ? insights.cleanSheet.home : insights.cleanSheet.away);
const chances = fixture ? chancesFor(fixture, odds()) : undefined;
const win = chances && (fixture?.home === lineup ? chances.home : chances.away);
const confirmed = confirmedClubs(articles(), [lineup]).has(lineup.club.id);
const playerNews = newsByPlayer(articles());
---
<Base title={lineup.club.name} tab="aufstellungen" back={{ href: "/aufstellungen/", label: "Aufstellungen" }}>
  {fixture && <FixtureCard fixture={fixture} size="hero" current={lineup.club.slug} matchday={lineup.matchday} chances={chances} />}

  <section class="mt-9">
    <div class="mb-3 flex items-baseline justify-between">
      <h2 class="text-[22px] font-bold tracking-[-0.02em]">Aufstellung</h2>
      <span class="text-[15px] font-semibold text-muted tabular-nums">{lineup.formation}</span>
    </div>
    <Pitch lineup={lineup} insight={insights?.player} cleanSheet={cleanSheet} win={win} confirmed={confirmed} news={playerNews} />
    {/* From kickoff on: the players' Kickbase points (script below). */}
    {lineup.kickoff && <div hidden data-kb-club={lineup.club.slug} data-kickoff={lineup.kickoff}></div>}
    {/* From kickoff on, before the first paint: the points chips wait as placeholders where the points will be,
        and the predictions (alternatives) are hidden, so nothing jumps when the points arrive. */}
    <script is:inline>
      (() => {
        const box = document.querySelector("[data-kb-club]");
        const kickoff = Date.parse(box?.dataset.kickoff ?? "");
        if (!(kickoff <= Date.now() && Date.now() < kickoff + 4 * 86400000)) return;
        for (const el of document.querySelectorAll("[data-kb-points^='li']")) {
          if (!el.hidden) continue;
          el.hidden = false;
          el.classList.add("is-loading");
        }
        for (const el of document.querySelectorAll("[data-slot] [data-prediction], [data-slot] [data-swap-hint]")) el.hidden = true;
      })();
    </script>
  </section>

  <section class="mt-7">
    <div class="mb-1 flex items-baseline justify-between">
      <h2 class="text-[22px] font-bold tracking-[-0.02em]">News</h2>
      {news.length > 0 && <span class="text-[15px] font-semibold text-muted tabular-nums">{news.length}</span>}
    </div>
    {news.length === 0 && <p class="py-4 text-sm text-muted">Keine weiteren News. Die zu den Spielern oben stehen in ihrer Karte.</p>}
    <div class="divide-y divide-hairline">
      {news.map((a, i) => <ArticleRow article={a} index={i} />)}
    </div>
  </section>
  <PlayerCard />
</Base>

<script>
  import { pointsLabel, setTier, type ClubPoints } from "../../lib/livePoints.ts";
  import type { SlotPlay } from "../../lib/match.ts";

  const POLL_MS = 30_000;
  /** Points matter from kickoff until the next matchday's lineup replaces this one; polled while it runs. */
  const MAX_AFTER_MS = 4 * 86_400_000;
  let timer = 0;

  /** One player face: no longer flippable, no predictions ("Alt: …", "statt …"). */
  function settle(face: HTMLElement) {
    face.classList.remove("swap-face", "swap-alt");
    face.removeAttribute("inert");
    face.removeAttribute("aria-hidden");
    face.querySelectorAll("[data-swap-hint], [data-prediction]").forEach((el) => el.remove());
    return face;
  }

  function note(text: string) {
    const el = document.createElement("span");
    el.className = "line-clamp-1 text-[9.5px] leading-tight";
    el.style.color = "var(--yellow-fg)";
    el.dataset.subNote = "";
    el.textContent = text;
    return el;
  }

  function hint(label: string) {
    const el = document.createElement("span");
    el.className = "swap-hint";
    el.dataset.swapHint = "";
    el.setAttribute("role", "button");
    el.setAttribute("aria-label", label);
    el.textContent = "⇄";
    return el;
  }

  /**
   * From kickoff on the pitch shows who really played: the alternative goes (or takes the slot, if it was him who
   * started), and a substitution gets the ⇄ mark, which flips to the one who came on (handler in Base.astro).
   */
  function applySlot(slot: HTMLElement, play: SlotPlay) {
    if (!slot.dataset.settled) {
      const swap = slot.querySelector<HTMLElement>("[data-swap]");
      if (swap) {
        const face = swap.querySelector<HTMLElement>(play.show === "alt" ? ".swap-alt" : ".swap-face:not(.swap-alt)")!;
        swap.replaceWith(settle(face));
      }
      slot.dataset.settled = "1";
    }
    if (!play.sub || slot.dataset.sub) return;
    const main = slot.querySelector<HTMLElement>(":scope > button")!;
    const shownName = main.querySelector(".line-clamp-2")?.textContent ?? "";
    // The one who came on: a copy of the face with his photo, name and points.
    const sub = main.cloneNode(true) as HTMLElement;
    const img = sub.querySelector("img");
    if (img && play.sub.photo) {
      img.src = play.sub.photo;
      img.alt = play.sub.name;
      img.classList.replace("ring-white/80", "ring-[var(--yellow-dot)]");
    }
    sub.querySelectorAll(".s11-badge, .news-badge, [data-sub-note]").forEach((el) => el.remove());
    sub.querySelector(".line-clamp-2")!.textContent = play.sub.name;
    const chip = sub.querySelector<HTMLElement>("[data-kb-points]")!;
    chip.dataset.kbPoints = `kb${play.sub.kb}`;
    chip.dataset.kbPlayer = play.sub.kb;
    try {
      const card = JSON.parse(main.dataset.card!) as Record<string, unknown>;
      sub.dataset.card = JSON.stringify({
        name: play.sub.name, photo: play.sub.photo, crest: card.crest, pos: card.pos, match: card.match, href: card.href,
        status: `Eingewechselt (${play.sub.minute}')`, tone: "yellow",
      });
    } catch {}
    sub.querySelector(".relative")!.append(hint(`${shownName} zeigen`));
    sub.append(note(`ab ${play.sub.minute}' für ${shownName}`));
    main.querySelector(".relative")!.append(hint(`${play.sub.name} zeigen`));
    main.append(note(`bis ${play.sub.minute}' · ${play.sub.name}`));
    const wrap = document.createElement("div");
    wrap.className = "swap grid w-full";
    wrap.dataset.swap = "";
    main.classList.add("swap-face");
    sub.classList.add("swap-face", "swap-alt");
    sub.setAttribute("inert", "");
    sub.setAttribute("aria-hidden", "true");
    main.replaceWith(wrap);
    wrap.append(main, sub);
    slot.dataset.sub = "1";
  }

  function draw(data: ClubPoints) {
    for (const [id, play] of Object.entries(data.slots ?? {})) {
      const slot = document.querySelector<HTMLElement>(`[data-slot="${id}"]`);
      if (slot) applySlot(slot, play);
    }
    const subPoints = new Map(Object.values(data.slots ?? {}).flatMap((p) => (p.sub ? [[p.sub.kb, p.sub.points] as const] : [])));
    for (const el of document.querySelectorAll<HTMLElement>("[data-kb-points^='li'], [data-kb-points^='kb']")) {
      const key = el.dataset.kbPoints!;
      const liId = Number(key.slice(2));
      const points = key.startsWith("kb") ? subPoints.get(key.slice(2)) : data.players[liId];
      if (key.startsWith("li") && data.ids?.[liId]) el.dataset.kbPlayer = data.ids[liId];
      // A player without points after the match didn't play: "–"; during it "0".
      const label = pointsLabel({ ...data.live, ...(points !== undefined ? { points } : {}) });
      el.classList.remove("is-loading");
      el.hidden = !label;
      if (!label) continue;
      el.querySelector("[data-kb-text]")!.textContent = label.text;
      el.classList.toggle("is-live", label.live);
      setTier(el, label.tier);
      el.setAttribute("aria-label", `${label.text} Kickbase-Punkte${label.live ? ", live" : ""}`);
    }
  }

  /** The last points per club, for an instant first draw when the page is opened again. */
  const cacheKey = (slug: string) => `kbclub:${slug}`;
  function cached(slug: string): ClubPoints | undefined {
    try { return JSON.parse(sessionStorage.getItem(cacheKey(slug)) ?? "null") ?? undefined; } catch { return undefined; }
  }

  async function tick(first = false) {
    clearTimeout(timer);
    const box = document.querySelector<HTMLElement>("[data-kb-club]");
    if (!box || document.visibilityState !== "visible") return;
    const kickoff = Date.parse(box.dataset.kickoff!);
    if (!(kickoff <= Date.now() && Date.now() < kickoff + MAX_AFTER_MS)) return;
    const slug = box.dataset.kbClub!;
    if (first) {
      const last = cached(slug);
      if (last) draw(last);
    }
    let running = true;
    try {
      const res = await fetch(`/api/kickbase/club/${slug}/`);
      if (res.ok) {
        const data = (await res.json()) as ClubPoints;
        draw(data);
        running = data.live.state !== 2;
        try { sessionStorage.setItem(cacheKey(slug), JSON.stringify(data)); } catch {}
      }
    } catch {}
    if (box.isConnected && running) timer = window.setTimeout(tick, POLL_MS);
  }

  document.addEventListener("astro:page-load", () => void tick(true));
  document.addEventListener("visibilitychange", () => void tick());
</script>
